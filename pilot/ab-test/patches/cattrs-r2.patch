+def test_subclasses_of_slotted_dataclass():
+    """Non-slotted subclasses of slotted dataclasses are found, once."""
+
+    @dataclass(slots=True)
+    class Parent:
+        a: int
+
+    @dataclass
+    class Child(Parent):
+        b: int
+
+    @dataclass(slots=True)
+    class SlottedChild(Parent):
+        c: int
+
+    found = subclasses(Parent)
+    assert Child in found
+    assert len([c for c in found if c.__name__ == "SlottedChild"]) == 1
+
+    c = Converter()
+    include_subclasses(Parent, c)
+    assert c.structure({"a": 1, "b": 2}, Parent) == Child(1, 2)
+
