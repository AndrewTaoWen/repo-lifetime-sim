+def test_match_many_converters_in_part():
+    names = [f"v{i}" for i in range(12)]
+    m = r.Map([r.Rule("/" + "-".join(f"<int:{n}>" for n in names), endpoint="x")])
+    _, values = m.bind("localhost").match("/" + "-".join(map(str, range(12))))
+    assert values == {n: i for i, n in enumerate(names)}
