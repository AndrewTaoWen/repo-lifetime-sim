diff --git a/tests/test_regressions.py b/tests/test_regressions.py
new file mode 100644
index 0000000..401b798
--- /dev/null
+++ b/tests/test_regressions.py
@@ -0,0 +1,311 @@
+"""Regression tests for assorted bugs in parsing, items and containers."""
+
+from __future__ import annotations
+
+import copy
+import pickle
+import time
+
+import pytest
+
+import tomlkit
+
+from tomlkit._utils import escape_string
+from tomlkit.exceptions import ParseError
+from tomlkit.items import Float
+from tomlkit.items import InlineTable
+
+
+def roundtrip(s: str) -> object:
+    return tomlkit.parse(f"a = {s}\n")["a"]
+
+
+# escape_string
+
+
+def test_escape_string_is_linear() -> None:
+    s = ("x" * 99 + '"') * 3000
+    start = time.perf_counter()
+    escaped = escape_string(s)
+    assert time.perf_counter() - start < 1
+    assert escaped == s.replace('"', '\\"')
+
+
+def test_escape_character_is_written_compatibly_with_toml_1_0() -> None:
+    assert tomlkit.dumps({"a": "x\x1by"}) == 'a = "x\\u001by"\n'
+    assert tomlkit.parse(tomlkit.dumps({"a": "x\x1by"}))["a"] == "x\x1by"
+
+
+# String
+
+
+@pytest.mark.parametrize(
+    "initial, other",
+    [
+        ('"C:\\\\dir"', '\\sub"x'),
+        ('"x"', "\x7f\n"),
+        ('"""ab"""""', '"c'),
+        ("'lit'", "a'b"),
+        ("'''ab'''''", "'c"),
+        ("'''ab'''", "\\x"),
+        ("'lit'", tomlkit.string("\\", literal=True)),
+        ('"x"', tomlkit.string('q"', literal=True)),
+    ],
+)
+def test_string_concatenation_produces_valid_toml(initial: str, other: str) -> None:
+    doc = tomlkit.parse(f"p = {initial} # comment\n")
+    expected = str(doc["p"]) + str(other)
+    doc["p"] += other
+    assert doc["p"] == expected
+    parsed = tomlkit.parse(doc.as_string())
+    assert parsed["p"] == expected
+    assert "# comment" in doc.as_string()
+
+
+def test_multiline_basic_string_escapes_lone_carriage_return() -> None:
+    s = tomlkit.string("a\rb\r\nc", multiline=True)
+    assert roundtrip(s.as_string()) == "a\rb\r\nc"
+
+
+def test_multiline_literal_string_rejects_lone_carriage_return() -> None:
+    with pytest.raises(tomlkit.exceptions.InvalidStringError):
+        tomlkit.string("a\rb", multiline=True, literal=True)
+    s = tomlkit.string("a\r\nb", multiline=True, literal=True)
+    assert roundtrip(s.as_string()) == "a\r\nb"
+
+
+# Numbers
+
+
+def test_integer_negative_power_returns_float() -> None:
+    doc = tomlkit.parse("a = 2\n")
+    result = doc["a"] ** -1
+    assert result == 0.5
+    assert isinstance(result, Float)
+    assert result.as_string() == "0.5"
+    assert 2 ** tomlkit.item(-1) == 0.5
+
+
+def test_integer_power_with_float_falls_back_to_float() -> None:
+    assert tomlkit.item(4) ** 0.5 == 2.0
+    assert tomlkit.item(4) ** tomlkit.item(0.5) == 2.0
+    assert 4.0 ** tomlkit.item(2) == 16.0
+
+
+def test_round_float_without_ndigits_returns_int() -> None:
+    value = tomlkit.item(2.6)
+    assert round(value) == 3
+    assert type(round(value)) is int
+    assert round(value, 0) == 3.0
+    assert isinstance(round(value, 0), Float)
+    assert round(tomlkit.item(1234), -2) == 1200
+
+
+def test_arithmetic_result_does_not_share_trivia() -> None:
+    doc = tomlkit.parse("x = 1 # c\nd = 2020-01-01\ns = 'a'\n")
+    doc["y"] = doc["x"] + 1
+    doc["y"].comment("new")
+    doc["s2"] = doc["s"] + "b"
+    doc["s2"].comment("other")
+    assert doc["x"].trivia.comment == "# c"
+    assert doc["s"].trivia.comment == ""
+    assert "x = 1 # c\n" in doc.as_string()
+
+
+# Array
+
+
+def test_array_sort_updates_the_rendered_output() -> None:
+    doc = tomlkit.parse("a = [\n  3, # three\n  1,\n  2,\n]\n")
+    doc["a"].sort()
+    assert doc["a"] == [1, 2, 3]
+    assert tomlkit.parse(doc.as_string())["a"] == [1, 2, 3]
+    doc["a"].sort(reverse=True)
+    assert tomlkit.parse(doc.as_string())["a"] == [3, 2, 1]
+
+
+@pytest.mark.parametrize(
+    "index", [slice(-2, None), slice(None, None, -1), slice(None, None, 2)]
+)
+def test_array_delete_slice(index: slice) -> None:
+    doc = tomlkit.parse("a = [1, 2, 3, 4]\n")
+    expected = [1, 2, 3, 4]
+    del expected[index]
+    del doc["a"][index]
+    assert doc["a"] == expected
+    assert tomlkit.parse(doc.as_string())["a"] == expected
+
+
+def test_array_slice_assignment_leaves_array_unchanged() -> None:
+    doc = tomlkit.parse("a = [1, 2, 3]\n")
+    with pytest.raises(ValueError):
+        doc["a"][0:1] = [9]
+    assert doc["a"] == [1, 2, 3]
+    assert doc.as_string() == "a = [1, 2, 3]\n"
+
+
+def test_array_inplace_multiply() -> None:
+    doc = tomlkit.parse("a = [1, 2]\n")
+    a = doc["a"]
+    a *= 2
+    assert doc.as_string() == "a = [1, 2, 1, 2]\n"
+    a *= 0
+    assert doc.as_string() == "a = []\n"
+
+
+def test_array_append_keeps_index_consistent_and_is_fast() -> None:
+    a = tomlkit.parse("a = [\n  1,\n  # comment\n]\n")["a"]
+    a.extend([2, 3])
+    a.append(4)
+    a.insert(1, 9)
+    a[-1] = 5
+    assert a == [1, 9, 2, 3, 5]
+    assert tomlkit.parse("a = " + a.as_string())["a"] == [1, 9, 2, 3, 5]
+
+    start = time.perf_counter()
+    big = tomlkit.array()
+    big.extend(range(20000))
+    tomlkit.dumps({"a": list(range(20000))})
+    assert time.perf_counter() - start < 5
+    assert tomlkit.parse("a = " + big.as_string())["a"] == list(range(20000))
+
+
+# AoT
+
+
+def test_aot_setitem_keeps_list_in_sync() -> None:
+    doc = tomlkit.parse("[[x]]\na = 1\n[[x]]\na = 2\n")
+    doc["x"][0] = {"a": 9}
+    assert doc["x"] == [{"a": 9}, {"a": 2}]
+    assert tomlkit.parse(doc.as_string())["x"] == [{"a": 9}, {"a": 2}]
+
+
+def test_aot_insert_at_start_separates_tables() -> None:
+    doc = tomlkit.document()
+    doc["x"] = [{"a": 1}]
+    doc["x"].insert(0, {"a": 0})
+    assert doc.as_string() == "[[x]]\na = 0\n\n[[x]]\na = 1\n"
+
+
+# Containers
+
+
+def test_copied_document_can_merge_super_tables() -> None:
+    doc = tomlkit.parse("[a.b]\nx = 1\n[c]\ny = 2\n")
+    copied = doc.copy()
+    copied.append("a", tomlkit.parse("[a.z]\nq = 1\n")["a"])
+    assert copied.unwrap() == {"a": {"b": {"x": 1}, "z": {"q": 1}}, "c": {"y": 2}}
+    assert doc.unwrap() == {"a": {"b": {"x": 1}}, "c": {"y": 2}}
+
+
+def test_out_of_order_table_proxy_new_key_can_be_deleted() -> None:
+    doc = tomlkit.parse("[a]\nx = 1\n[b]\ny = 1\n[a.c]\nz = 1\n")
+    proxy = doc["a"]
+    proxy["new"] = 5
+    assert proxy["new"] == 5
+    proxy["new"] = 6
+    assert proxy["new"] == 6
+    del proxy["new"]
+    assert "new" not in proxy
+    assert doc.as_string() == "[a]\nx = 1\n[b]\ny = 1\n[a.c]\nz = 1\n"
+
+
+def test_inline_table_copy_and_pickle_keep_format() -> None:
+    table = tomlkit.inline_table()
+    table.update({"a": 1, "b": 2})
+    for clone in (
+        copy.copy(table),
+        copy.deepcopy(table),
+        pickle.loads(pickle.dumps(table)),
+    ):
+        assert isinstance(clone, InlineTable)
+        assert clone.as_string() == "{a = 1, b = 2}"
+
+
+# dumps
+
+
+def test_dumps_sort_keys_with_table() -> None:
+    doc = tomlkit.parse("[t]\ny = 1\nb = 2\n")
+    assert tomlkit.dumps(doc["t"], sort_keys=True) == "b = 2\ny = 1\n"
+    assert tomlkit.dumps(doc["t"]) == "y = 1\nb = 2\n"
+
+
+def test_dumps_does_not_modify_its_input() -> None:
+    content = "z = 1\na = 2\n[t]\ny = 1\nb = 2\n[u]\nc = 3\n"
+    doc = tomlkit.parse(content)
+    tomlkit.dumps(doc, sort_keys=True)
+    tomlkit.dumps({"x": 1, "q": doc["t"]})
+    assert doc.as_string() == content
+
+
+# Parser
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        "+Inf",
+        "-NaN",
+        "Inf",
+        "+infinity",
+        "-Infinity",
+        "1\u0663",
+        "\u0661",
+        "0x1\u0663",
+    ],
+)
+def test_invalid_numbers_are_rejected(value: str) -> None:
+    with pytest.raises(ParseError):
+        tomlkit.parse(f"a = {value}\n")
+
+
+@pytest.mark.parametrize(
+    "value, expected",
+    [
+        ("+inf", float("inf")),
+        ("-inf", float("-inf")),
+        ("1_000", 1000),
+        ("1e1_0", 1e10),
+        ("1E+2", 100.0),
+        ("0xDEAD_beef", 0xDEADBEEF),
+        ("0b1_0", 2),
+        ("0o17", 15),
+        ("-0.0", -0.0),
+    ],
+)
+def test_valid_numbers_are_accepted(value: str, expected: float) -> None:
+    assert tomlkit.parse(f"a = {value}\n")["a"] == expected
+
+
+@pytest.mark.parametrize(
+    "escape",
+    ["\\u1_23", "\\u 123", "\\u+123", "\\U0000D800", "\\uDFFF", "\\U+0001234"],
+)
+def test_invalid_unicode_escapes_are_rejected(escape: str) -> None:
+    with pytest.raises(ParseError):
+        tomlkit.parse(f'a = "{escape}"\n')
+
+
+def test_valid_unicode_escapes() -> None:
+    assert tomlkit.parse('a = "\\u00E9\\U0001F600"\n')["a"] == "\u00e9\U0001f600"
+
+
+@pytest.mark.parametrize("content", ["[[a]\n", "[[a]\nx = 1\n", "[[a]", "[[a] ]\n"])
+def test_unclosed_array_of_tables_header_is_rejected(content: str) -> None:
+    with pytest.raises(ParseError):
+        tomlkit.parse(content)
+
+
+@pytest.mark.parametrize(
+    "content, line, col",
+    [
+        ('a = "x\u2028y"\nb = ?', 2, 4),
+        ("a = 1\r\nb = 2\r\nc = ?", 3, 4),
+        ("a = [", 1, 5),
+    ],
+)
+def test_error_position(content: str, line: int, col: int) -> None:
+    with pytest.raises(ParseError) as exc_info:
+        tomlkit.parse(content)
+    assert (exc_info.value.line, exc_info.value.col) == (line, col)
