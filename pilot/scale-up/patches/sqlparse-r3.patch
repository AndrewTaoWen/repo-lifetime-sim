@@ -0,0 +1,163 @@
+"""Regression tests for assorted robustness fixes."""
+import io
+import time
+
+import pytest
+
+import sqlparse
+from sqlparse import sql
+from sqlparse import tokens as T
+from sqlparse.utils import remove_quotes
+
+
+def _first_group(text, cls):
+    for token in sqlparse.parse(text)[0].tokens:
+        if isinstance(token, cls):
+            return token
+    raise AssertionError(f'no {cls.__name__} in {text!r}')
+
+
+def test_function_get_window_without_over():
+    func = _first_group('select foo(1)', sql.Function)
+    assert func.get_window() is None
+
+
+def test_function_get_window_with_over():
+    func = _first_group('select foo(1) over (partition by a)', sql.Function)
+    assert isinstance(func.get_window(), sql.Parenthesis)
+
+
+@pytest.mark.parametrize('stmt', [
+    "select 'a\\b' from t",
+    "select 'it\\'s' from t",
+    "select 'a\nb' from t",
+    "select 1 -- comment\nfrom t where a = 'x''y'",
+])
+def test_output_python_is_valid_python(stmt):
+    for opts in ({}, {'reindent': True}):
+        out = sqlparse.format(stmt, output_format='python', **opts)
+        ns = {}
+        exec(out, ns)
+        if not opts:
+            assert ns['sql'] == stmt
+
+
+def test_output_php_escapes_backslash_and_dollar():
+    out = sqlparse.format("select 'a\\b', \"$x\" from t", output_format='php')
+    assert out == '$sql = "select \'a\\\\b\', \\"\\$x\\" from t";'
+
+
+def test_split_strip_semicolon_before_comment():
+    stmts = sqlparse.split('select 1; -- foo\nselect 2;', strip_semicolon=True)
+    assert stmts == ['select 1 -- foo', 'select 2']
+
+
+def test_split_go_case_insensitive():
+    assert sqlparse.split('select 1\ngo\nselect 2') == ['select 1\ngo',
+                                                       'select 2']
+
+
+def test_format_line_endings_with_apostrophe_in_comment():
+    s = "-- don't  \r\nselect 1  \r\nfrom t -- it's\r\n"
+    assert sqlparse.format(s) == "-- don't\nselect 1\nfrom t -- it's\n"
+
+
+def test_format_keeps_newlines_inside_string_literal():
+    s = "select 'a  \r\nb' \r\nfrom t"
+    assert sqlparse.format(s) == "select 'a  \r\nb'\nfrom t"
+
+
+def test_remove_quotes_empty_string():
+    assert remove_quotes('') == ''
+    assert remove_quotes(None) is None
+
+
+def test_bytes_fallback_does_not_interpret_backslashes():
+    stmts = sqlparse.split(b"select 'a\\nb' -- \xe9")
+    assert stmts == ["select 'a\\nb' -- \xe9"]
+
+
+def test_parsestream_generic_file_like():
+    class Reader:
+        def __init__(self):
+            self._buf = io.StringIO('select 1; select 2')
+
+        def read(self, *args):
+            return self._buf.read(*args)
+
+    stmts = [str(s) for s in sqlparse.parsestream(Reader())]
+    assert stmts == ['select 1; ', 'select 2']
+
+
+def test_reindent_wrap_after_in_function_no_blank_line():
+    s = 'select f(aaaaaa, bbbbbbbbbb, cccccccc, ddddddd) from t'
+    assert sqlparse.format(s, reindent=True, wrap_after=10) == '\n'.join([
+        'select f(aaaaaa,',
+        '         bbbbbbbbbb,',
+        '         cccccccc,',
+        '         ddddddd)',
+        'from t'])
+
+
+@pytest.mark.parametrize('s', ['select f( :: )', 'select f( as )'])
+def test_strip_whitespace_malformed_parenthesis(s):
+    # used to raise IndexError
+    sqlparse.format(s, strip_whitespace=True)
+    sqlparse.format(s, reindent=True)
+
+
+def test_typecast_does_not_swallow_parenthesis():
+    paren = _first_group('select (a)::int', sql.Identifier)
+    assert paren.get_typecast() == 'int'
+    func = _first_group('select f( :: )', sql.Function)
+    assert isinstance(func.tokens[1], sql.Parenthesis)
+    assert func.tokens[1].tokens[0].match(T.Punctuation, '(')
+
+
+def test_aligned_indent_case_without_end():
+    # used to raise ValueError
+    sqlparse.format('case begin join between end', reindent_aligned=True)
+
+
+def test_case_get_cases_no_bogus_entry():
+    case = _first_group('select case when a then 1 else 2 end', sql.Case)
+    cases = case.get_cases()
+    assert len(cases) == 2
+    assert cases[0][0][0].normalized == 'WHEN'
+    assert cases[1][0] is None
+    case = _first_group('select case x when 1 then 2 end', sql.Case)
+    cases = case.get_cases()
+    assert len(cases) == 2
+    assert ''.join(str(t) for t in cases[0][0]).strip() == 'x'
+    assert cases[0][1] == []
+
+
+def test_comment_is_multiline_returns_bool():
+    assert sql.Comment([]).is_multiline() is False
+
+
+def test_group_tokens_extend_keeps_value():
+    s = 'select ' + ', '.join(f'c{i}' for i in range(50)) + ' from t'
+    stmt = sqlparse.parse(s)[0]
+    idlist = stmt.tokens[2]
+    assert isinstance(idlist, sql.IdentifierList)
+    assert idlist.value == str(idlist)
+
+
+def test_long_identifier_list_is_not_quadratic():
+    s = 'select ' + ', '.join(f'c{i}' for i in range(3000)) + ' from t'
+    start = time.perf_counter()
+    sqlparse.parse(s)
+    assert time.perf_counter() - start < 5
+
+
+def test_reindent_many_values_rows():
+    rows = ', '.join(f'({i}, {i})' for i in range(1200))
+    s = 'insert into t values ' + rows
+    start = time.perf_counter()
+    out = sqlparse.format(s, reindent=True)
+    assert time.perf_counter() - start < 5
+    lines = out.splitlines()
+    assert lines[1] == 'values (0, 0),'
+    assert lines[2] == '       (1, 1),'
+    assert lines[-1] == '       (1199, 1199)'
