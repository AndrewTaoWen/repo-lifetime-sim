@@ -887,3 +887,188 @@ def test_get_hookcallers_no_duplicates(pm: PluginManager) -> None:
     assert len(hookcallers) == 2
     caller_names = {hc.name for hc in hookcallers}
     assert caller_names == {"hello", "goodbye"}
+
+
+def test_unregister_falsy_plugin(he_pm: PluginManager) -> None:
+    """A plugin object which is falsy (e.g. ``__len__`` returning 0) must be
+    fully unregistered, and can be registered again."""
+
+    class Falsy:
+        def __len__(self) -> int:
+            return 0
+
+        @hookimpl
+        def he_method1(self, arg: int) -> int:
+            return arg
+
+    plugin = Falsy()
+    he_pm.register(plugin, "falsy")
+    assert he_pm.unregister(plugin) is plugin
+    assert not he_pm.has_plugin("falsy")
+    assert he_pm.get_name(plugin) is None
+    assert he_pm.hook.he_method1(arg=1) == []
+    he_pm.register(plugin, "falsy")
+    assert he_pm.hook.he_method1(arg=1) == [1]
+
+    he_pm.set_blocked("falsy")
+    assert he_pm.is_blocked("falsy")
+    assert he_pm.hook.he_method1(arg=1) == []
+
+
+def test_register_equal_but_distinct_plugins(he_pm: PluginManager) -> None:
+    """Plugins are identified by identity, not equality (e.g. dataclasses)."""
+
+    class Plugin:
+        def __init__(self, value: int) -> None:
+            self.value = value
+
+        def __eq__(self, other: object) -> bool:
+            return isinstance(other, Plugin) and other.value == self.value
+
+        __hash__ = None  # type: ignore[assignment]
+
+        @hookimpl
+        def he_method1(self, arg: int) -> int:
+            return self.value
+
+    p1, p2 = Plugin(1), Plugin(1)
+    he_pm.register(p1, "p1")
+    assert not he_pm.is_registered(p2)
+    assert he_pm.get_name(p2) is None
+    he_pm.register(p2, "p2")
+    assert he_pm.get_name(p2) == "p2"
+    assert he_pm.hook.he_method1(arg=0) == [1, 1]
+    he_pm.unregister(p2)
+    assert he_pm.get_name(p1) == "p1"
+    assert len(he_pm.hook.he_method1.get_hookimpls()) == 1
+    assert he_pm.hook.he_method1.get_hookimpls()[0].plugin is p1
+
+
+def test_register_failure_leaves_no_state(he_pm: PluginManager) -> None:
+    """If registration fails validation, the plugin must not stay
+    (half-)registered, and can be fixed and registered again."""
+
+    class Plugin:
+        @hookimpl
+        def he_method1(self, arg: int) -> int:
+            return arg  # pragma: no cover
+
+        @hookimpl
+        def he_method1_unknown(self) -> None:
+            pass  # pragma: no cover
+
+        @hookimpl(specname="he_method1")
+        def zzz_bad(self, arg: int, wrong: int) -> int:
+            return arg  # pragma: no cover
+
+    plugin = Plugin()
+    with pytest.raises(PluginValidationError):
+        he_pm.register(plugin, "plugin")
+    assert not he_pm.has_plugin("plugin")
+    assert not he_pm.is_registered(plugin)
+    assert he_pm.hook.he_method1.get_hookimpls() == []
+    assert not hasattr(he_pm.hook, "he_method1_unknown")
+    he_pm.check_pending()
+
+    class Good:
+        @hookimpl
+        def he_method1(self, arg: int) -> int:
+            return arg
+
+    he_pm.register(Good(), "plugin")
+    assert he_pm.hook.he_method1(arg=2) == [2]
+
+
+def test_register_failure_in_historic_replay(pm: PluginManager) -> None:
+    class Hooks:
+        @hookspec(historic=True)
+        def he_method1(self, arg: int) -> None:
+            pass  # pragma: no cover
+
+    pm.add_hookspecs(Hooks)
+    pm.hook.he_method1.call_historic(kwargs=dict(arg=1))
+
+    class Plugin:
+        @hookimpl
+        def he_method1(self, arg: int) -> None:
+            raise RuntimeError("boom")
+
+    plugin = Plugin()
+    with pytest.raises(RuntimeError):
+        pm.register(plugin)
+    assert not pm.is_registered(plugin)
+    assert pm.hook.he_method1.get_hookimpls() == []
+
+
+def test_add_hookspecs_failure_leaves_no_state(pm: PluginManager) -> None:
+    class Plugin:
+        @hookimpl
+        def he_method1(self, arg: int, wrong: int) -> None:
+            pass  # pragma: no cover
+
+    pm.register(Plugin())
+
+    class Hooks:
+        @hookspec
+        def he_method0(self, arg: int) -> None:
+            pass  # pragma: no cover
+
+        @hookspec
+        def he_method1(self, arg: int) -> None:
+            pass  # pragma: no cover
+
+    with pytest.raises(PluginValidationError):
+        pm.add_hookspecs(Hooks)
+    assert not pm.hook.he_method1.has_spec()
+    assert not hasattr(pm.hook, "he_method0")
+
+
+def test_register_plugin_with_raising_property(he_pm: PluginManager) -> None:
+    class Plugin:
+        @property
+        def broken(self) -> int:
+            raise RuntimeError("not available")
+
+        @hookimpl
+        def he_method1(self, arg: int) -> int:
+            return arg
+
+    he_pm.register(Plugin())
+    assert he_pm.hook.he_method1(arg=3) == [3]
+
+
+def test_subset_hook_caller_specname(he_pm: PluginManager) -> None:
+    """Plugins implementing the hook via ``specname`` are excluded too."""
+
+    class A:
+        @hookimpl(specname="he_method1")
+        def other_name(self, arg: int) -> str:
+            return "a"
+
+    class B:
+        @hookimpl
+        def he_method1(self, arg: int) -> str:
+            return "b"
+
+    a = A()
+    he_pm.register(a)
+    he_pm.register(B())
+    assert he_pm.subset_hook_caller("he_method1", [a])(arg=1) == ["b"]
+
+
+def test_subset_hook_caller_unhashable_plugins(he_pm: PluginManager) -> None:
+    class Unhashable:
+        __hash__ = None  # type: ignore[assignment]
+
+        def __init__(self, value: str) -> None:
+            self.value = value
+
+        @hookimpl
+        def he_method1(self, arg: int) -> str:
+            return self.value
+
+    a, b = Unhashable("a"), Unhashable("b")
+    he_pm.register(a, "a")
+    he_pm.register(b, "b")
+    hc = he_pm.subset_hook_caller("he_method1", [a])
+    assert hc(arg=1) == ["b"]
