+class _ShortReads(io.RawIOBase):
+    def __init__(self, data: bytes) -> None:
+        self.data = data
+
+    def readable(self) -> bool:
+        return True
+
+    def readinto(self, b):  # type: ignore[no-untyped-def]
+        n = min(len(b), 3, len(self.data))
+        b[:n] = self.data[:n]
+        self.data = self.data[n:]
+        return n
+
+
+def test_limited_stream_short_read() -> None:
+    stream = LimitedStream(_ShortReads(b"abcdefghij"), 10)
+    buf = bytearray(100)
+    assert stream.readinto(memoryview(buf)) == 3
+    assert len(buf) == 100
+    assert buf[:3] == b"abc"
+    buffered = io.BufferedReader(LimitedStream(_ShortReads(b"abcdefghij"), 10))
+    assert buffered.read() == b"abcdefghij"
+
