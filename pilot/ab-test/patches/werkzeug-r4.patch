+def _encode_idna(domain: str) -> str:
+    try:
+        # An ASCII domain doesn't need encoding. The IDNA codec would reject some
+        # valid ASCII names, such as labels longer than 63 characters.
+        return domain.encode("ascii").decode("ascii")
+    except UnicodeEncodeError:
+        pass
+
+    try:
+        return domain.encode("idna").decode("ascii")
+    except UnicodeError:
+        pass
+
+    # Encode each label separately, leaving ASCII labels unchanged.
+    parts = []
+
+    for part in domain.split("."):
+        try:
+            parts.append(part.encode("ascii").decode("ascii"))
+        except UnicodeEncodeError:
+            parts.append(part.encode("idna").decode("ascii"))
+
+    return ".".join(parts)
+
+
