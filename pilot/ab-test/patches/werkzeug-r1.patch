+def _get_port(parts: urllib.parse.SplitResult) -> str | None:
+    """Get the port from a split URL as a string, without validating it.
+    ``SplitResult.port`` raises an error if the port is not a valid number,
+    and drops a ``0`` port.
+    """
+    netloc = parts.netloc.rpartition("@")[2]
+
+    if netloc.startswith("["):
+        port = netloc.partition("]")[2]
+    else:
+        _, sep, port = netloc.rpartition(":")
+        port = sep + port
+
+    if not port.startswith(":"):
+        return None
+
+    return quote(port[1:], safe="") or None
+
+
+def _encode_idna(domain: str) -> str:
+    """Encode a domain with IDNA. If the domain is ASCII it is returned
+    unchanged. If encoding fails, such as for an empty or too long label, the
+    domain is percent encoded instead of raising an error.
+    """
+    if domain.isascii():
+        return domain
+
+    try:
+        return domain.encode("idna").decode("ascii")
+    except UnicodeError:
+        return quote(domain, safe="")
+
+
 def _decode_idna(domain: str) -> str:
     try:
         data = domain.encode("ascii")
