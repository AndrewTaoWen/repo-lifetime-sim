+@pytest.mark.parametrize('copier', [
+    copy.copy, copy.deepcopy,
+    lambda x: __import__('pickle').loads(__import__('pickle').dumps(x))])
+def test_token_types_survive_copy_and_pickle(copier):
+    assert copier(T.Keyword.DML) is T.Keyword.DML
+    assert copier(T.Token) is T.Token
+    stmt = copier(sqlparse.parse('select a from b where c = 1')[0])
+    assert stmt.tokens[0].ttype is T.Keyword.DML
+    assert stmt.get_type() == 'SELECT'
+    # copies can be processed further (grouping relies on identity)
+    assert sqlparse.format(str(stmt), reindent=True) == \
+        'select a\nfrom b\nwhere c = 1'
+
