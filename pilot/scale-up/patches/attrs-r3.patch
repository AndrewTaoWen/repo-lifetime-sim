+# SPDX-License-Identifier: MIT
+
+"""
+Regression tests for latent bugs fixed during hardening.
+"""
+
+import collections
+import copy
+import functools
+import pickle
+import types
+
+import pytest
+
+import attr
+import attrs
+
+from attr._make import _is_class_var
+from attr.exceptions import FrozenAttributeError, FrozenInstanceError
+
+
+# Globals that used to shadow names used by generated methods.
+_config = {"not": "attrs"}
+_compat = types.SimpleNamespace()
+
+
+def hash(x):  # noqa: A001
+    return 42
+
+
+@attrs.frozen
+class ShadowedGlobals:
+    x: int = attrs.field(validator=attrs.validators.instance_of(int))
+
+
+class TestModuleGlobalsDontShadow:
+    def test_init_repr_hash(self):
+        """
+        Module globals named like attrs internals (_config, _compat, hash)
+        don't break generated methods.
+        """
+        i = ShadowedGlobals(1)
+
+        assert "ShadowedGlobals(x=1)" == repr(i)
+        assert 42 != i.__hash__()
+        assert i.__hash__() == ShadowedGlobals(1).__hash__()
+
+
+class TestGlobalNameCollisions:
+    def test_converter_vs_field_named_converter_x(self):
+        """
+        A field named converter_<x> with a validator doesn't clobber the
+        converter of field <x>.
+        """
+
+        @attrs.define
+        class C:
+            x: int = attrs.field(converter=int)
+            converter_x: int = attrs.field(
+                default=0, validator=attrs.validators.instance_of(int)
+            )
+
+        assert C(1, 0) == C("1")
+
+    def test_factory_vs_field_named_factory_x(self):
+        @attrs.define
+        class C:
+            x: list = attrs.field(factory=list)
+            factory_x: int = attrs.field(
+                default=0, validator=attrs.validators.instance_of(int)
+            )
+
+        assert [] == C().x
+
+
+class TestDefineReuse:
+    def test_reused_decorator_on_frozen_subclass(self):
+        """
+        Reusing a define() decorator doesn't leak on_setattr between classes.
+        """
+        d = attrs.define()
+
+        @d
+        class A:
+            x: int
+
+        @attrs.frozen
+        class F:
+            y: int
+
+        @d
+        class G(F):
+            z: int
+
+        with pytest.raises(FrozenInstanceError):
+            G(1, 2).z = 3
+
+    def test_reused_decorator_keeps_validation(self):
+        d = attrs.define()
+
+        @attrs.frozen
+        class F:
+            y: int
+
+        @d
+        class G(F):
+            z: int
+
+        @d
+        class B:
+            x: int = attrs.field(validator=attrs.validators.instance_of(int))
+
+        b = B(1)
+        with pytest.raises(TypeError):
+            b.x = "nope"
+
+
+def test_make_class_doesnt_mutate_attrs_dict():
+    """
+    make_class() leaves the passed dict alone, so it can be reused.
+    """
+    calls = []
+    d = {"x": attr.ib(), "__attrs_post_init__": lambda self: calls.append(1)}
+
+    attr.make_class("C1", d)(1)
+    attr.make_class("C2", d)(1)
+
+    assert [1, 1] == calls
+    assert "__attrs_post_init__" in d
+
+
+P = collections.namedtuple("P", "a b")
+P1 = collections.namedtuple("P1", "a")
+
+
+@attrs.define
+class Holder:
+    x: object
+
+
+class TestNamedTuplesInAsdict:
+    def test_nested_in_list(self):
+        assert {"x": [P(1, 2)]} == attrs.asdict(Holder([P(1, 2)]))
+
+    def test_dict_keys_and_values(self):
+        assert {"x": {P(1, 2): P(3, 4)}} == attrs.asdict(
+            Holder({P(1, 2): P(3, 4)})
+        )
+
+    def test_single_field(self):
+        """
+        Single-field named tuples aren't stuffed with a list.
+        """
+        assert {"x": P1(5)} == attrs.asdict(Holder(P1(5)))
+        assert {"x": [P1(5)]} == attrs.asdict(Holder([P1(5)]))
+        assert (P1(5),) == attrs.astuple(Holder(P1(5)))
+
+
+def test_astuple_retains_defaultdict():
+    dd = collections.defaultdict(list, a=[1])
+
+    (rv,) = attrs.astuple(Holder(dd))
+
+    assert dd == rv
+    assert list is rv.default_factory
+
+
+def test_optional_list_validator_hashable():
+    """
+    optional() with a list of validators produces a hashable validator.
+    """
+
+    @attrs.define
+    class C:
+        x: int = attrs.field(
+            validator=attrs.validators.optional(
+                [attrs.validators.instance_of(int)]
+            )
+        )
+
+    assert isinstance(hash(attrs.fields(C).x), int)
+    assert hash(
+        attrs.validators.optional([attrs.validators.instance_of(int)])
+    ) == hash(attrs.validators.optional((attrs.validators.instance_of(int),)))
+
+
+class TestOddBaseSlots:
+    def test_string_slots(self):
+        class Base:
+            __slots__ = "value"
+
+        @attrs.define
+        class C(Base):
+            x: int
+
+        c = C(1)
+        c.value = 3
+
+        assert 3 == c.value
+
+    def test_mangled_slots(self):
+        class Base:
+            __slots__ = ("__secret",)
+
+        @attrs.define
+        class C(Base):
+            x: int
+
+        assert 1 == C(1).x
+
+
+def test_slotted_copy_with_unset_attribute():
+    """
+    Slotted instances with unset attributes can be copied and pickled.
+    """
+
+    @attrs.define
+    class C:
+        x: int
+        y: int = attrs.field(init=False)
+
+    c = C(1)
+
+    assert 1 == copy.copy(c).x
+    assert 1 == copy.deepcopy(c).x
+
+    c.y = 2
+
+    assert 2 == copy.copy(c).y
+
+
+def test_cmp_using_against_other_types():
+    """
+    cmp_using classes don't crash when compared to other types.
+    """
+    C = attrs.cmp_using(eq=lambda a, b: a == b, lt=lambda a, b: a < b)
+
+    assert C(1) == C(1)
+    assert C(1) != 1
+    assert C(1) != None  # noqa: E711
+
+
+@pytest.mark.parametrize(
+    "annot", ["ClassVariable", "t.ClassVarFoo", "'ClassVarious[int]'"]
+)
+def test_is_class_var_prefix_only(annot):
+    assert not _is_class_var(annot)
+
+
+def test_fields_dict_generic():
+    import typing
+
+    T = typing.TypeVar("T")
+
+    @attrs.define
