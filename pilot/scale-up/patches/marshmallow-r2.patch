+def _pair_with_originals(data, original_data) -> list[tuple[typing.Any, typing.Any]]:
+    """Pair each item of ``data`` with the item at the same position in
+    ``original_data``, or `None` if ``original_data`` has no such item.
+
+    The result always has the same length as ``data``, even when
+    ``original_data`` is shorter, longer, or not iterable at all (e.g. when
+    a ``pass_collection`` pre-processor filtered the collection).
+    """
+    try:
+        originals = iter(original_data)
+    except TypeError:
+        originals = iter(())
+    return [(item, next(originals, None)) for item in data]
+
+
+def _get_loaded_value(data, key: str):
+    """Get the value for ``key`` from deserialized ``data``, following
+    dot-delimited keys into nested dicts (see `marshmallow.utils.set_value`).
+
+    :raises KeyError: If the value is not present.
+    """
+    if key in data:
+        return data[key]
+    if "." not in key:
+        raise KeyError(key)
+    target = data
+    for part in key.split("."):
+        if not isinstance(target, Mapping) or part not in target:
+            raise KeyError(key)
+        target = target[part]
+    return target
+
+
+def _pop_loaded_value(data, key: str) -> None:
+    """Remove the value for ``key`` from deserialized ``data``, following
+    dot-delimited keys into nested dicts.
+    """
+    if key in data or "." not in key:
+        data.pop(key, None)
+        return
+    *parents, last = key.split(".")
+    target = data
+    for part in parents:
+        target = target.get(part) if isinstance(target, Mapping) else None
+        if target is None:
+            return
+    if isinstance(target, dict):
+        target.pop(last, None)
+
+
