index 1e7929a..95cd3c7 100644
--- a/tests/test_lfu.py
+++ b/tests/test_lfu.py
@@ -88,3 +88,23 @@ class LFUCacheTest(unittest.TestCase, CacheTestMixin):
         self.assertIn(3, cache)
         self.assertIn(5, cache)
         self.assertNotIn(4, cache)
+
+    def test_lfu_deepcopy_pickle_many_counts(self):
+        import copy
+        import pickle
+
+        # many distinct use counts result in a long linked list, which
+        # must not be copied or pickled recursively
+        n = 600
+        cache = LFUCache[int, int](maxsize=n)
+        for i in range(n):
+            cache[i] = i
+            for _ in range(i):
+                cache[i]
+        for copied in (copy.deepcopy(cache), pickle.loads(pickle.dumps(cache))):
+            self.assertEqual(cache, copied)
+            # least frequently used item is evicted first
+            self.assertEqual((0, 0), copied.popitem())
+            self.assertEqual((1, 1), copied.popitem())
+            copied[n] = n
+            self.assertEqual((n, n), copied.popitem())
