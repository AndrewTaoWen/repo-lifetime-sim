+    assert c.get_cookie("a").value == "b"
+
+
+def test_client_cookie_past_expires_deletes():
+    c = Client(_cookie_app("a=; Expires=Sat, 01 Jan 2000 00:00:00 GMT"))
+    c.set_cookie("a", "b")
+    c.get("/")
+    assert c.get_cookie("a") is None
+    c = Client(_cookie_app("a=; Max-Age=-1"))
+    c.set_cookie("a", "b")
+    c.get("/")
+    assert c.get_cookie("a") is None
+    future = http.http_date(datetime.now(timezone.utc) + timedelta(days=1))
+    c = Client(_cookie_app(f"a=c; Expires={future}"))
+    c.get("/")
+    assert c.get_cookie("a").value == "c"
