index d4e3ad4..898f3e6 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -1,4 +1,6 @@
 import os
+import subprocess
+import sys
 from pathlib import Path
 from typing import Optional
 
@@ -293,3 +295,32 @@ def test_run_with_dotenv_and_command_flags(dotenv_path, tmp_path):
 
     check_process(result, exit_code=0)
     assert result.stdout.strip().startswith("dotenv, version")
+
+
+def test_get_reads_file_as_utf8(dotenv_path):
+    dotenv_path.write_bytes("a=\u00e9\u20ac\n".encode("utf-8"))
+    package_root = Path(dotenv.__file__).resolve().parent.parent
+    env = {
+        **os.environ,
+        "PYTHONPATH": str(package_root),
+        "PYTHONUTF8": "0",
+        "PYTHONIOENCODING": "utf-8",
+        "LC_ALL": "C",
+    }
+
+    result = subprocess.run(
+        [sys.executable, "-m", "dotenv", "--file", str(dotenv_path), "get", "a"],
+        capture_output=True,
+        env=env,
+    )
+
+    assert result.returncode == 0, result.stderr
+    assert result.stdout.decode("utf-8") == "\u00e9\u20ac\n"
+
+
+def test_default_file_follows_current_directory(cli):
+    Path(".env").write_text("A=x\n")
+
+    result = cli.invoke(dotenv_cli, ["get", "A"])
+
+    assert (result.exit_code, result.output) == (0, "x\n")
diff --git a/tests/test_main.py b/tests/test_main.py
index 1c33c80..85e3773 100644
--- a/tests/test_main.py
+++ b/tests/test_main.py
@@ -708,3 +708,80 @@ def test_dotenv_values_file_stream(dotenv_path):
         result = dotenv.dotenv_values(stream=f)
 
     assert result == {"a": "b"}
+
+
+@pytest.mark.parametrize(
+    "value",
+    ["a\\\\b", "a\\", "x\\'y", "C:\\path", "\\'", "end\\\\"],
+)
+@pytest.mark.parametrize("quote_mode", ["always", "auto"])
+def test_set_key_backslashes_round_trip(dotenv_path, value, quote_mode):
+    dotenv.set_key(dotenv_path, "a", value, quote_mode=quote_mode)
+
+    assert dotenv.dotenv_values(dotenv_path) == {"a": value}
+
+
+def test_set_key_preserves_crlf_line_endings(dotenv_path):
+    dotenv_path.write_bytes(b"a=b\r\nc=d\r\n")
+
+    dotenv.set_key(dotenv_path, "c", "e")
+    dotenv.set_key(dotenv_path, "f", "g")
+
+    assert dotenv_path.read_bytes() == b"a=b\r\nc='e'\r\nf='g'\r\n"
+
+
+def test_set_key_crlf_file_without_trailing_newline(dotenv_path):
+    dotenv_path.write_bytes(b"a=b\r\nc=d")
+
+    dotenv.set_key(dotenv_path, "f", "g")
+
+    assert dotenv_path.read_bytes() == b"a=b\r\nc=d\r\nf='g'\r\n"
+
+
+def test_unset_key_preserves_crlf_line_endings(dotenv_path):
+    dotenv_path.write_bytes(b"a=b\r\nc=d\r\ne=f\r\n")
+
+    dotenv.unset_key(dotenv_path, "c")
+
+    assert dotenv_path.read_bytes() == b"a=b\r\ne=f\r\n"
+
+
+def test_unset_key_missing_key_leaves_file_untouched(tmp_path):
+    target = tmp_path / "target.env"
+    target.write_text("a=b\n")
+    symlink = tmp_path / ".env"
+    symlink.symlink_to(target)
+    logger = logging.getLogger("dotenv.main")
+
+    with mock.patch.object(logger, "warning"):
+        result = dotenv.unset_key(symlink, "nx")
+
+    assert result == (None, "nx")
+    assert symlink.is_symlink()
+    assert target.read_text() == "a=b\n"
+    assert sorted(p.name for p in tmp_path.iterdir()) == [".env", "target.env"]
+
+
+def test_find_dotenv_without_any_file_frame(tmp_path):
+    (tmp_path / ".env").write_text("A=x\n")
+    code = "import dotenv; print(dotenv.find_dotenv())"
+
+    result = subprocess.run(
+        [sys.executable, "-"],
+        input=code,
+        cwd=tmp_path,
+        capture_output=True,
+        text=True,
+    )
+
+    assert result.returncode == 0, result.stderr
+    assert result.stdout.strip() == str(tmp_path / ".env")
+
+
+def test_dotenv_values_interpolation_many_keys_is_not_quadratic():
+    content = "".join(f"K{i}=${{K{i - 1}:-x}}\n" for i in range(20000))
+
+    result = dotenv.dotenv_values(stream=io.StringIO(content))
+
+    assert len(result) == 20000
+    assert result["K19999"] == "x"
