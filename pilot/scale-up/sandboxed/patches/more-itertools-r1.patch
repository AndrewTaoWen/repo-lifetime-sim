+class RegressionTests(TestCase):
+    """Regression tests for edge-case bugs."""
+
+    def test_bucket_lookup_does_not_add_keys(self):
+        s = mi.bucket(['a1', 'b1', 'a2'], key=lambda x: x[0])
+        self.assertNotIn('z', s)
+        self.assertEqual(list(s['y']), [])
+        self.assertEqual(sorted(s), ['a', 'b'])
+
+    def test_bucket_keys_consumed_directly_are_listed(self):
+        s = mi.bucket(['a1', 'b1'], key=lambda x: x[0])
+        self.assertEqual(list(s['a']), ['a1'])
+        self.assertEqual(sorted(s), ['a', 'b'])
+
+    def test_divide_mapping(self):
+        d = {'a': 1, 'b': 2, 'c': 3}
+        actual = [list(c) for c in mi.divide(2, d)]
+        self.assertEqual(actual, [['a', 'b'], ['c']])
+
+    def test_sort_together_empty(self):
+        self.assertEqual(mi.sort_together([[], []]), [(), ()])
+        self.assertEqual(mi.sort_together(iter([(), [], ''])), [(), (), ()])
+        xs, ys = mi.sort_together([[], []], key=lambda x: x)
+        self.assertEqual((xs, ys), ((), ()))
+        with self.assertRaises(ValueError):
+            mi.sort_together([[], [1]], strict=True)
+
+    def test_interleave_evenly_no_iterables(self):
+        self.assertEqual(list(mi.interleave_evenly([])), [])
+        self.assertEqual(list(mi.interleave_evenly([], lengths=[])), [])
+
+    def test_outer_product_empty_ys(self):
+        self.assertEqual(list(mi.outer_product(mul, [1, 2], [])), [(), ()])
+        self.assertEqual(list(mi.outer_product(mul, [], [])), [])
+
+    def test_sample_weighted_short_population(self):
+        self.assertEqual(mi.sample([], 3, weights=[]), [])
+        self.assertEqual(sorted(mi.sample('ab', 3, weights=[1, 2])), ['a', 'b'])
+        with self.assertRaises(ValueError):
+            mi.sample([], 3, weights=[], strict=True)
+
+    def test_value_chain_propagates_iteration_errors(self):
+        def gen():
+            yield 1
+            raise TypeError('boom')
+
+        with self.assertRaises(TypeError):
+            list(mi.value_chain(gen()))
+        self.assertEqual(list(mi.value_chain(1, [2], 'ab')), [1, 2, 'ab'])
+
+    def test_time_limited_does_not_consume_after_timeout(self):
+        source = iter(range(100))
+        tl = mi.time_limited(0, source)
+        self.assertEqual(list(tl), [])
+        self.assertIsNone(next(tl, None))
+        self.assertEqual(next(source), 0)
+
+        def slow():
+            yield 1
+            sleep(0.05)
+            yield 2
+            yield 3
+            yield 4
+
+        source = slow()
+        tl = mi.time_limited(0.01, source)
+        self.assertEqual(list(tl), [1])
+        self.assertTrue(tl.timed_out)
+        self.assertIsNone(next(tl, None))
+        self.assertIsNone(next(tl, None))
+        self.assertEqual(next(source), 3)
+
+    def test_combination_with_replacement_index_none_items(self):
+        pool = [0, None, 1]
+        for r in range(4):
+            for index, element in enumerate(
+                combinations_with_replacement(pool, r)
+            ):
+                with self.subTest(element=element):
+                    self.assertEqual(
+                        mi.combination_with_replacement_index(element, pool),
+                        index,
+                    )
+
+    def test_numeric_range_float_len_and_reversed(self):
+        cases = [
+            (-4.0, 5.0, 0.3),
+            (-1.0, 2.0, 0.9),
+            (-3.14, 4.0, 0.97),
+            (3.46, -1.0, -0.08),
+            (0.19, -3.0, -0.08),
+        ]
+        for args in cases:
+            with self.subTest(args=args):
+                r = mi.numeric_range(*args)
+                items = list(r)
+                self.assertEqual(len(r), len(items))
+                self.assertEqual([r[i] for i in range(len(r))], items)
+                self.assertEqual(list(reversed(r)), items[::-1])
+                self.assertEqual(r[-1], items[-1])
+
+    def test_numeric_range_reversed_exact_types(self):
+        r = mi.numeric_range(Fraction(1, 3), Fraction(7, 3), Fraction(1, 2))
+        self.assertEqual(list(reversed(r)), list(r)[::-1])
+        r = mi.numeric_range(
+            datetime(2019, 1, 1), datetime(2019, 1, 3), timedelta(hours=7)
+        )
+        self.assertEqual(list(reversed(r)), list(r)[::-1])
+        self.assertEqual(list(reversed(mi.numeric_range(0))), [])
+
+    def test_last_propagates_iteration_errors(self):
+        def gen():
+            yield 1
+            raise IndexError('boom')
+
+        with self.assertRaises(IndexError):
+            mi.last(gen(), default=None)
+        with self.assertRaises(TypeError):
+            mi.last(map(int, ['1', None]), default=0)
+        with self.assertRaises(TypeError):
+            mi.nth_or_last(map(int, ['1', None]), 5, default=0)
+        # Non-iterables still behave like empty iterables
+        self.assertEqual(mi.last(5, default='x'), 'x')
+        self.assertEqual(mi.last(iter([0, None])), None)
