diff --git a/tests/test_regressions.py b/tests/test_regressions.py
new file mode 100644
index 0000000..3e235b2
--- /dev/null
+++ b/tests/test_regressions.py
@@ -0,0 +1,315 @@
+"""Regression tests for latent bugs fixed during hardening."""
+
+import threading
+
+import pytest
+
+from marshmallow import (
+    INCLUDE,
+    Schema,
+    ValidationError,
+    class_registry,
+    fields,
+    missing,
+    post_load,
+    pre_load,
+    validate,
+    validates,
+    validates_schema,
+)
+from marshmallow.experimental.context import Context
+from marshmallow.orderedset import OrderedSet
+from marshmallow.utils import get_value
+
+
+# fields.TimeDelta
+
+
+@pytest.mark.parametrize("value", ["nan", float("nan"), "-nan", True, False])
+def test_timedelta_rejects_nan_and_bool(value):
+    with pytest.raises(ValidationError, match="Not a valid period of time."):
+        fields.TimeDelta().deserialize(value)
+
+
+# fields.Field.deserialize + pre_load
+
+
+def test_pre_load_returning_none_respects_allow_none():
+    field = fields.Raw(pre_load=lambda v: v or None)
+    with pytest.raises(ValidationError, match="Field may not be null."):
+        field.deserialize("")
+    assert fields.Raw(pre_load=lambda v: v or None, allow_none=True).deserialize(
+        ""
+    ) is None
+
+
+def test_pre_load_returning_none_gives_null_error_in_schema():
+    class S(Schema):
+        num = fields.Int(pre_load=lambda v: v.strip() or None)
+
+    with pytest.raises(ValidationError) as excinfo:
+        S().load({"num": "  "})
+    assert excinfo.value.messages == {"num": ["Field may not be null."]}
+
+
+# fields.Nested schema cache
+
+
+def test_nested_schema_cache_not_shared_with_bound_copies():
+    class Child(Schema):
+        a = fields.Int()
+        b = fields.Int()
+
+    class Parent(Schema):
+        child = fields.Nested(Child)
+
+    # Introspecting the class-level field caches its schema...
+    assert isinstance(Parent._declared_fields["child"].schema, Child)
+    # ...which must not leak into schema instances with their own options
+    data = {"child": {"a": 1, "b": 2}}
+    assert Parent(only=("child.a",)).dump(data) == {"child": {"a": 1}}
+    assert Parent(exclude=("child.a",)).dump(data) == {"child": {"b": 2}}
+    assert Parent().dump(data) == data
+
+
+# utils.get_value
+
+
+def test_get_value_does_not_return_dict_methods_for_missing_keys():
+    for name in ("items", "keys", "values", "get", "copy", "pop"):
+        assert get_value({}, name) is missing
+        assert get_value({name: 1}, name) == 1
+
+
+def test_dump_dict_with_missing_key_named_like_dict_method():
+    class S(Schema):
+        items = fields.Str()
+        values = fields.Raw()
+        name = fields.Str()
+
+    assert S().dump({"name": "x"}) == {"name": "x"}
+    assert S().dump({"name": "x", "items": "y"}) == {"name": "x", "items": "y"}
+
+
+def test_get_value_still_falls_back_to_attributes_on_objects():
+    class Obj:
+        items = 42
+
+    assert get_value(Obj(), "items") == 42
+
+
+# Schema: @validates with attribute
+
+
+def test_validates_runs_for_field_with_dotted_attribute():
+    class S(Schema):
+        x = fields.Int(attribute="a.b")
+
+        @validates("x")
+        def validate_x(self, value, data_key):
+            if value < 0:
+                raise ValidationError("negative")
+
+    with pytest.raises(ValidationError) as excinfo:
+        S().load({"x": -1})
+    assert excinfo.value.messages == {"x": ["negative"]}
+    assert excinfo.value.valid_data == {"a": {}}
+    assert S().load({"x": 1}) == {"a": {"b": 1}}
+    with pytest.raises(ValidationError):
+        S(many=True).load([{"x": 1}, {"x": -1}])
+
+
+@pytest.mark.parametrize("many", [True, False])
+def test_validates_failure_removes_value_stored_under_attribute(many):
+    class S(Schema):
+        y = fields.Int(attribute="yy")
+
+        @validates("y")
+        def validate_y(self, value, data_key):
+            raise ValidationError("bad")
+
+    data = [{"y": 1}] if many else {"y": 1}
+    with pytest.raises(ValidationError) as excinfo:
+        S(many=many).load(data)
+    assert excinfo.value.valid_data == ([{}] if many else {})
+
+
+# Schema: collection length changed by pre_load
+
+
+class FilteringSchema(Schema):
+    x = fields.Int()
+
+    @pre_load(pass_collection=True)
+    def drop_empty(self, data, **kwargs):
+        return [item for item in data if item]
+
+    @validates_schema(pass_original=True)
+    def check(self, data, original_data, **kwargs):
+        if data["x"] < 0:
+            raise ValidationError("negative")
+
+    @post_load(pass_original=True)
+    def add_original(self, data, original_data, **kwargs):
+        data["original"] = original_data
+        return data
+
+
+def test_schema_validators_and_post_load_when_pre_load_changes_length():
+    result = FilteringSchema(many=True).load([{"x": 1}, {}])
+    assert result == [{"x": 1, "original": {"x": 1}}]
+    with pytest.raises(ValidationError) as excinfo:
+        FilteringSchema(many=True).load([{}, {"x": 1}, {"x": -1}])
+    assert excinfo.value.messages == {1: {"_schema": ["negative"]}}
+
+
+# Schema: invalid field names
+
+
+def test_meta_fields_with_undeclared_field_raises_value_error():
+    class S(Schema):
+        a = fields.Int()
+
+        class Meta:
+            fields = ("a", "b")
+
+    with pytest.raises(ValueError, match="Invalid fields"):
+        S()
+
+
+@pytest.mark.parametrize("param", ["only", "exclude"])
+def test_unknown_dotted_field_name_raises_value_error(param):
+    class S(Schema):
+        a = fields.Int()
+
+    with pytest.raises(ValueError, match="Invalid fields"):
+        S(**{param: ("nope.x",)})
+
+
+# Schema: unknown=INCLUDE ordering
+
+
+def test_include_unknown_preserves_input_order():
+    class S(Schema):
+        known = fields.Int()
+
+        class Meta:
+            unknown = INCLUDE
+
+    data = {k: 1 for k in "zyxwvutsrq"}
+    data["known"] = 2
+    assert list(S().load(data)) == ["known", *"zyxwvutsrq"]
+
+
+# class_registry
+
+
+def test_registry_redefinition_in_same_module_replaces_class():
+    first = type("MyRedefinedSchema", (Schema,), {"__module__": "redef_module"})
+    second = type("MyRedefinedSchema", (Schema,), {"__module__": "redef_module"})
+    assert class_registry.get_class("MyRedefinedSchema") is second
+    assert class_registry.get_class("redef_module.MyRedefinedSchema") is second
+    assert first is not second
+
+
+# validate
+
+
+def test_oneof_accepts_iterators():
+    validator = validate.OneOf((c for c in "abc"), labels=iter(["A", "B", "C"]))
+    assert validator("a") == "a"
+    assert validator("c") == "c"
+    with pytest.raises(ValidationError):
+        validator("d")
+    assert list(validator.options()) == [("a", "A"), ("b", "B"), ("c", "C")]
+
+
+def test_noneof_accepts_iterators():
+    validator = validate.NoneOf(c for c in "abc")
+    with pytest.raises(ValidationError):
+        validator("a")
+    assert validator("d") == "d"
+
+
+def test_contains_only_unhashable_values_with_set_choices():
+    validator = validate.ContainsOnly({"a", "b"})
+    with pytest.raises(ValidationError):
+        validator([["a"]])
+    assert validator(["a"]) == ["a"]
+
+
