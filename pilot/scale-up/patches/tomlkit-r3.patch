diff --git a/tests/test_regressions.py b/tests/test_regressions.py
new file mode 100644
index 0000000..c30b8e6
--- /dev/null
+++ b/tests/test_regressions.py
@@ -0,0 +1,213 @@
+from __future__ import annotations
+
+import time
+
+import pytest
+
+import tomlkit
+
+from tomlkit import api
+from tomlkit.exceptions import InvalidStringError
+from tomlkit.exceptions import ParseError
+from tomlkit.items import Float
+from tomlkit.items import Integer
+
+
+def test_integer_pow_with_negative_exponent_returns_float() -> None:
+    i = tomlkit.item(2)
+    assert i**-1 == 0.5
+    assert isinstance(i**-1, float)
+    assert 2 ** tomlkit.item(-1) == 0.5
+    assert isinstance(i**2, Integer)
+    assert (i**2).as_string() == "4"
+
+
+def test_integer_pow_with_float_exponent() -> None:
+    assert tomlkit.item(4) ** 0.5 == 2.0
+
+
+def test_round_float_item_without_ndigits_returns_int() -> None:
+    f = tomlkit.item(2.6)
+    r = round(f)
+    assert r == 3
+    assert type(r) is int
+    r1 = round(tomlkit.item(2.567), 1)
+    assert isinstance(r1, Float)
+    assert r1 == 2.6
+
+
+def test_item_int_and_float_subclasses_render_as_numbers() -> None:
+    class MyInt(int):
+        def __str__(self) -> str:
+            return "MyInt!"
+
+    class MyFloat(float):
+        def __str__(self) -> str:
+            return "MyFloat!"
+
+    assert tomlkit.dumps({"a": MyInt(3), "b": MyFloat(1.5)}) == "a = 3\nb = 1.5\n"
+
+
+@pytest.mark.parametrize(
+    "index, expected",
+    [
+        (slice(-2, None), [1, 2]),
+        (slice(None, None, -1), []),
+        (slice(1, 100), [1]),
+        (slice(None, None, 2), [2, 4]),
+        (slice(-3, -1), [1, 4]),
+    ],
+)
+def test_array_delete_slices(index: slice, expected: list[int]) -> None:
+    a = api.array("[1, 2, 3, 4]")
+    del a[index]
+    assert a == expected
+    assert tomlkit.parse(f"a = {a.as_string()}")["a"] == expected
+
+
+def test_array_slice_assignment_does_not_modify_array() -> None:
+    a = api.array("[1, 2, 3]")
+    with pytest.raises(ValueError):
+        a[0:1] = [9]
+    assert a == [1, 2, 3]
+    assert a.as_string() == "[1, 2, 3]"
+
+
+def test_array_sort_and_imul_keep_rendering_in_sync() -> None:
+    a = api.array("[3, 1, 2]")
+    a.sort()
+    assert a == [1, 2, 3]
+    assert a.as_string() == "[1, 2, 3]"
+    a.sort(reverse=True)
+    assert a.as_string() == "[3, 2, 1]"
+
+    b = api.array("[1, 2]")
+    b *= 2
+    assert b == [1, 2, 1, 2]
+    assert tomlkit.parse(f"b = {b.as_string()}")["b"] == [1, 2, 1, 2]
+    b *= 0
+    assert b == []
+    assert b.as_string() == "[]"
+
+
+def test_array_append_after_line_comment_does_not_swallow_value() -> None:
+    a = api.array()
+    a.add_line(1, 2, comment="c")
+    a.add_line(indent="")
+    a.append(3)
+    assert tomlkit.parse(f"k = {a.as_string()}")["k"] == [1, 2, 3]
+
+
+def test_aot_setitem_updates_list_storage() -> None:
+    doc = tomlkit.parse("[[a]]\nx = 1\n[[a]]\nx = 2\n")
+    aot = doc["a"]
+    aot[0] = {"x": 5}
+    assert aot == [{"x": 5}, {"x": 2}]
+    assert list(aot) == [{"x": 5}, {"x": 2}]
+    assert aot[0].is_aot_element()
+    assert tomlkit.parse(doc.as_string()) == {"a": [{"x": 5}, {"x": 2}]}
+
+
+def test_aot_insert_at_front_separates_tables() -> None:
+    doc = tomlkit.document()
+    doc["a"] = api.aot()
+    doc["a"].append({"x": 1})
+    doc["a"].insert(0, {"x": 0})
+    assert doc.as_string() == "[[a]]\nx = 0\n\n[[a]]\nx = 1\n"
+
+
+def test_string_concatenation_escapes_added_part() -> None:
+    s = tomlkit.item("a") + '"b\\'
+    assert s == 'a"b\\'
+    doc = tomlkit.document()
+    doc["k"] = s
+    assert tomlkit.parse(doc.as_string())["k"] == 'a"b\\'
+
+
+def test_string_concatenation_multiline_triple_quote_boundary() -> None:
+    s = api.string('a""', multiline=True) + '"b'
+    doc = tomlkit.document()
+    doc["k"] = s
+    assert tomlkit.parse(doc.as_string())["k"] == 'a"""b'
+
+
+def test_string_concatenation_literal_invalid() -> None:
+    with pytest.raises(InvalidStringError):
+        api.string("a", literal=True) + "'"
+
+
+def test_multiline_string_with_lone_carriage_return() -> None:
+    doc = tomlkit.document()
+    doc["k"] = api.string("a\rb\r\nc", multiline=True)
+    assert tomlkit.parse(doc.as_string())["k"] == "a\rb\r\nc"
+    with pytest.raises(InvalidStringError):
+        api.string("a\rb", multiline=True, literal=True)
+
+
+def test_escape_string_is_linear() -> None:
+    s = "a\\" * 200_000
+    start = time.perf_counter()
+    rendered = tomlkit.item(s).as_string()
+    assert time.perf_counter() - start < 1.0
+    assert rendered == '"' + "a\\\\" * 200_000 + '"'
+    small = 'a\\"\n' * 10
+    assert tomlkit.parse(f"k = {tomlkit.item(small).as_string()}")["k"] == small
+
+
+@pytest.mark.parametrize(
+    "content",
+    [
+        "a\tb = 1",
+        "[a\tb]\n",
+        "[[a]x\n",
+        "a = +infinity",
+        "a = -Infinity",
+        "a = +Inf",
+        "a = NaN",
+        "a = 1٣",
+        'a = "\\U0000D800"',
+        'a = "\\U00110000"',
+        'a = "\\u00_4"',
+        'a = "\\u+041"',
+    ],
+)
+def test_invalid_documents_are_rejected(content: str) -> None:
+    with pytest.raises(ParseError):
+        tomlkit.parse(content)
+
+
+@pytest.mark.parametrize(
+    "content, expected",
+    [
+        ("a = +inf", float("inf")),
+        ("a = -inf", float("-inf")),
+        ("a = 1E5", 1e5),
+        ("a = 1e-5", 1e-5),
+        ("a = 1_000.5_5", 1000.55),
+        ("a = 0xdead_beef", 0xDEADBEEF),
+        ("a = 0o17", 15),
+        ("a = 0b101", 5),
+        ("a = -0", 0),
+        ('a = "\\U0001F600"', "\U0001f600"),
+        ('a = "\\uE000"', ""),
+    ],
+)
+def test_valid_values_still_parse(content: str, expected: object) -> None:
+    assert tomlkit.parse(content)["a"] == expected
+
+
+def test_copy_of_document_keeps_table_bookkeeping() -> None:
+    doc = tomlkit.parse("[a.b]\nx = 1\n")
+    c = doc.copy()
+    t = api.table(True)
+    t.append("c", {"y": 2})
+    c.append("a", t)
+    assert c == {"a": {"b": {"x": 1}, "c": {"y": 2}}}
+    assert doc == {"a": {"b": {"x": 1}}}
+
+
+def test_replace_with_new_key_and_type_change() -> None:
+    doc = tomlkit.parse("x = 1\n[a]\ny = 2\n")
+    doc._replace("x", "z", {"q": 1})
+    assert doc == {"z": {"q": 1}, "a": {"y": 2}}
+    assert tomlkit.parse(doc.as_string()) == {"z": {"q": 1}, "a": {"y": 2}}
