diff --git a/tests/test_regressions.py b/tests/test_regressions.py
new file mode 100644
index 0000000..a48818e
--- /dev/null
+++ b/tests/test_regressions.py
@@ -0,0 +1,553 @@
+"""Regression tests for edge cases in various parts of the library."""
+
+from __future__ import annotations
+
+import copy
+import io
+import pickle
+import tempfile
+from datetime import datetime
+from datetime import timezone
+
+import pytest
+
+from werkzeug import datastructures as ds
+from werkzeug import exceptions
+from werkzeug import http
+from werkzeug import routing as r
+from werkzeug import urls
+from werkzeug import utils
+from werkzeug.sansio.utils import host_is_trusted
+from werkzeug.test import Client
+from werkzeug.test import create_environ
+from werkzeug.test import EnvironBuilder
+from werkzeug.test import stream_encode_multipart
+from werkzeug.wrappers import Request
+from werkzeug.wrappers import Response
+from werkzeug.wsgi import LimitedStream
+
+
+# http
+
+
+@pytest.mark.parametrize(
+    ("header", "expect"),
+    [
+        ({"HTTP_COOKIE": "a=\xe9; b=2"}, {"a": "�", "b": "2"}),
+        ("a=☃; b=2", {"a": "☃", "b": "2"}),
+    ],
+)
+def test_parse_cookie_invalid_encoding(header, expect):
+    assert http.parse_cookie(header).to_dict() == expect
+
+
+def test_dump_header_empty_key():
+    assert http.dump_options_header("a", {"": "b"}) == "a; =b"
+    assert http.dump_header({"": "b"}) == "=b"
+
+
+def test_parse_options_header_many_parameters():
+    value = "a" + "; k=v" * 50_000 + '; last="x;y"'
+    assert http.parse_options_header(value) == ("a", {"k": "v", "last": "x;y"})
+
+
+# structures
+
+
+def test_immutable_list_clear():
+    value = ds.ImmutableList([1, 2])
+
+    with pytest.raises(TypeError):
+        value.clear()
+
+    assert value == [1, 2]
+
+
+def test_multidict_empty_list_values():
+    d = ds.MultiDict()
+    d.setlist("a", [])
+    d.setlistdefault("b")
+    d.add("c", 1)
+    assert list(d.items()) == [("c", 1)]
+    assert list(d.values()) == [1]
+    assert d.to_dict() == {"c": 1}
+
+
+def test_headerset_remove_case_insensitive():
+    hs = ds.HeaderSet(["Foo", "bar"])
+    hs.remove("Foo")
+    assert list(hs) == ["bar"]
+    assert len(hs) == 1
+    hs.discard("BAR")
+    assert list(hs) == []
+
+
+def test_headerset_no_duplicates():
+    hs = ds.HeaderSet(["a", "A", "b"])
+    assert list(hs) == ["a", "b"]
+    assert len(hs) == 2
+    assert ds.HeaderSet.from_header("a, a").to_header() == "a"
+
+    hs[1] = "A"
+    assert list(hs) == ["A"]
+    assert len(hs) == 1
+    hs.remove("a")
+    assert not hs
+
+
+def test_combined_multidict_deepcopy():
+    inner = ds.MultiDict({"a": [1]})
+    c = ds.CombinedMultiDict([inner])
+    c2 = copy.deepcopy(c)
+    assert isinstance(c2, ds.CombinedMultiDict)
+    assert c2["a"] == 1
+    assert c2.dicts[0] is not inner
+
+
+# headers
+
+
+@pytest.mark.parametrize("values", [iter([]), (x for x in []), []])
+def test_headers_setlist_empty_iterator(values):
+    h = ds.Headers([("a", "1"), ("b", "2")])
+    h.setlist("a", values)
+    assert h.to_wsgi_list() == [("b", "2")]
+
+
+def test_headers_setlist_iterator():
+    h = ds.Headers()
+    h.setlist("a", iter(["1", "2"]))
+    assert h.getlist("a") == ["1", "2"]
+
+
+@pytest.mark.parametrize("key", ["X\r\nEvil", "X\nEvil", "X\rEvil"])
+def test_headers_key_newline(key):
+    h = ds.Headers()
+
+    with pytest.raises(ValueError):
+        h.add(key, "v")
+
+    with pytest.raises(ValueError):
+        h.set(key, "v")
+
+    with pytest.raises(ValueError):
+        h[0:0] = [(key, "v")]
+
+
+def test_headers_get_type_error():
+    h = ds.Headers([("a", "x")])
+
+    def convert(value):
+        raise TypeError
+
+    assert h.get("a", "d", type=convert) == "d"
+    assert h.getlist("a", type=convert) == []
+
+
+# accept
+
+
+def test_language_accept_generator():
+    a = ds.LanguageAccept([("en", 1)])
+    assert a.best_match(x for x in ["de", "en-US"]) == "en-US"
+
+
+def test_language_accept_fallback_not_prefix():
+    a = ds.LanguageAccept([("en", 1)])
+    assert a.best_match(["eng", "en-US"]) == "en-US"
+
+
+# auth
+
+
+def test_authorization_copy_pickle():
+    a = ds.Authorization("basic", {"username": "u", "password": "p"})
+    assert copy.copy(a) == a
+    assert copy.deepcopy(a) == a
+    assert pickle.loads(pickle.dumps(a)) == a
+
+
+def test_www_authenticate_copy_pickle():
+    w = ds.WWWAuthenticate("digest", {"realm": "x"})
+    c = copy.deepcopy(w)
+    assert c == w
+    c["realm"] = "y"
+    assert w.realm == "x"
+    assert copy.copy(w) == w
+    assert pickle.loads(pickle.dumps(w)) == w
+
+
+def test_www_authenticate_property_setters():
+    w = ds.WWWAuthenticate("bearer")
+    w.token = "abc"
+    assert w.parameters == {}
+    assert w.to_header() == "Bearer abc"
+    w.type = "Digest"
+    w.token = None
+    w.parameters = {"realm": "r"}
+    assert w.type == "digest"
+    assert w.to_header() == 'Digest realm="r"'
+    updates = []
+    w._on_update = updates.append
+    w.token = "t"
+    assert updates == [w]
+
+
+# csp
+
+
+def test_csp_delete_property():
+    csp = ds.ContentSecurityPolicy()
+    csp.default_src = "'self'"
+    del csp.default_src
+    assert "default-src" not in csp
+    del csp.default_src
+
+
+def test_csp_empty_value_to_header():
+    csp = ds.ContentSecurityPolicy([("upgrade-insecure-requests", "")])
+    assert csp.to_header() == "upgrade-insecure-requests"
+
+
+# range
+
+
+def test_range_suffix_longer_than_content():
+    rng = ds.Range.from_header("bytes=-1000")
+    assert rng.range_for_length(500) == (0, 500)
+    assert rng.to_content_range_header(500) == "bytes 0-499/500"
+
+
+def test_range_suffix_zero():
+    assert ds.Range.from_header("bytes=-0") is None
+
+
+def test_make_conditional_suffix_longer_than_content():
+    env = create_environ(headers={"Range": "bytes=-1000"})
+    resp = Response(b"x" * 10)
+    resp.make_conditional(env, accept_ranges=True, complete_length=10)
+    assert resp.status_code == 206
+    assert resp.get_data() == b"x" * 10
+
+
+# file storage
+
+
+def test_file_storage_copy():
+    fs = ds.FileStorage(io.BytesIO(b"x"), "a.txt")
+    assert copy.copy(fs).filename == "a.txt"
+    assert copy.deepcopy(fs).read() == b"x"
+
+
+def test_file_storage_fd_name():
+    with tempfile.TemporaryFile() as f:
+        fs = ds.FileStorage(f)
+        assert fs.filename is None or isinstance(fs.filename, str)
+
+
+def test_file_storage_mimetype_after_header_change():
+    fs = ds.FileStorage(io.BytesIO(), "a.txt", content_type="text/plain")
+    assert fs.mimetype == "text/plain"
+    fs.headers["Content-Type"] = "image/png; a=b"
+    assert fs.mimetype == "image/png"
+    assert fs.mimetype_params == {"a": "b"}
+
+
+# urls
+
+
+@pytest.mark.parametrize(
+    "url",
+    [
+        "http://h:0/",
+        "http://u:@h/",
+        "http://:pw@h/",
+        "http://u:p@h:8080/",
+    ],
+)
+def test_iri_uri_keep_userinfo_port(url):
+    assert urls.iri_to_uri(url) == url
+    assert urls.uri_to_iri(url) == url
+
+
+@pytest.mark.parametrize(
+    "url", ["http://" + "a" * 70 + ".example/", "http://a..b/", "http://a_b.example/"]
+)
+def test_iri_to_uri_ascii_host_not_idna_validated(url):
+    assert urls.iri_to_uri(url) == url
+
+
+def test_iri_to_uri_mixed_host():
+    assert (
+        urls.iri_to_uri("http://☃." + "a" * 70 + "/")
+        == "http://xn--n3h." + "a" * 70 + "/"
+    )
+
+
+# utils
+
+
+def test_cached_property_delete_uncached():
+    class A:
+        @utils.cached_property
+        def value(self):
+            return 1
+
+    a = A()
+    del a.value
+    assert a.value == 1
+    del a.value
+
+
+@pytest.mark.parametrize(
+    ("path", "location"),
+    [
+        ("/a/javascript:alert(1)", "./javascript:alert(1)/"),
+        ("/a/x%3Fy", "x%3Fy/"),
+        ("/a/x%23y", "x%23y/"),
+        ("/a/100%25", "100%25/"),
+        ("/a/caf%C3%A9", "caf%C3%A9/"),
+    ],
+)
+def test_append_slash_redirect_quotes(path, location):
+    rv = utils.append_slash_redirect(create_environ(path))
+    assert rv.headers["Location"] == location
+
+
+def test_header_property_none_removes_header():
+    resp = Response()
+    resp.last_modified = 5
+    resp.last_modified = None
+    resp.location = "/a"
+    resp.location = None
+    resp.content_length = 1
+    resp.content_length = None
+    resp.access_control_allow_methods = ["GET"]
+    resp.access_control_allow_methods = None
+
+    for name in [
+        "Last-Modified",
+        "Location",
+        "Content-Length",
+        "Access-Control-Allow-Methods",
+    ]:
+        assert name not in resp.headers
+
+
+# wsgi
+
+
+class _ShortReads(io.RawIOBase):
+    def __init__(self, data: bytes) -> None:
+        self.data = data
+
+    def readable(self) -> bool:
+        return True
+
+    def readinto(self, b):  # type: ignore[no-untyped-def]
+        n = min(len(b), 3, len(self.data))
+        b[:n] = self.data[:n]
+        self.data = self.data[n:]
+        return n
+
+
+def test_limited_stream_short_readinto_memoryview():
+    stream = LimitedStream(_ShortReads(b"abcdefghij"), 10)
+    buf = memoryview(bytearray(100))
+    assert stream.readinto(buf) == 3
+    assert bytes(buf[:3]) == b"abc"
+    assert stream.read() == b"defghij"
