+def test_wide_identifier_list_is_not_quadratic():
+    import time
+    cols = ', '.join(f'c{i}' for i in range(3300))
+    s = f'select {cols} from t'
+    start = time.perf_counter()
+    p = sqlparse.parse(s)[0]
+    # used to take several seconds due to quadratic re-serialization
+    assert time.perf_counter() - start < 1.5
+    assert str(p) == s
+    assert p.tokens[2].value == cols
+
