+class TestOrderedSetEquality:
+    def test_compare_with_non_iterable(self):
+        assert (OrderedSet([1]) == None) is False  # noqa: E711
+        assert OrderedSet([1]) != 1
+
+    def test_compare_with_iterables(self):
+        assert OrderedSet([1, 2]) == {2, 1}
+        assert OrderedSet([1, 2]) == OrderedSet([1, 2])
+        assert OrderedSet([1, 2]) != OrderedSet([2, 1])
