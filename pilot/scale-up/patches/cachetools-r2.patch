+class Picklable:
+    def __init__(self, n):
+        self.n = n
+        self.cache = {}
+
+    @cachedmethod(lambda self: self.cache, info=True)
+    def get_info(self, x):
+        return self.n + x
+
+    @cachedmethod(lambda self: self.cache, key=keys.hashkey)
+    def get(self, x):
+        return self.n * x
+
+
+class CopyPickleTest(unittest.TestCase):
+    def test_copy(self):
+        obj = Picklable(1)
+        self.assertEqual(obj.get_info(1), 2)
+        self.assertEqual(obj.get(2), 2)
+        other = copy.copy(obj)
+        other.n = 10
+        other.cache = {}
+        # the copy's methods must be bound to the copy, not the original
+        self.assertEqual(other.get_info(1), 11)
+        self.assertEqual(other.get(2), 20)
+        self.assertIs(other.get._obj, other)
+        self.assertIs(obj.get._obj, obj)
+        self.assertEqual(obj.get_info.cache_info().misses, 1)
+        self.assertEqual(other.get_info.cache_info().misses, 1)
+
+    def test_deepcopy(self):
+        obj = Picklable(1)
+        self.assertEqual(obj.get_info(1), 2)
+        other = copy.deepcopy(obj)
+        other.n = 10
+        other.cache.clear()
+        self.assertEqual(other.get_info(1), 11)
+        self.assertEqual(obj.get_info(1), 2)
+
+    def test_pickle(self):
+        obj = Picklable(1)
+        self.assertEqual(obj.get_info(1), 2)
+        self.assertEqual(obj.get(2), 2)
+        other = pickle.loads(pickle.dumps(obj))
+        self.assertEqual(len(other.cache), 2)
+        other.n = 10
+        other.cache.clear()
+        self.assertEqual(other.get_info(1), 11)
+        self.assertIs(other.get_info._obj, other)
+
+    def test_setattr_delattr(self):
+        obj = Picklable(1)
+        self.assertEqual(obj.get(2), 2)
+        obj.get = 42
+        self.assertEqual(obj.get, 42)
+        del obj.get
+        self.assertEqual(obj.get(3), 3)
+        with unittest.mock.patch.object(obj, "get", return_value=0):
+            self.assertEqual(obj.get(3), 0)
+        self.assertEqual(obj.get(3), 3)
+
+
