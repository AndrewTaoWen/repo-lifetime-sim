+@pytest.mark.parametrize("converter_cls", [BaseConverter, Converter])
+def test_literal_bool_int_distinct(converter_cls):
+    """`True` is not `Literal[1]`, and `1` is not `Literal[True]`."""
+    c = converter_cls()
+    with pytest.raises(CattrsError):
+        c.structure(True, Literal[1])
+    with pytest.raises(CattrsError):
+        c.structure(1, Literal[True])
+    with pytest.raises(CattrsError):
+        c.structure(0, Literal[False])
+    assert c.structure(1, Literal[1]) == 1
+    assert c.structure(True, Literal[True]) is True
+    assert c.structure(0, Literal[0, True]) == 0
+    assert c.structure("a", Literal["a", 1]) == "a"
+
