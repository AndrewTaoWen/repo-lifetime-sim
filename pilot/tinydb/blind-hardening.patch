@@ -0,0 +1,261 @@
+"""
+Regression tests for latent bugs (caching, document IDs, storages, ...).
+"""
+import copy
+import os
+import re
+
+import pytest
+
+from tinydb import TinyDB, Query, where
+from tinydb.middlewares import CachingMiddleware, Middleware
+from tinydb.operations import increment
+from tinydb.storages import JSONStorage, MemoryStorage
+from tinydb.table import Document, Table
+from tinydb.utils import LRUCache, FrozenDict, freeze
+
+
+@pytest.fixture
+def mdb():
+    return TinyDB(storage=MemoryStorage)
+
+
+# --- Query cache correctness ------------------------------------------------
+
+def test_regex_flags_are_part_of_query_hash(mdb):
+    mdb.insert({'a': 'ABC'})
+    q = Query()
+
+    assert mdb.search(q.a.matches('abc')) == []
+    assert len(mdb.search(q.a.matches('abc', flags=re.I))) == 1
+    assert mdb.search(q.a.search('b')) == []
+    assert len(mdb.search(q.a.search('b', flags=re.I))) == 1
+
+    assert q.a.matches('x') != q.a.matches('x', flags=re.I)
+    # Hash/repr without flags is unchanged
+    assert q.a.matches('x') == q.a.matches('x', flags=0)
+
+
+def test_fragment_path_is_part_of_query_hash(mdb):
+    mdb.insert({'a': {'x': 1}, 'b': {}})
+    q = Query()
+
+    assert len(mdb.search(q.a.fragment({'x': 1}))) == 1
+    assert mdb.search(q.b.fragment({'x': 1})) == []
+    assert q.a.fragment({'x': 1}) != q.b.fragment({'x': 1})
+
+
+def test_uncacheable_nested_query_makes_outer_uncacheable(mdb):
+    mdb.insert({'l': [{'v': 1}]})
+    q = Query()
+
+    inner1 = q.v.map(lambda x: x) == 1
+    inner2 = q.v.map(lambda x: x) == 2
+
+    assert not q.l.any(inner1).is_cacheable()
+    assert not q.l.all(inner1).is_cacheable()
+    assert len(mdb.search(q.l.any(inner1))) == 1
+    assert mdb.search(q.l.any(inner2)) == []
+
+
+def test_mutating_search_results_does_not_corrupt_cache(mdb):
+    mdb.insert({'a': 1})
+    q = Query()
+
+    first = mdb.search(q.a == 1)
+    first[0]['a'] = 99
+    second = mdb.search(q.a == 1)
+    assert second == [{'a': 1}]
+    assert second[0].doc_id == 1
+
+    # Also when the results are returned from the cache
+    second[0]['a'] = 42
+    assert mdb.search(q.a == 1) == [{'a': 1}]
+
+
+def test_queries_with_unhashable_values(mdb):
+    mdb.insert({'a': [1, 2], 'b': 3})
+    q = Query()
+
+    assert len(mdb.search(q.a > [1])) == 1
+    assert len(mdb.search(q.a <= [1, 2])) == 1
+    assert len(mdb.search(q.b.test(lambda v, opts: v in opts, [3]))) == 1
+    assert mdb.search(q.a == (1, [2])) == []
+
+
+def test_query_with_mixed_type_dict_keys(mdb):
+    mdb.insert({'a': 1})
+    assert mdb.search(where('a') == {1: 'a', 'b': 2}) == []
+    assert hash(FrozenDict({1: 'a', 'b': 2})) == \
+        hash(FrozenDict({'b': 2, 1: 'a'}))
+
+
+def test_generator_arguments_are_not_exhausted(mdb):
+    mdb.insert_multiple([{'a': 1, 'l': [1]}, {'a': 2, 'l': [2]}])
+    q = Query()
+
+    assert len(mdb.search(q.a.one_of(x for x in [2, 1]))) == 2
+    assert len(mdb.search(q.l.any(x for x in [2, 1]))) == 2
+    assert len(mdb.search(q.l.all(x for x in [1]))) == 1
+
+
+def test_freeze_tuples():
+    assert freeze((1, [2, {'a': [3]}])) == (1, (2, FrozenDict({'a': (3,)})))
+    hash(freeze((1, [2])))
+
+
+# --- Table / document IDs -----------------------------------------------------
+
+def test_insert_multiple_does_not_overwrite_explicit_ids(mdb):
+    ids = mdb.insert_multiple([Document({'k': 1}, 1), {'k': 2}])
+
+    assert ids == [1, 2]
+    assert mdb.get(doc_id=1) == {'k': 1}
+    assert mdb.get(doc_id=2) == {'k': 2}
+
+
+def test_insert_multiple_with_document_resets_next_id(mdb):
+    mdb.insert({'k': 0})
+    mdb.insert_multiple([Document({'k': 1}, 2)])
+
+    assert mdb.insert({'k': 2}) == 3
+    assert len(mdb) == 3
+
+
+def test_insert_with_stale_next_id_does_not_fail():
+    storage = MemoryStorage()
+    t1 = Table(storage, 't')
+    t2 = Table(storage, 't')
+
+    assert t1.insert({'a': 1}) == 1
+    assert t2.insert({'a': 2}) == 2
+    # t1's cached next ID (2) is stale now
+    assert t1.insert({'a': 3}) == 3
+    assert len(t1) == 3
+
+
+def test_update_multiple_with_generator(mdb):
+    mdb.insert_multiple([{'a': 1}, {'a': 2}])
+    q = Query()
+
+    ids = mdb.update_multiple(
+        (({'b': 1}, q.a.exists()) for _ in range(1))
+    )
+
+    assert ids == [1, 2]
+    assert mdb.all() == [{'a': 1, 'b': 1}, {'a': 2, 'b': 1}]
+
+
+def test_update_multiple_returns_unique_ids(mdb):
+    mdb.insert({'a': 1})
+    q = Query()
+
+    ids = mdb.update_multiple([({'b': 1}, q.a == 1), ({'c': 1}, q.a == 1)])
+    assert ids == [1]
+    assert mdb.get(doc_id=1) == {'a': 1, 'b': 1, 'c': 1}
+
+
+def test_duplicate_doc_ids(mdb):
+    mdb.insert_multiple([{'x': 0}, {'x': 0}])
+
+    assert mdb.update(increment('x'), doc_ids=[1, 1]) == [1]
+    assert mdb.get(doc_id=1) == {'x': 1}
+
+    assert mdb.remove(doc_ids=[1, 1]) == [1]
+    assert len(mdb) == 1
+
+
+@pytest.mark.parametrize('storage', [
+    MemoryStorage, CachingMiddleware(MemoryStorage)
+])
+def test_failed_update_is_atomic(storage):
+    db = TinyDB(storage=storage)
+    db.insert_multiple([{'x': 1}, {'y': 1}])
+    db.search(where('x') == 1)
+
+    with pytest.raises(KeyError):
+        db.update(increment('x'))
+
+    assert db.all() == [{'x': 1}, {'y': 1}]
+    assert db.search(where('x') == 1) == [{'x': 1}]
+
+
+def test_default_query_cache_capacity_in_subclass():
+    class MyTable(Table):
+        default_query_cache_capacity = 2
+
+    assert MyTable(MemoryStorage(), 't')._query_cache.capacity == 2
+    assert Table(MemoryStorage(), 't')._query_cache.capacity == 10
+    assert Table(MemoryStorage(), 't', cache_size=None) \
+        ._query_cache.capacity is None
+
+
+# --- Database --------------------------------------------------------------
+
+@pytest.mark.parametrize('drop', ['drop_tables', 'drop_table'])
+def test_drop_resets_existing_table_instances(mdb, drop):
+    table = mdb.table('t')
+    table.insert({'a': 1})
+    table.insert({'a': 2})
+    assert len(table.search(where('a') == 1)) == 1
+
+    if drop == 'drop_tables':
+        mdb.drop_tables()
+    else:
+        mdb.drop_table('t')
+
+    assert table.search(where('a') == 1) == []
+    assert table.insert({'a': 3}) == 1
+
+
+def test_copy_uninitialized_database_does_not_recurse(mdb):
+    mdb.insert({'a': 1})
+    clone = copy.copy(mdb)
+    assert len(clone) == 1
+
+
+# --- Storages / middlewares ---------------------------------------------------
+
+def test_create_dirs_with_bare_file_name(tmp_path, monkeypatch):
+    monkeypatch.chdir(tmp_path)
+    JSONStorage('db.json', create_dirs=True).close()
+    assert os.path.exists(tmp_path / 'db.json')
+
+
+def test_json_storage_binary_mode(tmp_path):
+    path = tmp_path / 'db.json'
+    path.touch()
+
+    with TinyDB(path, access_mode='rb+') as db:
+        db.insert({'a': 'ä'})
+        assert db.all() == [{'a': 'ä'}]
+
+    with TinyDB(path) as db:
+        assert db.all() == [{'a': 'ä'}]
+
+
+def test_middleware_getattr_before_init():
+    mw = CachingMiddleware(MemoryStorage)
+    assert not hasattr(mw, 'does_not_exist')
+
+    # A middleware without a ``storage`` attribute (e.g. a subclass not
+    # calling the parent constructor, or during copying/unpickling)
+    bare = Middleware.__new__(Middleware)
+    assert not hasattr(bare, 'memory')
+    copy.copy(mw)
+
+
+# --- LRUCache --------------------------------------------------------------
+
+def test_lru_cache_none_values():
+    cache = LRUCache(capacity=2)
+    cache['a'] = None
+    assert cache['a'] is None
+    assert cache.get('a', 'default') is None
+    assert cache.get('b', 'default') == 'default'
+
+    cache['b'] = 1
+    cache.get('a')  # 'a' becomes most recently used
+    cache['c'] = 2
+    assert 'a' in cache
+    assert 'b' not in cache
