+def test_optional_list_is_hashable():
+    """
+    optional() with a list of validators produces a hashable validator, so
+    that Attributes using it remain hashable (e.g. for filters).
+    """
+    val = optional([instance_of(int), instance_of(object)])
+
+    hash(val)
+
+    @attr.s
+    class C:
+        a = attr.ib(default=None, validator=val)
+
+    assert {} == attr.asdict(C(), filter=attr.filters.exclude(attr.fields(C).a))
+    with pytest.raises(TypeError):
+        C("1")
