+def test_truncate_strings_keeps_literal_valid(s):
+    formatted = sqlparse.format(s, truncate_strings=3)
+    # The result must still lex as "select" + one complete string literal.
+    tokens = [tt for tt, _ in sqlparse.lexer.tokenize(formatted)]
+    assert tokens[-1] is T.String.Single
+    assert tokens.count(T.String.Single) == 1
+    assert formatted.endswith("[...]'")
