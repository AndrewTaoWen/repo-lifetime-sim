+def _safe_fn_name(name: str) -> str:
+    """Turn `name` into a valid Python identifier, for use in generated code.
+
+    Class names (from `attrs.make_class`, `dataclasses.make_dataclass` or
+    `type()`) are not required to be valid identifiers.
+    """
+    if name.isidentifier():
+        return name
+    name = re.sub(r"\W", "_", name)
+    return name if name.isidentifier() else "cattrs_generated_fn"
