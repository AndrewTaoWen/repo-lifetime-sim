+def _cookie_app(header):
+    def app(environ, start_response):
+        start_response("200 OK", [("Set-Cookie", header)])
+        return [b""]
+
+    return app
+
+
+def test_client_cookie_leading_dot_domain():
+    c = Client(_cookie_app("a=b; Domain=.Example.com"))
+    c.get("/", base_url="http://www.example.com")
+    assert c.get_cookie("a", domain="example.com").value == "b"
+    env = {}
+
+    def app(environ, start_response):
+        env.update(environ)
+        start_response("200 OK", [])
+        return [b""]
+
+    c.application = app
+    c.get("/", base_url="http://sub.example.com")
+    assert env["HTTP_COOKIE"] == "a=b"
+
