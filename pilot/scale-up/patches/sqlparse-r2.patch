+def _flatten(stmt):
+    """Return the leaf tokens of *stmt* ready to be wrapped in a string.
+
+    Group tokens cache their value at creation time, so after statement
+    filters (reindent, strip_comments, ...) modified their children the
+    cached value is stale. Work on the leaves instead. Line breaks that
+    terminate single line comments are split off into separate whitespace
+    tokens, leading whitespace and trailing whitespace containing line
+    breaks are dropped.
+    """
+    tokens = []
