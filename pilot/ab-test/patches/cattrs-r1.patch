@@ -0,0 +1,308 @@
+"""Regression tests for assorted latent bugs."""
+
+from collections import Counter
+from dataclasses import dataclass, field
+from enum import Enum
+from typing import Annotated, Literal, Tuple, TypedDict, Union
+
+import attrs
+import pytest
+
+from cattrs import BaseConverter, Converter, transform_error
+from cattrs.errors import ForbiddenExtraKeysError, IterableValidationError
+from cattrs.gen import make_dict_structure_fn, make_dict_unstructure_fn, override
+from cattrs.strategies import configure_tagged_union
+from cattrs.subclasses import subclasses
+from cattrs.v import format_exception
+
+from ._hardening_pep563 import NT, DataclassAnnotated, Inner, SubNT, TypedEnum
+
+
+@pytest.mark.parametrize("converter_cls", [BaseConverter, Converter])
+def test_hook_factory_decorators_return_factory(converter_cls):
+    """Hook factory decorators return the decorated factory, not None."""
+    c = converter_cls()
+
+    @c.register_structure_hook_factory(lambda t: t is complex)
+    def struct_factory(_):
+        return lambda v, _: complex(v)
+
+    @c.register_unstructure_hook_factory(lambda t: t is complex)
+    def unstruct_factory(_):
+        return str
+
+    assert callable(struct_factory)
+    assert callable(unstruct_factory)
+    assert c.structure("1+2j", complex) == 1 + 2j
+    assert c.unstructure(1 + 2j) == "(1+2j)"
+
+
+@pytest.mark.parametrize("converter_cls", [BaseConverter, Converter])
+def test_copy_keeps_fallbacks_and_union_hooks(converter_cls):
+    """`copy()` keeps fallback factories and union structure hooks."""
+
+    class Unknown:
+        pass
+
+    c = converter_cls(
+        structure_fallback_factory=lambda _: lambda v, _: ("fb", v),
+        unstructure_fallback_factory=lambda _: lambda v: "ufb",
+    )
+    c.register_structure_hook(Union[int, str], lambda v, _: ("u", v))
+    copy = c.copy()
+
+    assert copy.structure(1, Unknown) == ("fb", 1)
+    assert copy.unstructure(Unknown()) == "ufb"
+    assert copy.structure(1, Union[int, str]) == ("u", 1)
+
+
+def test_hetero_tuple_too_many_message():
+    """Too many values are reported as such, even if an element fails."""
+    c = Converter()
+    with pytest.raises(IterableValidationError) as exc_info:
+        c.structure(["a", 1, 2], Tuple[int, int])
+    assert "Too many values" in str(exc_info.value.exceptions[-1])
+
+
+@pytest.mark.parametrize("detailed_validation", [True, False])
+@pytest.mark.parametrize("key", ["it's", "back\\slash", 'q"q', "a\\nb"])
+def test_rename_special_characters(detailed_validation, key):
+    """Renamed keys with quotes and backslashes are handled in generated code."""
+
+    @attrs.define
+    class A:
+        x: int
+        y: int = 0
+
+    c = Converter(detailed_validation=detailed_validation)
+    c.register_structure_hook(
+        A, make_dict_structure_fn(A, c, x=override(rename=key), y=override(rename=key + "y"))
+    )
+    c.register_unstructure_hook(
+        A, make_dict_unstructure_fn(A, c, x=override(rename=key), y=override(rename=key + "y"))
+    )
+    assert c.unstructure(A(1, 2)) == {key: 1, key + "y": 2}
+    assert c.structure({key: "1", key + "y": "2"}, A) == A(1, 2)
+
+
+@pytest.mark.parametrize("detailed_validation", [True, False])
+def test_typeddict_special_keys(detailed_validation):
+    """TypedDicts with arbitrary string keys and names work."""
+    TD = TypedDict("my-td", {"it's": int, "a-b": int, 'q"': int})
+    c = Converter(detailed_validation=detailed_validation)
+    data = {"it's": 1, "a-b": 2, 'q"': 3}
+    assert c.unstructure(data, TD) == data
+    assert c.structure({"it's": "1", "a-b": 2, 'q"': 3}, TD) == data
+
+
+def test_class_name_not_identifier():
+    """Classes with names that aren't identifiers can be un/structured."""
+    A = attrs.make_class("my-class", {"x": attrs.field(type=int)})
+    c = Converter()
+    assert c.unstructure(A(1)) == {"x": 1}
+    assert c.structure({"x": "1"}, A) == A(1)
+
+
+class E(Enum):
+    A = "a"
+
+
+def test_counter_unstructures_keys():
+    """Counter keys are unstructured."""
+    c = Converter()
+    assert c.unstructure(Counter({E.A: 2}), Counter[E]) == {"a": 2}
+
+
+def test_msgspec_counter_unstructures_keys():
+    msgspec = pytest.importorskip("cattrs.preconf.msgspec")
+    class Key:
+        def __init__(self, v):
+            self.v = v
+
+    c = msgspec.make_converter()
+    c.register_unstructure_hook(Key, lambda k: f"k{k.v}")
+    assert c.unstructure(Counter({Key(1): 2}), Counter[Key]) == {"k1": 2}
+
+
+def test_namedtuple_stringified_annotations():
+    """NamedTuples with PEP 563 annotations, and their subclasses, work."""
+    c = Converter()
+    for cl in (NT, SubNT):
+        assert c.unstructure(cl(1, Inner(2))) == (1, {"a": 2})
+        assert c.structure(["1", {"a": "2"}], cl) == cl(1, Inner(2))
+
+
+def test_dataclass_stringified_annotated_override():
+    """`Annotated` overrides work on dataclasses with PEP 563 annotations."""
+    c = Converter()
+    assert c.unstructure(DataclassAnnotated(1)) == {"A": 1}
+    assert c.structure({"A": 1}, DataclassAnnotated) == DataclassAnnotated(1)
+
+
+def test_typed_enum_stringified_annotations():
+    """Typed enums with PEP 563 annotations can be structured."""
+    c = Converter()
+    assert c.structure("1", TypedEnum) is TypedEnum.A
+    assert c.unstructure(TypedEnum.A) == 1
+
+
+class K(Enum):
+    A = "a"
+    B = "b"
+
+
+@attrs.define
+class EnumLitA:
+    kind: Literal[K.A]
+
+
+@attrs.define
+class EnumLitB:
+    kind: Literal[K.B]
+
+
+def test_disambiguate_enum_literals():
+    """Unions disambiguated by enum literals accept unstructured values."""
+    c = Converter()
+    u = Union[EnumLitA, EnumLitB]
+    assert c.structure({"kind": "b"}, u) == EnumLitB(K.B)
+    assert c.structure(c.unstructure(EnumLitA(K.A)), u) == EnumLitA(K.A)
+
+
+@dataclass
+class WithFactory:
+    a: int
+    tags: list = field(default_factory=list)
+
+
+@dataclass
+class Other:
+    b: int
+
+
+def test_disambiguate_dataclass_default_factory():
+    """Fields with `default_factory` aren't used as required unique fields."""
+    c = Converter()
+    from cattrs.disambiguators import create_default_dis_func
+
+    fn = create_default_dis_func(c, WithFactory, Other)
+    for _ in range(5):
+        assert fn({"a": 1}) is WithFactory
+        assert fn({"b": 1}) is Other
+
+
+def test_tagged_union_default_does_not_grow():
+    """Unknown tags don't accumulate in the tagged union's mapping."""
+
+    @attrs.define
+    class A:
+        a: int = 0
+
+    @attrs.define
+    class B:
+        b: int = 0
+
+    c = Converter()
+    configure_tagged_union(Union[A, B], c, default=A)
+    hook = c.get_structure_hook(Union[A, B])
+    for i in range(100):
+        assert c.structure({"_type": f"x{i}", "a": 1}, Union[A, B]) == A(1)
+    assert len(hook.__defaults__[0]) == 2
+    assert c.structure({"_type": "B", "b": 2}, Union[A, B]) == B(2)
+
+
+def test_orjson_bare_enum_keys_roundtrip():
+    orjson = pytest.importorskip("cattrs.preconf.orjson")
+    c = orjson.make_converter()
+    raw = c.dumps({E.A: 1}, dict[E, int])
+    assert raw == b'{"a":1}'
+    assert c.loads(raw, dict[E, int]) == {E.A: 1}
+
+
+class Money:
+    def __init__(self, cents):
+        self.cents = cents
+
+
+@dataclass
+class DataclassWithMoney:
+    m: Money
+
+
+@attrs.define
+class Customized:
+    x: int = 0
+    y: int = attrs.field(default=1, alias="why")
+    z: Annotated[int, override(rename="zz")] = 2
+    w: int = attrs.field(init=False, default=3)
+
+
+def test_msgspec_respects_customizations():
+    """The msgspec converter doesn't pass through customized classes."""
+    msgspec = pytest.importorskip("cattrs.preconf.msgspec")
+
+    c = msgspec.make_converter()
+    c.register_unstructure_hook(Money, lambda m: f"{m.cents}c")
+    assert c.unstructure(DataclassWithMoney(Money(5))) == {"m": "5c"}
+
+    assert msgspec.make_converter(omit_if_default=True).unstructure(Customized()) == {}
+    assert msgspec.make_converter(use_alias=True).unstructure(Customized()) == {
+        "x": 0,
+        "why": 1,
+        "zz": 2,
+    }
+    assert msgspec.make_converter().unstructure(Customized()) == {
+        "x": 0,
+        "y": 1,
+        "zz": 2,
+    }
+
+
+def test_error_formatting_robustness():
+    """Error formatting doesn't crash on unusual exceptions."""
+
+    @attrs.define
+    class A:
+        a: int
+
+    c = Converter(forbid_extra_keys=True)
+    with pytest.raises(Exception) as exc_info:
+        c.structure({"a": 1, 2: 3}, A)
+    assert transform_error(exc_info.value) == ["extra fields found (2) @ $"]
+    assert str(ForbiddenExtraKeysError(None, A, {2, "b"})) == (
+        "Extra fields in constructor for A: 2, b"
+    )
+
+    assert format_exception(TypeError(), None) == "invalid type ()"
+    assert format_exception(TypeError(3), None) == "invalid type (3)"
+    assert format_exception(AttributeError(), None) == "unknown error ()"
+
+
+def test_subclasses_filtering():
+    """Only stale slotted originals are filtered from subclasses."""
+
+    @dataclass(slots=True)
+    class SlottedParent:
+        a: int
+
+    @dataclass(slots=True)
+    class SlottedChild(SlottedParent):
+        b: int
+
+    @dataclass
+    class NonSlottedChild(SlottedParent):
+        c: int
+
+    class PlainChild(SlottedParent):
+        pass
+
+    @attrs.define
+    class AttrsParent:
+        a: int
+
+    @attrs.define
+    class AttrsChild(AttrsParent):
+        b: int
+
+    assert subclasses(SlottedParent) == [SlottedChild, NonSlottedChild, PlainChild]
+    assert subclasses(AttrsParent) == [AttrsChild]
