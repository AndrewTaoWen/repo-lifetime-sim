+"""Helper classes using stringified (PEP 563) annotations, for regression tests."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from enum import Enum
+from typing import Annotated, NamedTuple
+
+import attrs
+
+from cattrs.gen import override
+
+
+@attrs.define
+class Inner:
+    a: int
+
+
+class NT(NamedTuple):
+    x: int
+    y: Inner
+
+
+class SubNT(NT):
+    pass
+
+
+@dataclass
+class DataclassAnnotated:
+    a: Annotated[int, override(rename="A")]
+
+
+class TypedEnum(Enum):
+    _value_: int
+    A = 1
