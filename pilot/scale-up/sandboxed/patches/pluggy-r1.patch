diff --git a/testing/test_hardening.py b/testing/test_hardening.py
new file mode 100644
index 0000000..12baa7a
--- /dev/null
+++ b/testing/test_hardening.py
@@ -0,0 +1,242 @@
+"""Regression tests for robustness fixes."""
+
+import importlib.metadata
+from typing import Any
+
+import pytest
+
+from pluggy import HookimplMarker
+from pluggy import HookspecMarker
+from pluggy import PluginManager
+from pluggy import PluginValidationError
+from pluggy._manager import _formatdef
+
+
+hookspec = HookspecMarker("example")
+hookimpl = HookimplMarker("example")
+
+
+class Spec:
+    @hookspec
+    def h(self, a):
+        pass
+
+    @hookspec(historic=True)
+    def hist(self, a):
+        pass
+
+
+@pytest.fixture
+def spm() -> PluginManager:
+    pm = PluginManager("example")
+    pm.add_hookspecs(Spec)
+    return pm
+
+
+def test_failed_register_leaves_no_state(spm: PluginManager) -> None:
+    class Bad:
+        @hookimpl
+        def h(self, a):
+            return 1
+
+        @hookimpl
+        def hist(self, a, unknown):
+            pass  # pragma: no cover
+
+    bad = Bad()
+    with pytest.raises(PluginValidationError):
+        spm.register(bad, name="bad")
+    assert not spm.is_registered(bad)
+    assert spm.get_plugin("bad") is None
+    assert spm.hook.h(a=1) == []
+
+    # A fixed plugin can now be registered under the same name.
+    class Good:
+        @hookimpl
+        def h(self, a):
+            return 2
+
+    spm.register(Good(), name="bad")
+    assert spm.hook.h(a=1) == [2]
+
+
+class Falsy:
+    def __len__(self) -> int:
+        return 0
+
+    @hookimpl
+    def h(self, a):
+        return 3
+
+
+def test_unregister_falsy_plugin(spm: PluginManager) -> None:
+    f = Falsy()
+    spm.register(f, name="f")
+    assert spm.hook.h(a=1) == [3]
+    assert spm.unregister(f) is f
+    assert not spm.is_registered(f)
+    assert spm.get_plugin("f") is None
+    spm.register(f, name="f")
+    assert spm.hook.h(a=1) == [3]
+    spm.set_blocked("f")
+    assert spm.is_blocked("f")
+    assert spm.hook.h(a=1) == []
+
+
+def test_load_setuptools_falsy_plugin_not_reloaded(
+    monkeypatch: pytest.MonkeyPatch, spm: PluginManager
+) -> None:
+    class EntryPoint:
+        name = "falsy"
+        group = "hello"
+
+        def load(self):
+            return Falsy()
+
+    class Distribution:
+        entry_points = (EntryPoint(),)
+
+    monkeypatch.setattr(importlib.metadata, "distributions", lambda: (Distribution(),))
+    assert spm.load_setuptools_entrypoints("hello") == 1
+    assert spm.load_setuptools_entrypoints("hello") == 0
+
+
+def test_subset_hook_caller_specname(spm: PluginManager) -> None:
+    class A:
+        @hookimpl(specname="h")
+        def other_name(self, a):
+            return "A"
+
+    class B:
+        @hookimpl
+        def h(self, a):
+            return "B"
+
+    a = A()
+    spm.register(a)
+    spm.register(B())
+    assert sorted(spm.hook.h(a=1)) == ["A", "B"]
+    assert spm.subset_hook_caller("h", [a])(a=1) == ["B"]
+
+
+def test_subset_hook_caller_unhashable_plugin(spm: PluginManager) -> None:
+    class Unhashable:
+        __hash__ = None  # type: ignore[assignment]
+
+        @hookimpl
+        def h(self, a):
+            return "U"
+
+    u = Unhashable()
+    spm.register(u)
+    assert spm.hook.h(a=1) == ["U"]
+    assert spm.subset_hook_caller("h", [u])(a=1) == []
+
+
+def test_hookcall_monitoring_undo_out_of_order(spm: PluginManager) -> None:
+    out: list[str] = []
+    undo1 = spm.add_hookcall_monitoring(
+        lambda *args: out.append("before1"), lambda *args: out.append("after1")
+    )
+    undo2 = spm.add_hookcall_monitoring(
+        lambda *args: out.append("before2"), lambda *args: out.append("after2")
+    )
+    undo1()
+    spm.hook.h(a=1)
+    assert out == ["before2", "after2"]
+    out.clear()
+    undo2()
+    spm.hook.h(a=1)
+    assert out == []
+
+
+def test_wrapper_second_yield_still_runs_outer_teardown(spm: PluginManager) -> None:
+    log: list[str] = []
+
+    class Outer:
+        @hookimpl(wrapper=True, tryfirst=True)
+        def h(self, a):
+            try:
+                return (yield)
+            finally:
+                log.append("outer-teardown")
+
+    class Inner:
+        @hookimpl(wrapper=True)
+        def h(self, a):
+            yield
+            yield  # pragma: no cover
+
+    spm.register(Outer())
+    spm.register(Inner())
+    with pytest.raises(RuntimeError, match="has second yield") as excinfo:
+        spm.hook.h(a=1)
+    # Checked while the traceback (keeping the call frames alive) is held,
+    # so the teardown must have run eagerly, not on garbage collection.
+    assert log == ["outer-teardown"]
+    del excinfo
+
+
+def test_call_historic_kwargs_copied(spm: PluginManager) -> None:
+    kwargs = {"a": 1}
+    spm.hook.hist.call_historic(kwargs=kwargs)
+    kwargs["a"] = 2
+    seen: list[Any] = []
+
+    class P:
+        @hookimpl
+        def hist(self, a):
+            seen.append(a)
+
+    spm.register(P())
+    assert seen == [1]
+
+
+def test_register_with_raising_property(spm: PluginManager) -> None:
+    class P:
+        @property
+        def broken(self):
+            raise RuntimeError("not ready")
+
+        @hookimpl
+        def h(self, a):
+            return 5
+
+    spm.register(P())
+    assert spm.hook.h(a=1) == [5]
+
+
+def test_tracing_indent_balanced_on_error(spm: PluginManager) -> None:
+    class BadRepr:
+        def __repr__(self) -> str:
+            raise ValueError("bad repr")
+
+    class P:
+        @hookimpl
+        def h(self, a):
+            return BadRepr()
+
+    spm.register(P())
+    out: list[str] = []
+    spm.trace.root.setwriter(out.append)
+    undo = spm.enable_tracing()
+    with pytest.raises(ValueError):
+        spm.hook.h(a=1)
+    assert spm.trace.root.indent == 0
+    with pytest.raises(ValueError):
+        spm.hook.h(a=BadRepr())
+    assert spm.trace.root.indent == 0
+    undo()
+
+
+def test_formatdef_signature_failure(monkeypatch: pytest.MonkeyPatch) -> None:
+    import inspect
+
+    def func(x):
+        pass  # pragma: no cover
+
+    def raising_signature(*args, **kwargs):
+        raise NameError("NonExistentType")
+
+    monkeypatch.setattr(inspect, "signature", raising_signature)
+    assert _formatdef(func) == "func(...)"
