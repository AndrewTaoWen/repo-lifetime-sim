+@pytest.mark.parametrize("op", [copy.copy, copy.deepcopy, lambda o: pickle.loads(pickle.dumps(o))])
+def test_www_authenticate_copy_pickle(op):
+    w = WWWAuthenticate("digest", {"realm": "r"})
+    calls = []
+    w._on_update = calls.append
+    c = op(w)
+    assert c == w
+    assert c.realm == "r"
+    # The copy is independent of the original.
+    c.realm = "other"
+    assert w.realm == "r"
+    assert not calls
