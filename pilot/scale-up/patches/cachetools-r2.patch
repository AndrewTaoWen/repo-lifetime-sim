+    def test_lfu_pickle_copy(self):
+        def make():
+            cache = LFUCache(maxsize=5000)
+            # many distinct use counts used to cause RecursionError
+            for i in range(2000):
+                cache[i] = i
+                for _ in range(i % 1500):
+                    cache[i]
+            return cache
+
+        for clone in (
+            pickle.loads(pickle.dumps(make())),
+            pickle.loads(pickle.dumps(make(), 1)),
+            copy.deepcopy(make()),
+        ):
+            cache = make()
+            self.assertEqual(set(cache), set(clone))
+            self.assertEqual(cache.currsize, clone.currsize)
+            # eviction order is preserved
+            clone[1] = cache[1] = 1
+            clone[-1] = cache[-1] = -1
+            for _ in range(len(cache)):
+                ck, cv = cache.popitem()
+                kk, kv = clone.popitem()
+                self.assertEqual(ck, cv)
+                self.assertEqual(kk, kv)
+                self.assertEqual(ck % 1500 if ck >= 0 else -1, kk % 1500 if kk >= 0 else -1)
+            self.assertEqual(0, len(clone))
