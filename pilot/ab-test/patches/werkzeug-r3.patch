+@pytest.mark.parametrize("op", [copy.copy, copy.deepcopy, lambda o: pickle.loads(pickle.dumps(o))])
+def test_authorization_copy_pickle(op):
+    a = Authorization("basic", {"username": "u", "password": "p"})
+    b = op(a)
+    assert b == a
+    assert b.username == "u"
+    t = Authorization("bearer", token="abc")
