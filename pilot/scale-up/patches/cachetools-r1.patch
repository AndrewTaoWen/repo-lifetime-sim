+        self.assertEqual(2, len(cache))
+        self.assertEqual(10, cache.currsize)
+
+        cache[2] = 8
+        self.assertEqual(1, len(cache))
+        self.assertEqual(8, cache[2])
+        self.assertEqual(8, cache.currsize)
+
+    def test_copy(self):
+        import copy
+
+        values = [[i] for i in range(4)]
+        source = self.Cache(maxsize=3)
+        source.update({i: values[i] for i in range(3)})
+        cache = copy.copy(source)
+        self.assertEqual(source, cache)
+        # shallow copy: values are shared
+        self.assertIs(values[0], cache[0])
+
+        # modifying the copy must not affect the source, and vice versa
+        cache[3] = values[3]
