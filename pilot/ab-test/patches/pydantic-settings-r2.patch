diff --git a/tests/test_regressions.py b/tests/test_regressions.py
new file mode 100644
index 0000000..3f68408
--- /dev/null
+++ b/tests/test_regressions.py
@@ -0,0 +1,193 @@
+"""Regression tests for latent bugs found while hardening the library."""
+
+import asyncio
+import os
+import sys
+from pathlib import Path
+from typing import Annotated, Any, Optional, Union
+
+import pytest
+from pydantic import BaseModel
+
+from pydantic_settings import (
+    BaseSettings,
+    CliApp,
+    EnvSettingsSource,
+    NoDecode,
+    SecretsSettingsSource,
+    SettingsConfigDict,
+)
+from pydantic_settings.sources import NestedSecretsSettingsSource
+from pydantic_settings.sources.utils import _get_field_metadata
+
+try:
+    import yaml
+except ImportError:
+    yaml = None
+
+
+@pytest.mark.skipif(sys.version_info < (3, 12), reason='requires PEP 695 type aliases')
+def test_get_field_metadata_does_not_mutate_field(env):
+    ns: dict[str, Any] = {'Annotated': Annotated, 'NoDecode': NoDecode}
+    exec('type L = Annotated[list[int], NoDecode]', ns)
+
+    class Settings(BaseSettings):
+        x: ns['L'] = []  # type: ignore[valid-type]
+
+    field = Settings.model_fields['x']
+    original = list(field.metadata)
+    env.set('X', '1')
+    for _ in range(3):
+        try:
+            Settings()
+        except Exception:
+            pass
+        assert NoDecode in _get_field_metadata(field)
+    assert field.metadata == original
+
+
+def test_non_string_values_are_not_json_decoded():
+    """Sources backed by JSON documents (e.g. AWS Secrets Manager) can yield already-decoded values."""
+
+    class Sub(BaseModel):
+        a: int
+
+    class Nested(BaseModel):
+        b: dict[str, int]
+
+    class Src(EnvSettingsSource):
+        def _load_env_vars(self):
+            return {'sub': {'a': 1}, 'port': 5432, 'tags': ['x'], 'nested__b': {'c': 2}}
+
+    class Settings(BaseSettings):
+        sub: Sub
+        port: int
+        tags: list[str] = []
+        nested: Optional[Nested] = None
+
+        @classmethod
+        def settings_customise_sources(cls, settings_cls, **kwargs):
+            return (Src(settings_cls, env_nested_delimiter='__'),)
+
+    s = Settings()
+    assert s.sub.a == 1
+    assert s.port == 5432
+    assert s.tags == ['x']
+    assert s.nested == Nested(b={'c': 2})
+
+
+def test_case_insensitive_nested_optional_models(env):
+    class Deep(BaseModel):
+        VaL: int
+
+    class Sub(BaseModel):
+        Inner: Optional[Deep] = None
+        Name: str = 'x'
+
+    class Settings(BaseSettings):
+        model_config = SettingsConfigDict(env_nested_delimiter='__')
+        a: Union[None, Sub] = None
+        b: Optional[Sub] = None
+
+    env.set('A__NAME', 'n')
+    env.set('B__INNER__VAL', '3')
+    env.set('B__NAME', 'm')
+    s = Settings()
+    assert s.a == Sub(Name='n')
+    assert s.b == Sub(Inner=Deep(VaL=3), Name='m')
+
+
+def test_dotenv_extra_strips_uppercase_prefix_case_insensitive(tmp_path):
+    p = tmp_path / '.env'
+    p.write_text('APP_FOO=1\nAPP_BAR=2\n')
+
+    class Settings(BaseSettings):
+        model_config = SettingsConfigDict(env_prefix='APP_', env_file=p, extra='allow')
+        foo: int
+
+    assert Settings().model_dump() == {'foo': 1, 'bar': '2'}
+
+
+def test_cli_dict_json_with_escaped_backslash_before_quote():
+    class Settings(BaseSettings):
+        model_config = SettingsConfigDict(cli_exit_on_error=False)
+        dd: dict[str, str] = {}
+        ll: list[str] = []
+
+    assert CliApp.run(Settings, cli_args=['--dd', '{"a":"b\\\\"}']).dd == {'a': 'b\\'}
+
+
+def test_cli_async_cmd_system_exit_propagates_with_running_loop():
+    class Command(BaseSettings):
+        async def cli_cmd(self) -> None:
+            raise SystemExit(3)
+
+    async def run_as_coro():
+        return CliApp.run(Command, cli_args=[])
+
+    with pytest.raises(SystemExit) as exc_info:
+        asyncio.run(run_as_coro())
+    assert exc_info.value.code == 3
+
+
+def test_secrets_exact_case_match_preferred(tmp_path):
+    (tmp_path / 'FOO').write_text('upper')
+    (tmp_path / 'foo').write_text('lower')
+    if len(list(tmp_path.iterdir())) != 2:
+        pytest.skip('case-insensitive filesystem')
+
+    assert SecretsSettingsSource.find_case_path(tmp_path, 'foo', False).name == 'foo'
+    assert SecretsSettingsSource.find_case_path(tmp_path, 'FOO', False).name == 'FOO'
+    assert SecretsSettingsSource.find_case_path(tmp_path, 'Foo', False) is not None
+    assert SecretsSettingsSource.find_case_path(tmp_path, 'Foo', True) is None
+
+
+def test_nested_secrets_dir_with_glob_metacharacters(tmp_path):
+    secrets = tmp_path / 'secrets[prod]'
+    secrets.mkdir()
+    (secrets / 'password').write_text('s3cr3t')
+
+    class Settings(BaseSettings):
+        model_config = SettingsConfigDict(secrets_dir=secrets)
+        password: str
+
+        @classmethod
+        def settings_customise_sources(cls, settings_cls, file_secret_settings, **kwargs):
+            return (NestedSecretsSettingsSource(file_secret_settings),)
+
+    assert Settings().password == 's3cr3t'
+
+
+def test_nested_secrets_dir_accepts_generic_pathlike(tmp_path):
+    (tmp_path / 'password').write_text('s3cr3t')
+
+    class MyPath(os.PathLike):
+        def __fspath__(self) -> str:
+            return str(tmp_path)
+
+    class Settings(BaseSettings):
+        password: str
+
+        @classmethod
+        def settings_customise_sources(cls, settings_cls, **kwargs):
+            return (NestedSecretsSettingsSource(settings_cls, secrets_dir=MyPath()),)
+
+    assert Settings().password == 's3cr3t'
+
+
+@pytest.mark.skipif(yaml is None, reason='PyYAML is not installed')
+def test_yaml_empty_config_section(tmp_path: Path):
+    from pydantic_settings import YamlConfigSettingsSource
+
+    p = tmp_path / 'c.yaml'
+    p.write_text('app:\nother: 1\n')
+
+    class Settings(BaseSettings):
+        model_config = SettingsConfigDict(yaml_file=p, yaml_config_section='app')
+        x: int = 1
+
+        @classmethod
+        def settings_customise_sources(cls, settings_cls, init_settings, **kwargs):
+            return (init_settings, YamlConfigSettingsSource(settings_cls))
+
+    assert Settings().x == 1
