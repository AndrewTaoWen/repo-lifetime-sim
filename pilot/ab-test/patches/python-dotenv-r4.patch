+
+    result = cli.invoke(dotenv_cli, ["get", "a"])
+
+    assert (result.exit_code, result.output) == (0, "b\n")
diff --git a/tests/test_main.py b/tests/test_main.py
index 1c33c80..ddb94d9 100644
--- a/tests/test_main.py
+++ b/tests/test_main.py
@@ -708,3 +708,56 @@ def test_dotenv_values_file_stream(dotenv_path):
         result = dotenv.dotenv_values(stream=f)
 
     assert result == {"a": "b"}
+
+
+@pytest.mark.parametrize(
+    "value",
+    ["a\\", "\\", "a\\\\b", "x\\'y", "C:\\path\\", "\\\\"],
+)
+def test_set_key_backslash_round_trip(dotenv_path, value):
+    dotenv.set_key(dotenv_path, "a", value)
+    dotenv.set_key(dotenv_path, "b", "c")
+
+    assert dotenv.dotenv_values(dotenv_path, interpolate=False) == {
+        "a": value,
+        "b": "c",
+    }
+
+
+def test_set_key_plain_backslash_not_escaped(dotenv_path):
+    dotenv.set_key(dotenv_path, "a", "C:\\path")
+
+    assert dotenv_path.read_text() == "a='C:\\path'\n"
+
+
+def test_dotenv_values_large_file_interpolation_is_linear():
+    import time
+
+    def timed(n):
+        content = "K0=v\n" + "".join(f"K{i}=${{K{i - 1}}}\n" for i in range(1, n))
+        start = time.perf_counter()
+        result = dotenv.dotenv_values(stream=io.StringIO(content))
+        assert len(result) == n
+        return time.perf_counter() - start
+
+    timed(500)
+    assert timed(20000) < 5
+
+
+def test_find_dotenv_without_file_backed_frames(tmp_path):
+    (tmp_path / ".env").write_text("")
+    code = "import dotenv\nresult = dotenv.find_dotenv()\n"
+    namespace = {}
+
+    def exists(path):
+        # Pretend no frame is backed by a real source file.
+        return not str(path).endswith(".py") and os.path.lexists(path)
+
+    with (
+        mock.patch("dotenv.main.os.getcwd", return_value=str(tmp_path)),
+        mock.patch("dotenv.main.os.path.exists", side_effect=exists),
+        mock.patch.object(sys, "gettrace", return_value=None),
+    ):
+        exec(compile(code, "<no-file>", "exec"), namespace)
+
+    assert namespace["result"] == str(tmp_path / ".env")
diff --git a/tests/test_parser.py b/tests/test_parser.py
index 4ec5a5a..1cd423e 100644
--- a/tests/test_parser.py
+++ b/tests/test_parser.py
@@ -580,3 +580,33 @@ def test_parse_stream(test_input, expected):
     result = parse_stream(io.StringIO(test_input))
 
     assert list(result) == expected
+
+
+@pytest.mark.parametrize(
+    "test_input,expected",
+    [
+        ('a="b\\\\" # c "d"\nx=1\n', [("a", "b\\"), ("x", "1")]),
+        ("a='b\\\\'\nx='y'\n", [("a", "b\\"), ("x", "y")]),
+        # Legacy lenient behaviour is preserved where the strict form fails.
+        ("a='C:\\'\n", [("a", "C:\\")]),
+        ('a="C:\\"\n', [("a", "C:\\")]),
+    ],
+)
+def test_parse_stream_escaped_backslash_before_closing_quote(test_input, expected):
+    result = [(b.key, b.value) for b in parse_stream(io.StringIO(test_input))]
+
+    assert result == expected
+
+
+def test_parse_stream_error_line_numbers_with_crlf():
+    content = 'a=1\r\nx="bad\r\nb=2\r\nc=3\r\n'
+
+    bindings = list(parse_stream(io.StringIO(content)))
+
+    assert [(b.key, b.original.line, b.error) for b in bindings] == [
+        ("a", 1, False),
+        (None, 2, True),
+        ("b", 3, False),
+        ("c", 4, False),
+    ]
+    assert "".join(b.original.string for b in bindings) == content
