index 0000000..ad21862
--- /dev/null
+++ b/tests/test_regressions.py
@@ -0,0 +1,340 @@
+"""Regression tests for bugs found while hardening the library."""
+
+from __future__ import annotations
+
+import copy
+import json
+import pickle
+import time as _time
+
+from datetime import datetime
+from datetime import timedelta
+from datetime import timezone
+
+import pytest
+
+import tomlkit
+
+from tomlkit.exceptions import ParseError
+from tomlkit.items import Date
+from tomlkit.items import Float
+from tomlkit.items import StringType
+from tomlkit.items import Time
+
+
+def roundtrip(doc: tomlkit.TOMLDocument) -> tomlkit.TOMLDocument:
+    reparsed = tomlkit.parse(doc.as_string())
+    assert reparsed.unwrap() == doc.unwrap()
+    return reparsed
+
+
+# Numbers
+
+
+def test_round_float_without_ndigits_returns_int() -> None:
+    doc = tomlkit.parse("f = 1.5\ng = 2.567")
+    r = round(doc["f"])
+    assert r == 2
+    assert isinstance(r, int)
+    assert round(doc["g"], 1) == 2.6
+
+
+def test_integer_negative_power_returns_float() -> None:
+    doc = tomlkit.parse("i = 2")
+    r = doc["i"] ** -1
+    assert r == 0.5
+    assert isinstance(r, float)
+    assert isinstance(r, Float)
+    assert 2 ** (-doc["i"]) == 0.25
+    assert doc["i"] ** 0.5 == pytest.approx(1.4142135623730951)
+    assert doc["i"] ** 3 == 8
+    assert pow(doc["i"], 3, 5) == 3
+
+
+def test_huge_integer_is_not_parsed_as_infinite_float() -> None:
+    with pytest.raises(ParseError):
+        tomlkit.parse("x = 1" + "0" * 5000)
+
+
+def test_surrogate_unicode_escape_is_rejected() -> None:
+    with pytest.raises(ParseError):
+        tomlkit.parse('x = "\\U0000D800"')
+    assert tomlkit.parse('x = "\\U0001F600"')["x"] == "\U0001f600"
+
+
+# Strings
+
+
+def test_escape_string_is_not_quadratic() -> None:
+    value = 'a"\\' * 200_000
+    start = _time.perf_counter()
+    s = tomlkit.string(value)
+    assert _time.perf_counter() - start < 5
+    assert s.as_string() == '"' + 'a\\"\\\\' * 200_000 + '"'
+    small = tomlkit.string(value[:3000])
+    assert tomlkit.parse(f"x = {small.as_string()}")["x"] == value[:3000]
+
+
+def test_string_concatenation_is_escaped() -> None:
+    doc = tomlkit.parse("b = \"q\"\nl = 'abc'\nm = '''x'''\nml = \"\"\"x\"\"\"")
+    doc["b"] = doc["b"] + '"\n\\'
+    doc["l"] = doc["l"] + "'x"
+    doc["m"] = doc["m"] + "'''"
+    doc["ml"] = doc["ml"] + '"""'
+    reparsed = roundtrip(doc)
+    assert reparsed["b"] == 'q"\n\\'
+    assert reparsed["l"] == "abc'x"
+    assert reparsed["m"] == "x'''"
+    assert reparsed["ml"] == 'x"""'
+
+
+def test_string_concatenation_keeps_type_when_possible() -> None:
+    s = tomlkit.string("abc", literal=True) + "def"
+    assert s.type == StringType.SLL
+    assert s.as_string() == "'abcdef'"
+    s = tomlkit.string("a") + tomlkit.string("\\", literal=True)
+    assert s.as_string() == '"a\\\\"'
+
+
+# Dates
+
+
+def test_date_and_time_built_directly_render() -> None:
+    assert Date(2020, 1, 2).as_string() == "2020-01-02"
+    assert Time(1, 2, 3, 0, None).as_string() == "01:02:03"
+    doc = tomlkit.document()
+    doc["d"] = Date(2020, 1, 2)
+    assert tomlkit.parse(doc.as_string())["d"] == Date(2020, 1, 2)
+
+
+def test_utc_datetime_offset_with_seconds_is_not_garbled() -> None:
+    dt = datetime(2020, 1, 1, tzinfo=timezone(timedelta(seconds=30)))
+    assert "Z" not in tomlkit.item(dt).as_string()
+    dt = datetime(2020, 1, 1, tzinfo=timezone.utc)
+    assert tomlkit.item(dt).as_string() == "2020-01-01T00:00:00Z"
+
+
+# Arrays
+
+
+@pytest.mark.parametrize(
+    "index",
+    [
+        slice(-2, None),
+        slice(0, 0),
+        slice(1, None),
+        slice(None, None, 2),
+        slice(None, None, -1),
+        slice(-10, 10),
+    ],
+)
+def test_array_delete_slice(index: slice) -> None:
+    doc = tomlkit.parse("a = [1, 2, 3, 4, 5]\n")
+    expected = [1, 2, 3, 4, 5]
+    del expected[index]
+    del doc["a"][index]
+    assert doc["a"] == expected
+    assert tomlkit.parse(doc.as_string())["a"] == expected
+
+
+def test_array_slice_assignment_does_not_corrupt_array() -> None:
+    doc = tomlkit.parse("a = [1, 2, 3]\n")
+    with pytest.raises(ValueError):
+        doc["a"][0:1] = [9]
+    assert doc["a"] == [1, 2, 3]
+    assert doc.as_string() == "a = [1, 2, 3]\n"
+
+
+def test_array_sort_keeps_rendering_in_sync() -> None:
+    doc = tomlkit.parse("a = [\n  3,\n  1, # one\n  2,\n]\n")
+    doc["a"].sort()
+    assert doc["a"] == [1, 2, 3]
+    assert tomlkit.parse(doc.as_string())["a"] == [1, 2, 3]
+    doc["a"].sort(reverse=True)
+    assert tomlkit.parse(doc.as_string())["a"] == [3, 2, 1]
+
+
+def test_array_append_is_not_quadratic() -> None:
+    a = tomlkit.array()
+    start = _time.perf_counter()
+    for i in range(20_000):
+        a.append(i)
+    assert _time.perf_counter() - start < 5
+    assert tomlkit.parse(f"a = {a.as_string()}")["a"] == list(range(20_000))
+
+
+# Arrays of tables
+
+
+def test_aot_setitem_keeps_list_in_sync() -> None:
+    doc = tomlkit.parse("[[a]]\nx = 1\n[[a]]\nx = 2\n")
+    doc["a"][0] = {"x": 9}
+    assert doc["a"] == [{"x": 9}, {"x": 2}]
+    assert json.loads(json.dumps(doc["a"])) == [{"x": 9}, {"x": 2}]
+    doc["a"].reverse()
+    assert doc["a"] == [{"x": 2}, {"x": 9}]
+    assert tomlkit.parse(doc.as_string())["a"] == [{"x": 2}, {"x": 9}]
+
+
+def test_aot_insert_separates_following_table() -> None:
+    doc = tomlkit.document()
+    doc["x"] = 1
+    doc["a"] = [{"b": 1}, {"b": 2}]
+    doc["a"].insert(0, {"b": 0})
+    assert doc["a"][1].trivia.indent.startswith("\n")
+    assert tomlkit.parse(doc.as_string())["a"] == [{"b": 0}, {"b": 1}, {"b": 2}]
+
+
+# Containers
+
+
+def test_copy_of_document_keeps_table_keys() -> None:
+    doc = tomlkit.parse("[a.b]\nx = 1\n[c]\ny = 2\n")
+    c = copy.copy(doc)
+    t = tomlkit.table(True)
+    t.append("d", {"z": 1})
+    c.append("a", t)
+    assert tomlkit.parse(c.as_string())["a"] == {"b": {"x": 1}, "d": {"z": 1}}
+
+
+def test_replace_table_with_value_does_not_move_it_into_other_table() -> None:
+    doc = tomlkit.parse("top = 0\n[a]\nx = 1\n[d]\ne = 1\n[b]\nz = 1\n")
+    doc["d"] = 5
+    reparsed = roundtrip(doc)
+    assert reparsed["d"] == 5
+    assert reparsed["a"] == {"x": 1}
+
+
+def test_replace_value_with_table_after_dotted_keys() -> None:
+    doc = tomlkit.parse("a = 1\nb.c = 2\n[t]\nx = 1\n")
+    doc["a"] = {"q": 1}
+    reparsed = roundtrip(doc)
+    assert reparsed["b"] == {"c": 2}
+    assert reparsed["a"] == {"q": 1}
+
+
+def test_replace_dotted_table() -> None:
+    doc = tomlkit.parse("a.b = 1\nc = {d = 1}\n")
+    doc["a"] = {"b": 2}
+    assert roundtrip(doc)["c"] == {"d": 1}
+
+    doc = tomlkit.parse("a.b = 1\na.c = 1\nc = {d = 1}\n")
+    doc["a"] = 5
+    assert roundtrip(doc)["a"] == 5
+
+
+def test_add_table_to_dotted_key_table() -> None:
+    doc = tomlkit.parse('tool.poetry.name = "x"\nother = 1\n')
+    doc["tool"]["black"] = {"line-length": 88, "sub": {"q": 1}, "empty": {}}
+    doc["tool"]["aot"] = [{"a": 1}, {"a": 2}]
+    reparsed = roundtrip(doc)
+    assert reparsed["other"] == 1
+    assert reparsed["tool"]["black"] == {"line-length": 88, "sub": {"q": 1}, "empty": {}}
+
+    doc = tomlkit.parse('[x]\ntool.poetry.name = "x"\nother = 1\n')
+    doc["x"]["tool"]["black"] = {"line-length": 88}
+    reparsed = roundtrip(doc)
+    assert reparsed["x"]["other"] == 1
+    assert "tool" not in reparsed
+
+
+def test_add_super_table_to_dotted_key_table() -> None:
+    doc = tomlkit.parse("a.b = 1\nc = {d = 1}\n")
+    doc["a"]["b"] = {"b": {"c": "s"}}
+    assert roundtrip(doc)["c"] == {"d": 1}
+
+
+def test_out_of_order_table_proxy_copy_and_pickle() -> None:
+    src = "[a]\nx = 1\n[b]\ny = 2\n[a.c]\nz = 3\n"
+    doc = tomlkit.parse(src)
+    proxy = doc["a"]
+    assert pickle.loads(pickle.dumps(proxy)) == {"x": 1, "c": {"z": 3}}
+    assert copy.copy(proxy) == {"x": 1, "c": {"z": 3}}
+    deep = copy.deepcopy(proxy)
+    deep["x"] = 9
+    assert doc.as_string() == src
+
+
+def test_appending_many_values_is_not_quadratic() -> None:
+    doc = tomlkit.document()
+    doc["t"] = {"a": 1}
+    start = _time.perf_counter()
+    for i in range(10_000):
+        doc[f"k{i}"] = i
+    assert _time.perf_counter() - start < 5
+    reparsed = tomlkit.parse(doc.as_string())
+    assert reparsed["k9999"] == 9999
+    assert reparsed["t"] == {"a": 1}
+
+
+# Inline tables
+
+
+def test_inline_table_with_dotted_key_appended() -> None:
+    it = tomlkit.inline_table()
+    it.append(tomlkit.key(["a", "b"]), 1)
+    it.append("z", 2)
+    it.append(tomlkit.key(["a", "c"]), 3)
+    assert list(it) == ["a", "z"]
+    assert tomlkit.parse(f"x = {it.as_string()}")["x"] == {
+        "a": {"b": 1, "c": 3},
+        "z": 2,
+    }
+
+
+def test_inline_table_dotted_key_subtable_mutation() -> None:
+    src = "t = {a.b = 1, c.d.e = 2}"
+    doc = tomlkit.parse(src)
+    assert doc.as_string() == src
+    doc["t"]["c"]["d"]["f"] = 3
+    doc["t"]["c"]["g"] = {"h": 1}
+    doc["t"]["a"]["x"] = [{"y": 1}]
+    assert tomlkit.parse(doc.as_string())["t"] == {
+        "a": {"b": 1, "x": [{"y": 1}]},
+        "c": {"d": {"e": 2, "f": 3}, "g": {"h": 1}},
+    }
+
+
+# dumps
+
+
+def test_dumps_sort_keys_on_tables_and_nested_tables() -> None:
+    doc = tomlkit.parse("b = 1\na = 2\n[t]\nz = 1\ny = 2\n[t.s]\nq = 1\np = 2\n")
+    assert tomlkit.dumps(doc["t"], sort_keys=True) == (
+        "y = 2\nz = 1\n\n[s]\np = 2\nq = 1\n"
+    )
+    out = tomlkit.dumps(doc, sort_keys=True)
+    assert out.index("y = 2") < out.index("z = 1")
+    assert out.index("p = 2") < out.index("q = 1")
+    assert tomlkit.parse(out) == doc
+    out = tomlkit.dumps({"b": doc["t"], "a": 1}, sort_keys=True)
+    assert out.startswith("a = 1\n")
+    assert out.index("y = 2") < out.index("z = 1")
+
+
+def test_inline_table_rendering_is_not_quadratic() -> None:
+    src = "x = {" + ",".join(f"k{i}=1" for i in range(20_000)) + "}"
+    doc = tomlkit.parse(src)
+    start = _time.perf_counter()
+    assert doc.as_string() == src
+    assert _time.perf_counter() - start < 5
+
+
+def test_parse_long_string() -> None:
+    raw = "ab\\\\" * 50_000  # TOML source: ab\\ repeated
+    value = "ab\\" * 50_000
+    doc = tomlkit.parse(f'x = "{raw}"\ny = """{raw}\n"""\nz = \'{raw}\'')
+    assert doc["x"] == value
+    assert doc["y"] == value + "\n"
+    assert doc["z"] == raw
+
+
+def test_inline_table_copy_and_pickle_keep_formatting() -> None:
+    it = tomlkit.inline_table()
+    it.update({"x": 1, "y": 2})
+    assert it.as_string() == "{x = 1, y = 2}"
+    assert pickle.loads(pickle.dumps(it)).as_string() == "{x = 1, y = 2}"
+    assert copy.deepcopy(it).as_string() == "{x = 1, y = 2}"
+    doc = tomlkit.document()
+    doc["t"] = it
+    assert copy.deepcopy(doc).as_string() == doc.as_string()
