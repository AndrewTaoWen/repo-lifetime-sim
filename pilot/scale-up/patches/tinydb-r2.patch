+
+# --- Regression tests -------------------------------------------------------
+
+def test_regex_flags_are_part_of_hash():
+    query = Query()
+    assert query.val.matches('a', flags=re.I) != query.val.matches('a')
+    assert query.val.search('a', flags=re.I) != query.val.search('a')
+    assert hash(query.val.matches('a', flags=re.I)) != \
+        hash(query.val.matches('a'))
+
+
+def test_regex_flags_query_cache():
+    from tinydb import TinyDB
+    from tinydb.storages import MemoryStorage
+    db = TinyDB(storage=MemoryStorage)
+    db.insert({'s': 'ABC'})
+    assert len(db.search(Query().s.matches('abc', flags=re.I))) == 1
+    assert len(db.search(Query().s.matches('abc'))) == 0
+    assert len(db.search(Query().s.search('b', flags=re.I))) == 1
+    assert len(db.search(Query().s.search('b'))) == 0
+
+
+def test_fragment_path_is_part_of_hash():
+    query = Query()
+    assert query.a.fragment({'x': 1}) != query.b.fragment({'x': 1})
+
+    from tinydb import TinyDB
+    from tinydb.storages import MemoryStorage
+    db = TinyDB(storage=MemoryStorage)
+    db.insert({'a': {'x': 1}, 'b': {'x': 2}})
+    assert len(db.search(query.a.fragment({'x': 1}))) == 1
+    assert len(db.search(query.b.fragment({'x': 1}))) == 0
+
+
+def test_fragment_non_mapping_value():
+    query = Query().a.fragment({'x': 1})
+    assert not query({'a': 5})
+    assert not query({'a': None})
+    assert not query({'a': [1]})
+
+
+def test_one_of_generator():
+    query = Query().val.one_of(x for x in [2, 3])
+    assert not query({'val': 1})
+    assert query({'val': 2})
+    assert query({'val': 3})
+
+
+def test_comparison_with_unhashable_rhs():
+    query = Query().val < [3]
+    assert query({'val': [1, 2]})
+    hash(query)
+    hash(Query().val.test(lambda v, x: True, [1, {'a': [1]}]))
+
+
+def test_any_all_with_non_cacheable_query():
+    query = Query()
+    assert not query.l.any(query.map(lambda x: x) == 1).is_cacheable()
+    assert not query.l.all(query.map(lambda x: x) == 1).is_cacheable()
+
+    from tinydb import TinyDB
+    from tinydb.storages import MemoryStorage
+    db = TinyDB(storage=MemoryStorage)
+    db.insert({'l': [1]})
+    assert len(db.search(query.l.any(query.map(lambda x: x) == 1))) == 1
+    assert len(db.search(query.l.any(query.map(lambda x: -x) == 1))) == 0
+
+
+def test_query_copy_and_dunder_fields():
+    import copy
+    query = Query()
+    assert copy.deepcopy(query.a == 1) == (query.a == 1)
+    copy.deepcopy(query)
+    assert not hasattr(query, '__array__')
