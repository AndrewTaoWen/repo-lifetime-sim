@@ -0,0 +1,278 @@
+"""
+Regression tests for bugs fixed during hardening.
+"""
+import copy
+import os
+import re
+
+import pytest
+
+from tinydb import TinyDB, Query, where
+from tinydb.middlewares import CachingMiddleware
+from tinydb.operations import delete, increment
+from tinydb.storages import MemoryStorage, JSONStorage
+from tinydb.table import Document, Table
+from tinydb.utils import LRUCache, FrozenDict
+
+
+@pytest.fixture
+def mdb():
+    return TinyDB(storage=MemoryStorage)
+
+
+# --- Table / TinyDB ---------------------------------------------------------
+
+def test_persist_empty_keeps_existing_documents(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    with TinyDB(path) as db:
+        db.table('users').insert({'name': 'John'})
+
+    with TinyDB(path) as db:
+        table = db.table('users', persist_empty=True)
+        assert table.all() == [{'name': 'John'}]
+
+    with TinyDB(path) as db:
+        db.table('new', persist_empty=True)
+        assert 'new' in db.tables()
+
+
+def test_default_query_cache_capacity_subclass(mdb):
+    class MyTable(Table):
+        default_query_cache_capacity = 50
+
+    table = MyTable(mdb.storage, 'x')
+    assert table._query_cache.capacity == 50
+
+    # Explicit values (including None = unlimited) still win
+    assert MyTable(mdb.storage, 'y', cache_size=None)._query_cache.capacity \
+        is None
+    assert MyTable(mdb.storage, 'z', cache_size=3)._query_cache.capacity == 3
+
+
+def test_remove_duplicate_doc_ids(mdb):
+    mdb.insert({'a': 1})
+    mdb.insert({'a': 2})
+    assert mdb.remove(doc_ids=[1, 1]) == [1]
+    assert mdb.all() == [{'a': 2}]
+
+
+def test_update_duplicate_doc_ids_applied_once(mdb):
+    mdb.insert({'x': 0})
+    assert mdb.update(increment('x'), doc_ids=[1, 1]) == [1]
+    assert mdb.get(doc_id=1) == {'x': 1}
+
+
+def test_update_multiple_with_generator(mdb):
+    mdb.insert({'a': 1})
+    mdb.insert({'a': 2})
+    updates = (({'b': n}, where('a') == n) for n in (1, 2))
+    assert mdb.update_multiple(updates) == [1, 2]
+    assert mdb.all() == [{'a': 1, 'b': 1}, {'a': 2, 'b': 2}]
+
+
+def test_update_multiple_reports_ids_once(mdb):
+    mdb.insert({'a': 1})
+    ids = mdb.update_multiple([
+        ({'b': 1}, where('a') == 1),
+        ({'c': 1}, where('a').exists()),
+    ])
+    assert ids == [1]
+    assert mdb.all() == [{'a': 1, 'b': 1, 'c': 1}]
+
+
+def test_insert_multiple_document_then_generated_id(mdb):
+    mdb.insert({'a': 1})
+    mdb.insert({'a': 2})
+    ids = mdb.insert_multiple([Document({'z': 1}, doc_id=3), {'z': 2}])
+    assert ids == [3, 4]
+    assert len(mdb) == 4
+    assert mdb.get(doc_id=3) == {'z': 1}
+    assert mdb.get(doc_id=4) == {'z': 2}
+
+
+def test_insert_after_insert_multiple_with_document(mdb):
+    mdb.insert({'a': 1})
+    mdb.insert({'a': 2})  # next ID is now cached as 3
+    mdb.insert_multiple([Document({'z': 1}, doc_id=3)])
+    assert mdb.insert({'q': 1}) == 4
+    assert len(mdb) == 4
+
+
+def test_insert_with_stale_next_id(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    db1 = TinyDB(path)
+    db2 = TinyDB(path)
+    try:
+        db1.insert({'a': 1})  # db1 caches next ID = 2
+        db2.insert({'a': 2})  # takes ID 2 behind db1's back
+        new_id = db1.insert({'a': 3})
+        assert new_id == 3
+        assert sorted(d['a'] for d in db1.all()) == [1, 2, 3]
+    finally:
+        db1.close()
+        db2.close()
+
+
+def test_search_results_mutation_does_not_corrupt_cache(mdb):
+    mdb.insert({'a': 1})
+    result = mdb.search(where('a') == 1)
+    result[0]['a'] = 'mutated'
+    assert mdb.search(where('a') == 1) == [{'a': 1}]
+    cached = mdb.search(where('a') == 1)
+    cached[0]['b'] = 2
+    assert mdb.search(where('a') == 1) == [{'a': 1}]
+    assert mdb.search(where('a') == 1)[0].doc_id == 1
+
+
+def test_failed_update_clears_query_cache(mdb):
+    mdb.insert({'a': 1, 'b': 1})
+    mdb.insert({'a': 2})
+    assert len(mdb.search(where('b').exists())) == 1
+    with pytest.raises(KeyError):
+        # Second document has no ``b`` -> fails after the first was
+        # modified in place
+        mdb.update(delete('b'))
+    assert mdb.search(where('b').exists()) == \
+        [d for d in mdb.all() if 'b' in d]
+
+
+def test_db_copy_does_not_recurse(mdb):
+    mdb.insert({'a': 1})
+    copied = copy.copy(mdb)
+    assert len(copied) == 1
+
+    empty = TinyDB.__new__(TinyDB)
+    with pytest.raises(AttributeError):
+        empty.tables()
+
+
+# --- Storages / middlewares ------------------------------------------------
+
+def test_create_dirs_without_directory_component(tmpdir):
+    cwd = os.getcwd()
+    os.chdir(str(tmpdir))
+    try:
+        with TinyDB('db.json', create_dirs=True) as db:
+            db.insert({'a': 1})
+        assert os.path.exists('db.json')
+    finally:
+        os.chdir(cwd)
+
+
+def test_create_dirs_existing_directory(tmpdir):
+    path = str(tmpdir.join('sub', 'db.json'))
+    TinyDB(path, create_dirs=True).close()
+    os.remove(path)
+    TinyDB(path, create_dirs=True).close()
+    assert os.path.exists(path)
+
+
+def test_binary_access_mode_write(tmpdir):
+    path = str(tmpdir.join('db.json'))
+    with TinyDB(path, access_mode='rb+') as db:
+        db.insert({'a': 'ä'})
+    with TinyDB(path) as db:
+        assert db.all() == [{'a': 'ä'}]
+
+
+def test_middleware_uninitialized_getattr():
+    mw = CachingMiddleware.__new__(CachingMiddleware)
+    assert not hasattr(mw, 'foo')
+
+
+# --- Queries ----------------------------------------------------------------
+
+def test_regex_flags_are_part_of_cache_key(mdb):
+    mdb.insert({'s': 'John'})
+    assert mdb.search(where('s').matches('john')) == []
+    assert len(mdb.search(where('s').matches('john', flags=re.I))) == 1
+    assert mdb.search(where('s').search('OH')) == []
+    assert len(mdb.search(where('s').search('OH', flags=re.I))) == 1
+    assert hash(where('s').matches('a')) != \
+        hash(where('s').matches('a', flags=re.I))
+
+
+def test_fragment_path_is_part_of_cache_key(mdb):
+    mdb.insert({'a': {'x': 1}})
+    mdb.insert({'b': {'x': 1}})
+    assert mdb.search(Query().a.fragment({'x': 1})) == [{'a': {'x': 1}}]
+    assert mdb.search(Query().b.fragment({'x': 1})) == [{'b': {'x': 1}}]
+    assert Query().a.fragment({'x': 1}) != Query().b.fragment({'x': 1})
+
+
+def test_fragment_on_non_mapping_value():
+    query = Query().a.fragment({'x': 1})
+    assert not query({'a': 1})
+    assert not query({'a': ['x']})
+    assert not query({'a': 'x'})
+
+
+def test_hash_dict_with_mixed_key_types(mdb):
+    mdb.insert({'a': 1})
+    assert mdb.search(where('a') == {1: 2, 'x': 1}) == []
+    assert hash(FrozenDict({1: 2, 'x': 1}))
+
+
+def test_unhashable_rhs_values(mdb):
+    mdb.insert({'a': [1]})
+    assert mdb.search(where('a') == (1, [2])) == []
+    assert mdb.search(where('a') < [2]) == [{'a': [1]}]
+    assert mdb.search(where('a') >= [1]) == [{'a': [1]}]
+    assert mdb.search(where('a').test(lambda v, l: v == l, [1])) == \
+        [{'a': [1]}]
+
+
+def test_comparison_with_incomparable_values(mdb):
+    mdb.insert({'age': None})
+    mdb.insert({'age': 'unknown'})
+    mdb.insert({'age': 20})
+    assert mdb.search(where('age') > 18) == [{'age': 20}]
+    assert mdb.search(where('age') >= 18) == [{'age': 20}]
+    assert mdb.search(where('age') < 30) == [{'age': 20}]
+    assert mdb.search(where('age') <= 30) == [{'age': 20}]
+
+
+def test_one_of_with_generator(mdb):
+    for f in (1, 2, 3):
+        mdb.insert({'f': f})
+    query = where('f').one_of(x for x in [2, 3])
+    assert mdb.search(query) == [{'f': 2}, {'f': 3}]
+    assert query({'f': 3})
+
+
+def test_any_all_with_non_cacheable_condition(mdb):
+    mdb.insert({'l': [1, 2]})
+    q1 = Query().l.any(Query().map(lambda x: x) == 1)
+    q2 = Query().l.any(Query().map(lambda x: x) == 5)
+    assert not q1.is_cacheable()
+    assert mdb.search(q1) == [{'l': [1, 2]}]
+    assert mdb.search(q2) == []
+    q3 = Query().l.all(Query().map(lambda x: x) > 0)
+    assert not q3.is_cacheable()
+
+
+def test_non_cacheable_queries_not_equal():
+    q1 = Query().map(lambda x: x) == 1
+    q2 = Query().map(lambda x: x) == 2
+    assert q1 != q2
+    assert q1 == q1
+
+
+def test_query_copy_and_dunder_fields():
+    query = Query().a
+    copied = copy.deepcopy(query)
+    assert (copied == 1)({'a': 1})
+    assert copy.deepcopy(where('a') == 1)({'a': 1})
+    assert (Query()['__x__'] == 1)({'__x__': 1})
+
+
+# --- Utils ------------------------------------------------------------------
+
+def test_lru_cache_none_values():
+    cache = LRUCache(capacity=2)
+    cache['a'] = None
+    assert 'a' in cache
+    assert cache['a'] is None
+    assert cache.get('a', 'default') is None
+    with pytest.raises(KeyError):
+        cache['missing']
