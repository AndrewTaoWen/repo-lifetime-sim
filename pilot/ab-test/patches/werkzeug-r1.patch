+def test_package_loader_does_not_leak_files(tmp_path, monkeypatch):
+    import importlib.util
+    from types import SimpleNamespace
+
+    (tmp_path / "static").mkdir()
+    (tmp_path / "static" / "a.txt").write_text("FOUND")
+    opened = []
+
+    class Reader:
+        def open_resource(self, name):
+            f = open(tmp_path / name, "rb")
+            opened.append(f)
+            return f
+
+    spec = SimpleNamespace(
+        loader=SimpleNamespace(get_resource_reader=lambda name: Reader())
+    )
+    monkeypatch.setattr(importlib.util, "find_spec", lambda name: spec)
+
+    def null_application(environ, start_response):
+        start_response("404 NOT FOUND", [])
+        return [b"NOT FOUND"]
+
+    app = SharedDataMiddleware(null_application, {"/pkg": ("fake", "static")})
+    # not allowed, the opened file must not be left open
+    app.is_allowed = lambda filename: False
+    app_iter, status, _ = run_wsgi_app(app, create_environ("/pkg/a.txt"))
+    assert status == "404 NOT FOUND"
+    assert all(f.closed for f in opened)
+
+    app.is_allowed = lambda filename: True
+    app_iter, status, _ = run_wsgi_app(app, create_environ("/pkg/a.txt"))
+
+    with closing(app_iter) as app_iter:
+        assert b"".join(app_iter) == b"FOUND"
+
+    assert all(f.closed for f in opened)
