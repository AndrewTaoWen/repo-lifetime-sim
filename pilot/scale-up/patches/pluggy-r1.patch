+def test_register_failure_leaves_no_partial_state(pm: PluginManager) -> None:
+    """A plugin failing validation must not stay half-registered."""
+
+    class Hooks:
+        @hookspec
+        def he_method1(self, arg): ...
+
+        @hookspec
+        def he_method2(self, arg): ...
+
+    pm.add_hookspecs(Hooks)
+
+    class Bad:
+        @hookimpl
+        def he_method1(self, arg):
+            return 1  # pragma: no cover
+
+        @hookimpl
+        def he_method2(self, not_in_spec):
+            pass  # pragma: no cover
+
+        @hookimpl(optionalhook=True)
+        def unknown_hook(self):
+            pass  # pragma: no cover
+
+    bad = Bad()
+    with pytest.raises(PluginValidationError):
+        pm.register(bad, name="bad")
+    assert not pm.is_registered(bad)
+    assert not pm.has_plugin("bad")
+    assert pm.hook.he_method1(arg=1) == []
+    assert not hasattr(pm.hook, "unknown_hook")
+    # Can be registered again once fixed, under the same name.
+    assert pm.register(object(), name="bad") == "bad"
+
+
