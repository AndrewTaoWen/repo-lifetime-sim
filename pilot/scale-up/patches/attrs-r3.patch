+class TestKwOnlyExceptions:
+    def test_pickle_and_copy(self):
+        @attrs.define
+        class E(Exception):
+            a: int
+            b: int = attrs.field(kw_only=True)
+
+        globals()["E"] = E
+        E.__qualname__ = "E"
+        try:
+            e = E(1, b=2)
+
+            assert (1, 2) == pickle.loads(pickle.dumps(e)).args
+            c = copy.copy(e)
+            assert (c.a, c.b) == (1, 2)
+        finally:
+            del globals()["E"]
+
+    def test_private_alias(self):
+        @attrs.define(slots=False)
+        class E(Exception):
+            a: int
+            _b: int = attrs.field(kw_only=True, default=3)
+
+        e = E(1, b=2)
+        e.extra = 9
+        c = copy.copy(e)
+
+        assert (1, 2, 9) == (c.a, c._b, c.extra)
+
