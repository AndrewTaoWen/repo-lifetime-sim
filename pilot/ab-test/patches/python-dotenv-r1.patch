+def test_rewrite_closes_source_when_temp_file_fails(dotenv_path, monkeypatch):
+    dotenv_path.write_text("a=b\n")
+    opened = []
+    real_open = open
+
+    def recording_open(*args, **kwargs):
+        f = real_open(*args, **kwargs)
+        opened.append(f)
+        return f
+
+    def failing_tempfile(*args, **kwargs):
+        raise OSError("no space")
+
+    monkeypatch.setattr(dotenv.main, "open", recording_open, raising=False)
+    monkeypatch.setattr(dotenv.main.tempfile, "NamedTemporaryFile", failing_tempfile)
+
+    with pytest.raises(OSError, match="no space"):
+        dotenv.set_key(dotenv_path, "a", "c")
+
+    assert opened and all(f.closed for f in opened)
