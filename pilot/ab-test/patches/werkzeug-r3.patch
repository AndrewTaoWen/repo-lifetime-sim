+def test_shared_data_package_loader_not_left_open(monkeypatch):
+    opened = []
+
+    import importlib.util
+
+    real_find_spec = importlib.util.find_spec
+
+    def find_spec(name):
+        spec = real_find_spec(name)
+        reader = spec.loader.get_resource_reader(name)
+        real_open = reader.open_resource
+
+        def open_resource(path):
+            f = real_open(path)
+            opened.append(f)
+            return f
+
+        reader.open_resource = open_resource
+
+        class Loader:
+            def get_resource_reader(self, n):
+                return reader
+
+        class Spec:
+            loader = Loader()
+
+        return Spec()
+
+    monkeypatch.setattr(importlib.util, "find_spec", find_spec)
+
+    class Disallow(SharedDataMiddleware):
+        def is_allowed(self, filename):
+            return False
+
+    def fallback(environ, start_response):
+        start_response("404 NOT FOUND", [])
+        return [b""]
+
+    app = Disallow(fallback, {"/": ("werkzeug", "debug/shared")})
+    Client(app).get("/style.css").close()
+    assert opened
+    assert all(f.closed for f in opened)
