+def test_cli_does_not_mutate_args(tmpdir):
+    path = tmpdir.join('a.sql')
+    path.write('select 1')
+    parser = sqlparse.cli.create_parser()
+    args = parser.parse_args([str(path), '-r'])
+    sqlparse.cli._process_file(str(path), args)
+    assert not hasattr(args, 'indent_char')
