+# SPDX-License-Identifier: MIT
+
+"""
+Regression tests for assorted robustness fixes.
+"""
+
+import collections
+import copy
+import functools
+import pickle
+import sys
+import types
+import typing
+
+import pytest
+
+import attr
+import attrs
+
+from attr._make import _is_class_var
+from attrs import Converter, cmp_using, define, field, validators
+
+
+class TestDefineReuse:
+    def test_reused_decorator_with_frozen_base(self):
+        """
+        A decorator returned by define() can be applied to several classes,
+        one of them inheriting from a frozen class, without the frozen-ness
+        leaking into the on_setattr of the other classes (or raising).
+        """
+        d = define()
+
+        @attrs.frozen
+        class FrozenBase:
+            x: int = 0
+
+        @d
+        class A:
+            y: int = field(default=0, validator=validators.instance_of(int))
+
+        @d
+        class B(FrozenBase):
+            z: int = 0
+
+        @d
+        class C:
+            y: int = field(default=0, validator=validators.instance_of(int))
+
+        with pytest.raises(attrs.exceptions.FrozenInstanceError):
+            B().z = 1
+
+        c = C()
+        with pytest.raises(TypeError):
+            c.y = "nope"
+
+        a = A()
+        with pytest.raises(TypeError):
+            a.y = "nope"
+
+
+def test_module_globals_dont_shadow_generated_names():
+    """
+    Module-level globals named like the internals used by generated methods
+    (e.g. ``_config`` or ``_compat``) don't break the generated methods.
+    """
+    mod = types.ModuleType("attrs_test_shadow_mod")
+    sys.modules[mod.__name__] = mod
+    try:
+        src = """
+import attrs
+
+_config = {"debug": True}
+_compat = None
+NOTHING = "not attrs' NOTHING"
+
+def x_repr(v):
+    return "module's x_repr"
+
+@attrs.define
+class C:
+    x: int = attrs.field(
+        validator=attrs.validators.instance_of(int), repr=lambda v: "custom"
+    )
+    y: list = attrs.field(factory=list)
+"""
+        exec(compile(src, "<shadow>", "exec"), mod.__dict__)  # noqa: S102
+
+        C = mod.C
+
+        assert "C(x=custom, y=[])" == repr(C(1))
+
+        with pytest.raises(TypeError):
+            C("1")
+
+        assert {"return": type(None), "x": int, "y": list} == typing.get_type_hints(
+            C.__init__
+        )
+    finally:
+        del sys.modules[mod.__name__]
+
+
+class TestSlots:
+    def test_base_with_string_slots(self):
+        """
+        A non-attrs base class may declare __slots__ as a single string.
+        """
+
+        class Base:
+            __slots__ = "abc"
+
+        @define
+        class C(Base):
+            x: int
+
+        c = C(1)
+        c.abc = 2
+
+        assert 1 == c.x
+        assert 2 == c.abc
+
+    def test_base_with_private_slots(self):
+        """
+        A non-attrs base class may declare private (mangled) slots.
+        """
+
+        class Base:
+            __slots__ = ("__priv",)
+
+            def set_priv(self, v):
+                self.__priv = v
+
+            def get_priv(self):
+                return self.__priv
+
+        @define
+        class C(Base):
+            x: int
+
+        c = C(1)
+        c.set_priv(42)
+
+        assert 42 == c.get_priv()
+
+    def test_pickle_and_copy_unset_attribute(self):
+        """
+        Slotted instances with attributes that have not been set can be copied
+        and pickled.
+        """
+
+        c = UnsetSlotted(1)
+
+        for c2 in (copy.copy(c), pickle.loads(pickle.dumps(c))):
+            assert 1 == c2.x
+            assert not hasattr(c2, "y")
+
+        c.y = 2
+
+        assert 2 == copy.copy(c).y
+
+
+@define
+class UnsetSlotted:
+    x: int
+    y: int = field(init=False)
+
+
+@attr.s(frozen=True, cache_hash=True)
+class CachedHashDict:
+    x = attr.ib()
+
+
+def test_assoc_resets_cached_hash():
+    """
+    assoc() doesn't carry the cached hash over to the changed copy.
+    """
+    i = CachedHashDict(1)
+    hash(i)
+
+    i2 = attr.assoc(i, x=2)
+
+    assert hash(CachedHashDict(2)) == hash(i2)
+    assert hash(CachedHashDict(1)) == hash(i)
+
+
+class TestConverterNonFunctions:
+    def test_partial(self):
+        """
+        Converters taking self and field can be functools.partial objects
+        with return annotations.
+        """
+
+        def conv(val, inst, fld, factor) -> int:
+            return int(val) * factor
+
+        c = Converter(
+            functools.partial(conv, factor=2),
+            takes_self=True,
+            takes_field=True,
+        )
+
+        @define
+        class C:
+            x: int = field(converter=c)
+
+        assert 4 == C("2").x
+
+    def test_callable_object(self):
+        """
+        Converters taking self and field can be callable objects with
+        annotated __call__, and their class annotations aren't touched.
+        """
+
+        class Conv:
+            factor: int = 3
+
+            def __call__(self, val, inst, fld) -> int:
+                return int(val) * self.factor
+
+        Converter(Conv(), takes_self=True, takes_field=True)
+
+        assert {"factor": int} == Conv.__annotations__
+
+
+def test_make_class_does_not_mutate_dict():
+    """
+    make_class() doesn't remove special methods from the dict it's passed.
+    """
+    called = []
+
+    def post_init(self):
+        called.append(self)
+
+    d = {"x": attr.ib(), "__attrs_post_init__": post_init}
+
+    C1 = attr.make_class("C1", d)
+    C2 = attr.make_class("C2", d)
+
+    assert ["x", "__attrs_post_init__"] == list(d)
+
+    C1(1)
+    C2(2)
+
+    assert 2 == len(called)
+
+
+NT = collections.namedtuple("NT", "a b")
+
+
+@pytest.mark.parametrize("value", [[NT(1, 2)], {"k": NT(1, 2)}, ((NT(1, 2),),)])
+def test_asdict_nested_namedtuple_retain(value):
+    """
+    Namedtuples nested within collections are supported with
+    retain_collection_types=True.
+    """
+
+    @define
+    class C:
+        x: object
+
+    assert {"x": value} == attr.asdict(C(value), retain_collection_types=True)
+    assert {"x": value} == attrs.asdict(C(value))
+
+
+class TestEmptyLists:
+    def test_empty_validator_list(self):
+        """
+        An empty list of validators means no validator.
+        """
+
+        @define
+        class C:
+            x: int = field(validator=[])
+
+        assert attrs.fields(C).x.validator is None
+
+        attrs.validate(C(1))
+
+    def test_empty_converter_list(self):
+        """
+        An empty list of converters means no converter.
+        """
+
+        @define
+        class C:
+            x: int = field(converter=[])
+
+        assert attrs.fields(C).x.converter is None
+
+        c = C(1)
+        c.x = 2
+
+        assert 2 == c.x
+
+
+def test_cmp_using_compared_with_other_types():
+    """
+    Comparing a cmp_using class to something unrelated doesn't crash.
+    """
+    C = cmp_using(eq=lambda a, b: a == b, lt=lambda a, b: a < b)
+
+    assert C(1) != 1
+    assert not (C(1) == 1)
+    assert C(1) == C(1)
+
+    with pytest.raises(TypeError):
+        C(1) < 1  # noqa: B015
+
+    D = cmp_using(eq=lambda a, b: a == b, require_same_type=False)
+
+    assert D(1) != 1
+
+
+class TestIsClassVar:
+    @pytest.mark.parametrize(
+        "annot",
+        [
+            "ClassVarConfig",
+            "ClassVariable",
+            "t.ClassVariable[int]",
+            "typing.ClassVarX",
+        ],
+    )
+    def test_names_starting_with_classvar(self, annot):
+        """
+        Names that merely start with "ClassVar" are not ClassVars.
+        """
+        assert not _is_class_var(annot)
+
+    @pytest.mark.parametrize(
+        "annot",
+        [
+            "ClassVar",
+            "ClassVar[int]",
+            "'ClassVar[int]'",
+            "typing.ClassVar[int]",
+            typing.ClassVar[int],
+            typing.ClassVar,
+        ],
+    )
+    def test_classvars(self, annot):
+        """
+        Actual ClassVars are still detected.
+        """
+        assert _is_class_var(annot)
+
+    def test_field_with_classvar_prefixed_type(self):
+        """
+        A string-annotated field whose type name starts with "ClassVar" is a
+        field.
+        """
+
+        @define
+        class C:
+            cfg: "ClassVarConfig"  # noqa: F821
+            n: "ClassVar[int]" = 0
+
+        assert ("cfg",) == tuple(a.name for a in attrs.fields(C))
+
+
+def test_fields_dict_generic():
+    """
+    fields_dict() works with specialized generics, like fields().
+    """
+    T = typing.TypeVar("T")
+
+    @define
+    class G(typing.Generic[T]):
+        x: T
+
+    assert attrs.fields_dict(G) == attrs.fields_dict(G[int])
+    assert ["x"] == list(attrs.fields_dict(G[int]))
+
+
+def test_in_set_options():
+    """
+    in_() with set or dict options keeps working and stays hashable.
+    """
+    v = validators.in_({1, 2, 3})
+
+    @define
+    class C:
+        x: int = field(validator=v)
+
+    C(1)
+
+    with pytest.raises(ValueError, match=r"must be in \{1, 2, 3\}"):
+        C(4)
+
+    with pytest.raises(ValueError):
+        C([1])
+
+    hash(v)
+    hash(validators.in_({"a": 1}))
