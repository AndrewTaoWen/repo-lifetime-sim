-        return item(data, _sort_keys=True).as_string()
+        return item(_to_sortable(data), _sort_keys=True).as_string()
+
+    if sort_keys:
+        return item(_to_sortable(dict(data)), _sort_keys=True).as_string()
 
     table = item(dict(data), _sort_keys=sort_keys)
     return table.as_string()
 
 
+def _to_sortable(data: Any) -> Any:
+    """Convert (possibly nested) tables to plain dicts so that ``item()`` can
+    rebuild them with sorted keys. Existing items (and their formatting) are
+    reused for leaf values."""
+    if isinstance(data, InlineTable):
+        # Keep inline tables inline
+        return data
+    if isinstance(data, dict):
+        return {k: _to_sortable(data[k]) for k in data}
+    if isinstance(data, AoT):
+        return [_to_sortable(t) for t in data]
+    return data
+
+
