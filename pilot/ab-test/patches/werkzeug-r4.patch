+def _cookie_app(header):
+    @Request.application
+    def app(request):
+        if request.path == "/set":
+            return Response(headers=[("Set-Cookie", header)])
+
+        return Response(request.headers.get("Cookie", ""))
+
+    return app
+
+
+def test_client_cookie_leading_dot_domain():
+    client = Client(_cookie_app("a=b; Domain=.Example.com; Path=/"))
+    client.get("/set", base_url="http://www.example.com")
+    assert client.get("/", base_url="http://sub.example.com").text == "a=b"
+    assert client.get("/", base_url="http://example.com").text == "a=b"
+
+
+@pytest.mark.parametrize(
+    "params",
+    [
+        "Max-Age=-1",
+        "Expires=Thu, 01 Jan 2004 00:00:00 GMT",
+    ],
+)
+def test_client_cookie_expired_deleted(params):
+    client = Client(_cookie_app(f"a=b; Path=/; {params}"))
+    client.set_cookie("a", "old")
+    client.get("/set")
+    assert client.get_cookie("a") is None
+
+
+def test_client_cookie_invalid_max_age():
