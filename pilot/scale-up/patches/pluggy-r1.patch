+def test_equal_but_distinct_plugins(pm: PluginManager) -> None:
+    """Plugins are identified by identity, not equality; they need not be
+    hashable (e.g. dataclass instances)."""
+    import dataclasses
+
+    class Hooks:
+        @hookspec
+        def he_method1(self, arg): ...
+
+    pm.add_hookspecs(Hooks)
+
+    @dataclasses.dataclass
+    class Plugin:
+        value: int
+
+        @hookimpl
+        def he_method1(self, arg):
+            return (self.value, id(self))
+
+    p1, p2 = Plugin(1), Plugin(1)
+    assert p1 == p2
+    pm.register(p1, name="p1")
+    pm.register(p2, name="p2")
+    assert pm.get_name(p2) == "p2"
+    assert len(pm.hook.he_method1(arg=0)) == 2
+
+    sub = pm.subset_hook_caller("he_method1", [p1])
+    assert sub(arg=0) == [(1, id(p2))]
+
+    pm.unregister(p1)
+    assert pm.is_registered(p2)
+    assert pm.hook.he_method1(arg=0) == [(1, id(p2))]
+
+
+def test_subset_hook_caller_specname(pm: PluginManager) -> None:
+    class Hooks:
+        @hookspec
+        def he_method1(self, arg): ...
+
+    pm.add_hookspecs(Hooks)
+
+    class Plugin:
+        @hookimpl(specname="he_method1")
+        def other_name(self, arg):
+            return "removed"
+
+    class Plugin2:
+        @hookimpl
+        def he_method1(self, arg):
+            return "kept"
+
+    p, p2 = Plugin(), Plugin2()
+    pm.register(p)
+    pm.register(p2)
+    assert sorted(pm.hook.he_method1(arg=1)) == ["kept", "removed"]
+    assert pm.subset_hook_caller("he_method1", [p])(arg=1) == ["kept"]
+
+
+def test_add_hookcall_monitoring_undo_out_of_order(pm: PluginManager) -> None:
+    class Hooks:
+        @hookspec
+        def he_method1(self, arg): ...
+
+    pm.add_hookspecs(Hooks)
+
+    calls: list[str] = []
+
+    def make(tag: str):
+        def before(name, impls, kwargs) -> None:
+            calls.append(tag)
+
+        def after(outcome, name, impls, kwargs) -> None:
+            pass
+
+        return before, after
+
+    undo_a = pm.add_hookcall_monitoring(*make("a"))
+    undo_b = pm.add_hookcall_monitoring(*make("b"))
+    undo_a()
+    pm.hook.he_method1(arg=1)
+    assert calls == ["b"]
+    calls.clear()
+    undo_b()
+    pm.hook.he_method1(arg=1)
+    assert calls == []
+
+
