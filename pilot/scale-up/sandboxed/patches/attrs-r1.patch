+def _mangle_name(cls: type, name: str) -> str:
+    """
+    Apply Python's private name mangling to *name* as if it was defined in the
+    body of *cls*.
+    """
+    if not name.startswith("__") or name.endswith("__") or "." in name:
+        return name
+
+    cls_name = cls.__name__.lstrip("_")
+    if not cls_name:
+        return name
+
+    return f"_{cls_name}{name}"
+
