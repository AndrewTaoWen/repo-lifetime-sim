+@pytest.mark.parametrize(
+    ("name", "filename"),
+    [('a"b', 'x"y.txt'), ("a\r\nb", "c\nd.txt"), ("ü", "ü.txt")],
+)
+def test_multipart_encoder_quotes_params(name, filename):
+    encoder = MultipartEncoder(b"bound")
+    data = encoder.send_event(Preamble(data=b""))
+    data += encoder.send_event(File(name=name, filename=filename, headers=Headers()))
+    data += encoder.send_event(Data(data=b"content", more_data=False))
+    data += encoder.send_event(Epilogue(data=b""))
+    decoder = MultipartDecoder(b"bound")
+    decoder.receive_data(data)
+    decoder.receive_data(None)
+    events = []
+    while not isinstance(event := decoder.next_event(), Epilogue):
+        events.append(event)
+    file_event = events[1]
+    assert isinstance(file_event, File)
+    # Quotes round trip. Newlines are percent encoded so they can't break the
+    # header, they are not decoded again.
+    assert file_event.name == name.replace("\r", "%0D").replace("\n", "%0A")
+    assert file_event.filename == filename.replace("\r", "%0D").replace("\n", "%0A")
+    assert events[2] == Data(data=b"content", more_data=False)
+
