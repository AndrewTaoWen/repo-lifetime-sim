+# BaseConverter and PEP 563 (this module uses stringified annotations)
+
+
+@attrs.define
+class Inner563:
+    x: int
+
+
+@attrs.define
+class Outer563:
+    i: Inner563
+    n: int
+
+
+@dataclasses.dataclass
+class DataclassOuter563:
+    i: Inner563
+
+
+@pytest.mark.parametrize(
+    "strat", [UnstructureStrategy.AS_DICT, UnstructureStrategy.AS_TUPLE]
+)
+def test_baseconverter_stringified_annotations(strat):
+    c = BaseConverter(unstruct_strat=strat)
+    unstructured = c.unstructure(Outer563(Inner563(1), 2))
+    assert unstructured in ({"i": {"x": 1}, "n": 2}, ((1,), 2))
+    assert c.structure(unstructured, Outer563) == Outer563(Inner563(1), 2)
+
+    dc_unstructured = c.unstructure(DataclassOuter563(Inner563(1)))
+    assert dc_unstructured in ({"i": {"x": 1}}, ((1,),))
+    assert c.structure(dc_unstructured, DataclassOuter563) == DataclassOuter563(
+        Inner563(1)
+    )
