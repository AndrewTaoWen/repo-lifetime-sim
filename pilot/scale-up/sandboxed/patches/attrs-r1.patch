diff --git a/tests/test_hardening.py b/tests/test_hardening.py
new file mode 100644
index 0000000..4ddab73
--- /dev/null
+++ b/tests/test_hardening.py
@@ -0,0 +1,337 @@
+# SPDX-License-Identifier: MIT
+
+"""
+Regression tests for latent bugs found while hardening attrs.
+"""
+
+import collections
+import copy
+import functools
+import pickle
+import sys
+import types
+
+import pytest
+
+import attr
+import attrs
+
+from attr._compat import PY_3_13_PLUS
+from attrs import define, field, fields, validators
+
+
+class TestModuleGlobalsDoNotShadow:
+    """
+    Generated methods use the defining module's globals for type hint
+    resolution, but those must not shadow names the generated code needs.
+    """
+
+    def test_module_level_config_and_compat(self, monkeypatch):
+        """
+        A module that has globals called ``_config`` and ``_compat`` can
+        define classes with validators and get a working __init__ / __repr__.
+        """
+        mod = types.ModuleType("attrs_test_shadow_mod")
+        monkeypatch.setitem(sys.modules, mod.__name__, mod)
+        exec(  # noqa: S102
+            "import attrs\n"
+            "_config = {'debug': True}\n"
+            "_compat = 'not attr._compat'\n"
+            "AttributeError = None\n"
+            "@attrs.define\n"
+            "class C:\n"
+            "    x: int = attrs.field(\n"
+            "        validator=attrs.validators.instance_of(int)\n"
+            "    )\n",
+            mod.__dict__,
+        )
+
+        c = mod.C(1)
+
+        assert "C(x=1)" == repr(c)
+        with pytest.raises(TypeError):
+            mod.C("1")
+
+
+class TestReplace:
+    """
+    __replace__ is a per-class method and doesn't clobber `attrs.evolve`.
+    """
+
+    def test_evolve_untouched(self):
+        """
+        Creating classes doesn't rename or re-document the public evolve.
+        """
+
+        @define
+        class C:
+            x: int
+
+        assert "evolve" == attrs.evolve.__qualname__
+        assert "attr._make" == attrs.evolve.__module__
+        assert attrs.evolve.__doc__.lstrip().startswith("Create a new")
+        assert attrs.evolve is pickle.loads(pickle.dumps(attrs.evolve))
+
+    @pytest.mark.skipif(not PY_3_13_PLUS, reason="copy.replace is 3.13+")
+    def test_copy_replace(self):
+        """
+        copy.replace still works.
+        """
+
+        @define
+        class C:
+            x: int
+            y: int = 0
+
+        assert C(2, 5) == copy.replace(C(1, 5), x=2)
+        assert C(1, 3) == copy.replace(C(1, 5), y=3)
+        assert C.__replace__.__qualname__.endswith("C.__replace__")
+
+
+class TestDefineDecoratorReuse:
+    """
+    A decorator returned by define(...) can be reused for many classes.
+    """
+
+    def test_frozen_base_does_not_leak_no_op(self):
+        """
+        Applying the decorator to a subclass of a frozen class doesn't disable
+        on_setattr validation for classes decorated later.
+        """
+        dec = define(slots=False)
+
+        @attrs.frozen
+        class Frozen:
+            pass
+
+        @dec
+        class A(Frozen):
+            x: int = 0
+
+        @dec
+        class B:
+            x: int = field(default=0, validator=validators.instance_of(int))
+
+        b = B()
+        with pytest.raises(TypeError):
+            b.x = "nope"
+
+    def test_default_on_setattr_does_not_leak(self):
+        """
+        Applying the decorator to a regular class doesn't make a later
+        subclass of a frozen class fail with a spurious on_setattr error.
+        """
+        dec = define()
+
+        @attrs.frozen
+        class Frozen:
+            pass
+
+        @dec
+        class A:
+            x: int = 0
+
+        @dec
+        class B(Frozen):
+            y: int = 0
+
+        with pytest.raises(attrs.exceptions.FrozenInstanceError):
+            B().y = 1
+
+
+class TestOptionalListHashable:
+    def test_hashable(self):
+        """
+        optional() with a list of validators is hashable, and so is the
+        Attribute that carries it.
+        """
+        v = validators.optional([validators.instance_of(int)])
+
+        @define
+        class C:
+            x: int = field(default=None, validator=v)
+
+        hash(v)
+        hash(fields(C).x)
+        assert v == validators.optional((validators.instance_of(int),))
+
+
+class TestBaseSlots:
+    """
+    Slotted attrs classes can subclass classes with unusual __slots__.
+    """
+
+    def test_private_slot_names(self):
+        """
+        Private (name-mangled) slots in a base class don't crash.
+        """
+
+        class Base:
+            __slots__ = ("__p", "q")
+
+        @define
+        class C(Base):
+            x: int
+
+        assert 1 == C(1).x
+
+    def test_string_slots(self):
+        """
+        A string __slots__ is a single slot, not one per character.
+        """
+
+        class Base:
+            __slots__ = "ab"
+
+        @define
+        class C(Base):
+            ab: int
+
+        c = C(1)
+
+        assert 1 == c.ab
+        assert Base.__dict__["ab"] is C.__dict__["ab"]
+
+
+@define
+class SlottedWithUnset:
+    x: int
+    y: int = field(init=False)
+
+
+class TestPickleUnsetSlots:
+    def test_unset_attribute(self):
+        """
+        Slotted instances with attributes that were never set can be pickled
+        and copied.
+        """
+        c = SlottedWithUnset(1)
+
+        for new in (pickle.loads(pickle.dumps(c)), copy.copy(c)):
+            assert 1 == new.x
+            assert not hasattr(new, "y")
+
+
+class TestMakeClassDoesNotMutate:
+    def test_hooks_kept(self):
+        """
+        make_class doesn't pop hooks out of the passed dict, so it can be
+        reused.
+        """
+        calls = []
+        body = {
+            "x": attr.ib(),
+            "__attrs_post_init__": lambda self: calls.append(self.x),
+        }
+        keys = set(body)
+
+        attr.make_class("A", body)(1)
+        attr.make_class("B", body)(2)
+
+        assert [1, 2] == calls
+        assert keys == set(body)
+
+
+class TestConverterAnnotations:
+    def test_partial(self):
+        """
+        Converters without __annotations__ (partials) with a return type work.
+        """
+
+        def conv(val, inst, fld) -> int:
+            return int(val)
+
+        c = attrs.Converter(
+            functools.partial(conv), takes_self=True, takes_field=True
+        )
+
+        @define
+        class C:
+            x: int = field(converter=c)
+
+        assert 1 == C("1").x
+
+    def test_callable_instance_class_untouched(self):
+        """
+        The annotations of a callable instance's class are not modified.
+        """
+
+        class Conv:
+            y: str
+
+            def __call__(self, val, inst, fld) -> int:
+                return int(val)
+
+        attrs.Converter(Conv(), takes_self=True, takes_field=True)
+
+        assert {"y": str} == Conv.__annotations__
+
+
+class TestAsdictNamedTupleInCollection:
+    def test_retained(self):
+        """
+        Namedtuples nested in collections survive retain_collection_types.
+        """
+        NT = collections.namedtuple("NT", "a b")
+
+        @define
+        class C:
+            x: list
+
+        assert {"x": [NT(1, 2)]} == attrs.asdict(C([NT(1, 2)]))
+        assert {"x": [[1, 2]]} == attr.asdict(C([NT(1, 2)]))
+
+
+class TestFilterUnhashableAttribute:
+    def test_exclude_include(self):
+        """
+        Attributes with unhashable defaults can be used in filters.
+        """
+
+        @define
+        class C:
+            x: dict = {"a": 1}  # noqa: RUF012
+            y: int = 2
+
+        assert {"y": 2} == attrs.asdict(
+            C(), filter=attrs.filters.exclude(fields(C).x)
+        )
+        assert {"x": {"a": 1}} == attrs.asdict(
+            C(), filter=attrs.filters.include(fields(C).x)
+        )
+
+
+class TestCmpUsingForeign:
+    def test_not_implemented(self):
+        """
+        Comparing a cmp_using instance to something else returns
+        NotImplemented instead of raising AttributeError.
+        """
+        C = attrs.cmp_using(eq=lambda a, b: a == b, lt=lambda a, b: a < b)
+        D = attrs.cmp_using(
+            eq=lambda a, b: a == b, require_same_type=False
+        )
+
+        assert C(1) != 1
+        assert C(1) == C(1)
+        assert NotImplemented is C(1).__lt__(1)
+        assert D(1) != 1
+        assert D(1) == C(1)
+
+
+class TestAstupleDefaultdict:
+    def test_retained(self):
+        """
+        astuple with retain_collection_types keeps defaultdicts intact.
+        """
+
+        @define
+        class C:
+            x: dict
+
+        dd = collections.defaultdict(list, {1: [2]})
+        (rv,) = attrs.astuple(C(dd))
+
+        assert dd == rv
+        assert list is rv.default_factory
+        assert ({1: [2]},) == attr.astuple(C(dd))
