diff --git a/tests/test_hardening.py b/tests/test_hardening.py
new file mode 100644
index 0000000..4b63f44
--- /dev/null
+++ b/tests/test_hardening.py
@@ -0,0 +1,307 @@
+"""Regression tests for edge cases found while hardening the library."""
+
+from __future__ import annotations
+
+import io
+import warnings
+from datetime import datetime
+from datetime import timedelta
+from datetime import timezone
+
+import pytest
+
+from werkzeug import routing as r
+from werkzeug.datastructures import EnvironHeaders
+from werkzeug.datastructures import Headers
+from werkzeug.datastructures import HeaderSet
+from werkzeug.datastructures import LanguageAccept
+from werkzeug.datastructures import Range
+from werkzeug.datastructures import RequestCacheControl
+from werkzeug.datastructures import ResponseCacheControl
+from werkzeug.datastructures.structures import ImmutableList
+from werkzeug.exceptions import BadRequestKeyError
+from werkzeug.exceptions import RequestEntityTooLarge
+from werkzeug.exceptions import SecurityError
+from werkzeug.formparser import FormDataParser
+from werkzeug.http import http_date
+from werkzeug.sansio.utils import get_host
+from werkzeug.sansio.utils import host_is_trusted
+from werkzeug.test import Client
+from werkzeug.test import create_environ
+from werkzeug.wrappers import Request
+from werkzeug.wrappers import Response
+from werkzeug.wsgi import _RangeWrapper
+from werkzeug.wsgi import ClosingIterator
+from werkzeug.wsgi import LimitedStream
+
+
+def test_header_set_remove_case_insensitive() -> None:
+    hs = HeaderSet(["Foo", "bar"])
+    hs.remove("FOO")
+    assert list(hs) == ["bar"]
+    assert len(hs) == 1
+    assert "foo" not in hs
+    assert hs.to_header() == "bar"
+
+
+def test_header_set_init_duplicates() -> None:
+    hs = HeaderSet(["a", "A", "b"])
+    assert list(hs) == ["a", "b"]
+    assert len(hs) == len(list(hs))
+    hs.remove("a")
+    assert list(hs) == ["b"]
+
+
+def test_immutable_list_clear() -> None:
+    lst = ImmutableList([1, 2])
+
+    with pytest.raises(TypeError):
+        lst.clear()
+
+    assert lst == [1, 2]
+
+
+def test_headers_setlist_empty_iterator() -> None:
+    h = Headers([("X", "1")])
+    h.setlist("X", iter([]))
+    assert "X" not in h
+    h.setlist("Y", (v for v in ["a", "b"]))
+    assert h.getlist("Y") == ["a", "b"]
+
+
+def test_environ_headers_missing_is_bad_request() -> None:
+    headers = EnvironHeaders(create_environ())
+
+    with pytest.raises(BadRequestKeyError):
+        headers["X-Missing"]
+
+    with pytest.raises(BadRequestKeyError):
+        headers["Content-Type"]
+
+    assert headers.get("X-Missing") is None
+    assert "X-Missing" not in headers
+
+
+def test_range_suffix_longer_than_length() -> None:
+    rng = Range.from_header("bytes=-500")
+    assert rng is not None
+    assert rng.range_for_length(100) == (0, 100)
+    assert rng.to_content_range_header(100) == "bytes 0-99/100"
+
+
+def test_if_match_star_not_precondition_failed() -> None:
+    env = create_environ(headers={"If-Match": "*"})
+    rv = Response("data")
+    rv.set_etag("abc")
+    rv.make_conditional(env)
+    assert rv.status_code == 200
+
+    env = create_environ(headers={"If-Match": '"other"'})
+    rv = Response("data")
+    rv.set_etag("abc")
+    rv.make_conditional(env)
+    assert rv.status_code == 412
+
+
+def test_request_args_invalid_utf8() -> None:
+    env = create_environ()
+    env["QUERY_STRING"] = "a=\xff&b=1"
+    request = Request(env)
+    assert request.args["a"] == "%FF"
+    assert request.args["b"] == "1"
+    assert request.full_path == "/?a=%FF&b=1"
+
+
+def test_urlencoded_limit_unknown_length() -> None:
+    parser = FormDataParser(max_form_memory_size=10)
+
+    with pytest.raises(RequestEntityTooLarge):
+        parser.parse(
+            io.BytesIO(b"a=" + b"x" * 100),
+            "application/x-www-form-urlencoded",
+            content_length=None,
+        )
+
+    _, form, _ = parser.parse(
+        io.BytesIO(b"a=b"), "application/x-www-form-urlencoded", content_length=None
+    )
+    assert form["a"] == "b"
+
+
+def test_trusted_hosts_case_insensitive() -> None:
+    assert host_is_trusted("Example.COM", ["example.com"])
+    assert host_is_trusted("www.EXAMPLE.com:8080", [".Example.com"])
+    assert get_host("http", "EXAMPLE.com", None, ["example.com"]) == "EXAMPLE.com"
+
+    with pytest.raises(SecurityError):
+        get_host("http", "evil.com", None, ["example.com"])
+
+
+def test_header_property_set_none_removes() -> None:
+    rv = Response()
+    rv.content_length = 10
+    rv.content_length = None
+    assert "Content-Length" not in rv.headers
+    rv.age = 10
+    rv.age = None
+    assert "Age" not in rv.headers
+    rv.location = "/a"
+    rv.location = None
+    assert "Location" not in rv.headers
+    rv.date = None
+    assert "Date" not in rv.headers
+
+
+def test_float_converter_build_round_trips() -> None:
+    m = r.Map([r.Rule("/<float:v>", endpoint="f")])
+    a = m.bind("example.org")
+
+    for value in (1.0, 0.12345678, 1e-9, 123456789.5, 1e20):
+        url = a.build("f", {"v": value})
+        assert "e" not in url
