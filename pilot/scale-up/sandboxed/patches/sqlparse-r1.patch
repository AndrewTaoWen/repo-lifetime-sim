+@pytest.mark.parametrize('s', [
+    'select cast(a as) from t',
+    'select ( as )',
+    'select f( := )',
+])
+def test_incomplete_alias_or_assignment_keeps_parenthesis(s):
+    p = sqlparse.parse(s)[0]
+    assert str(p) == s
+    parens = []
+
+    def walk(tl):
+        for t in tl.get_sublists():
+            if isinstance(t, sql.Parenthesis):
+                parens.append(t)
+            walk(t)
+    walk(p)
+    assert parens
+    for paren in parens:
+        assert paren.tokens[0].match(T.Punctuation, '(')
+        assert paren.tokens[-1].match(T.Punctuation, ')')
+    # formatting must not crash
+    sqlparse.format(s, reindent=True)
+    sqlparse.format(s, strip_whitespace=True)
+
