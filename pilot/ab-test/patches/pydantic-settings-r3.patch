diff --git a/tests/test_regressions.py b/tests/test_regressions.py
new file mode 100644
index 0000000..71e2b42
--- /dev/null
+++ b/tests/test_regressions.py
@@ -0,0 +1,213 @@
+"""Regression tests for assorted bug fixes."""
+
+import sys
+from enum import Enum, IntEnum
+from typing import Optional, Union
+
+import pytest
+from pydantic import BaseModel, Field
+
+from pydantic_settings import (
+    BaseSettings,
+    CliApp,
+    CliSubCommand,
+    CliUnknownArgs,
+    JsonConfigSettingsSource,
+    NoDecode,
+    PyprojectTomlConfigSettingsSource,
+    SettingsConfigDict,
+    SettingsError,
+    YamlConfigSettingsSource,
+)
+from pydantic_settings.sources import NestedSecretsSettingsSource, SecretsSettingsSource
+from pydantic_settings.sources.utils import _get_field_metadata
+
+try:
+    import yaml
+except ImportError:
+    yaml = None
+
+
+class _Sub(BaseModel):
+    Val: int
+
+
+def test_case_insensitive_union_none_first(env):
+    class Settings(BaseSettings):
+        model_config = SettingsConfigDict(env_nested_delimiter='__')
+        nested: Union[None, _Sub] = None
+
+    env.set('NESTED__VAL', '3')
+    assert Settings().nested == _Sub(Val=3)
+
+
+def test_case_insensitive_optional_sub_sub_model(env):
+    class SubSub(BaseModel):
+        Deep: int
+
+    class Sub(BaseModel):
+        Inner: Optional[SubSub] = None
+
+    class Settings(BaseSettings):
+        model_config = SettingsConfigDict(env_nested_delimiter='__')
+        nested: Sub = Sub()
+
+    env.set('NESTED__INNER__DEEP', '5')
+    assert Settings().nested.Inner == SubSub(Deep=5)
+
+
+def test_dotenv_extra_with_uppercase_prefix(tmp_path):
+    p = tmp_path / '.env'
+    p.write_text('APP_FOO=bar\nAPP_X=1\n')
+
+    class Settings(BaseSettings):
+        model_config = SettingsConfigDict(env_prefix='APP_', env_file=p, extra='allow')
+        x: int = 0
+
+    assert Settings().model_dump() == {'x': 1, 'foo': 'bar'}
+
+
+@pytest.mark.skipif(sys.version_info < (3, 12), reason='type statement requires 3.12')
+def test_get_field_metadata_does_not_mutate_field():
+    ns: dict = {}
+    exec('from typing import Annotated\nfrom pydantic_settings import NoDecode\ntype L = Annotated[list[int], NoDecode]', ns)
+
+    class Settings(BaseSettings):
+        x: ns['L'] = Field(default=[], min_length=0)
+
+    field = Settings.model_fields['x']
+    before = list(field.metadata)
+    for _ in range(3):
+        assert NoDecode in _get_field_metadata(field)
+    assert field.metadata == before
+
+
+def test_nested_secrets_dir_with_glob_chars(tmp_path):
+    d = tmp_path / 'sec[1]'
+    d.mkdir()
+    (d / 'foo').write_text('bar')
+
+    class Settings(BaseSettings):
+        model_config = SettingsConfigDict(secrets_dir=d)
+        foo: str = 'default'
+
+        @classmethod
+        def settings_customise_sources(cls, settings_cls, init_settings, env_settings, dotenv_settings, file_secret_settings):
+            return (NestedSecretsSettingsSource(file_secret_settings),)
+
+    assert Settings().foo == 'bar'
+
+
+def test_secrets_exact_case_match_preferred(tmp_path):
+    (tmp_path / 'FOO').write_text('upper')
+    (tmp_path / 'foo').write_text('lower')
+    if len(list(tmp_path.iterdir())) != 2:
+        pytest.skip('case-insensitive filesystem')
+    assert SecretsSettingsSource.find_case_path(tmp_path, 'foo', False).name == 'foo'
+    assert SecretsSettingsSource.find_case_path(tmp_path, 'FOO', False).name == 'FOO'
+    assert SecretsSettingsSource.find_case_path(tmp_path, 'Foo', True) is None
+
+
+class _JsonSettings(BaseSettings):
+    x: int = 1
+
+
+def test_json_null_file_is_empty(tmp_path):
+    p = tmp_path / 'a.json'
+    p.write_text('null')
+    assert JsonConfigSettingsSource(_JsonSettings, json_file=p)() == {}
+
+
+def test_json_non_mapping_file_raises_settings_error(tmp_path):
+    p = tmp_path / 'a.json'
+    p.write_text('[1, 2]')
+    with pytest.raises(SettingsError, match='must contain a mapping'):
+        JsonConfigSettingsSource(_JsonSettings, json_file=p)
+
+
+@pytest.mark.skipif(yaml is None, reason='pyyaml not installed')
+def test_yaml_empty_config_section(tmp_path):
+    p = tmp_path / 'a.yaml'
+    p.write_text('app:\nother: 1\n')
+    assert YamlConfigSettingsSource(_JsonSettings, yaml_file=p, yaml_config_section='app')() == {}
+
+
+def test_pyproject_accepts_str_path(tmp_path):
+    p = tmp_path / 'pyproject.toml'
+    p.write_text('[tool.pydantic-settings]\nx = 5\n')
+    assert PyprojectTomlConfigSettingsSource(_JsonSettings, toml_file=str(p))() == {'x': 5}
+
+
+class _CliLists(BaseSettings):
+    model_config = SettingsConfigDict(cli_exit_on_error=False)
+    strs: list[str] = ['default']
+    nums: list[int] = [1]
+
+
+def test_cli_empty_list():
+    assert CliApp.run(_CliLists, cli_args=['--strs', '[]', '--nums', '[]']).model_dump() == {'strs': [], 'nums': []}
+
+
+def test_cli_list_str_escaped_quote_and_bools():
+    assert CliApp.run(_CliLists, cli_args=['--strs', '"a\\"b"']).strs == ['a"b']
+    assert CliApp.run(_CliLists, cli_args=['--strs', 'a\\b']).strs == ['a\\b']
+    assert CliApp.run(_CliLists, cli_args=['--strs', 'true,false']).strs == ['true', 'false']
+
+
+class _Color(Enum):
+    RED = 'red'
+    BLUE = 'blue'
+
+
+class _Num(IntEnum):
+    A = 1
+    B = 2
+
+
+class _Inner(BaseModel):
+    a: int = 0
+
+
+class _Ser(BaseSettings):
+    st: set[int] = set()
+    tp: tuple[int, ...] = ()
+    opt: Optional[int] = 5
+    color: _Color = _Color.RED
+    num: _Num = _Num.A
+    inner_list: list[_Inner] = []
+
+
+@pytest.mark.parametrize('list_style', ['json', 'argparse', 'lazy'])
+@pytest.mark.parametrize(
+    'model',
+    [
+        _Ser(st={1, 2}),
+        _Ser(tp=(1, 2)),
+        _Ser(opt=None),
+        _Ser(color=_Color.BLUE),
+        _Ser(num=_Num.B),
+        _Ser(inner_list=[_Inner(a=1), _Inner(a=2)]),
+    ],
+)
+def test_cli_serialize_round_trip(model, list_style):
+    args = CliApp.serialize(model, list_style=list_style)
+    assert CliApp.run(_Ser, cli_args=args) == model
+
+
+def test_cli_unknown_args_not_accepted_by_similarly_named_subcommand():
+    class A(BaseModel):
+        extras: CliUnknownArgs
+
+    class AB(BaseModel):
+        x: int = 0
+
+    class Root(BaseSettings):
+        model_config = SettingsConfigDict(cli_exit_on_error=False)
+        a: CliSubCommand[A]
+        ab: CliSubCommand[AB]
+
+    assert CliApp.run(Root, cli_args=['a', '--foo']).a.extras == ['--foo']
+    with pytest.raises(SettingsError, match='unrecognized arguments: --foo'):
+        CliApp.run(Root, cli_args=['ab', '--foo'])
+
+
