+++ b/tests/test_regressions.py
@@ -0,0 +1,301 @@
+"""Regression tests for assorted bug fixes."""
+
+import datetime as dt
+import enum
+
+import pytest
+
+from marshmallow import (
+    INCLUDE,
+    Schema,
+    ValidationError,
+    class_registry,
+    fields,
+    post_dump,
+    post_load,
+    pre_load,
+    validate,
+    validates,
+    validates_schema,
+)
+from marshmallow.experimental.context import Context
+from marshmallow.orderedset import OrderedSet
+
+
+class TestFieldValidatorsWithAttribute:
+    def test_invalid_value_removed_from_valid_data_when_attribute_set(self):
+        class MySchema(Schema):
+            n = fields.Str(attribute="name")
+
+            @validates("n")
+            def validate_n(self, value, **kwargs):
+                raise ValidationError("bad")
+
+        with pytest.raises(ValidationError) as excinfo:
+            MySchema().load({"n": "x"})
+        assert excinfo.value.messages == {"n": ["bad"]}
+        assert excinfo.value.valid_data == {}
+
+    def test_invalid_value_removed_many(self):
+        class MySchema(Schema):
+            n = fields.Str(attribute="name")
+
+            @validates("n")
+            def validate_n(self, value, **kwargs):
+                if value == "bad":
+                    raise ValidationError("bad")
+
+        with pytest.raises(ValidationError) as excinfo:
+            MySchema(many=True).load([{"n": "ok"}, {"n": "bad"}])
+        assert excinfo.value.messages == {1: {"n": ["bad"]}}
+        assert excinfo.value.valid_data == [{"name": "ok"}, {}]
+
+    def test_validator_runs_for_dotted_attribute(self):
+        class MySchema(Schema):
+            n = fields.Str(attribute="profile.name")
+
+            @validates("n")
+            def validate_n(self, value, **kwargs):
+                if value != "good":
+                    raise ValidationError("bad")
+
+        assert MySchema().load({"n": "good"}) == {"profile": {"name": "good"}}
+        with pytest.raises(ValidationError) as excinfo:
+            MySchema().load({"n": "x"})
+        assert excinfo.value.messages == {"n": ["bad"]}
+        assert excinfo.value.valid_data == {"profile": {}}
+
+    def test_validator_not_called_with_missing_value_named_like_dict_method(self):
+        calls = []
+
+        class MySchema(Schema):
+            items = fields.Str()
+
+            @validates("items")
+            def validate_items(self, value, **kwargs):
+                calls.append(value)
+
+        assert MySchema().load({}) == {}
+        assert calls == []
+
+
+class TestSchemaValidatorsAndProcessorsMany:
+    def test_schema_validator_many_with_invalid_collection_type(self):
+        class MySchema(Schema):
+            a = fields.Int()
+
+            @validates_schema(skip_on_field_errors=False)
+            def check(self, data, **kwargs):
+                pass
+
+        with pytest.raises(ValidationError) as excinfo:
+            MySchema().load({"a": 1}, many=True)
+        assert excinfo.value.messages == {"_schema": ["Invalid input type."]}
+
+    def test_pre_load_changing_collection_length(self):
+        originals = []
+
+        class MySchema(Schema):
+            a = fields.Int()
+
+            @pre_load(pass_collection=True)
+            def keep_first(self, data, many, **kwargs):
+                return data[:1] if many else data
+
+            @validates_schema(pass_original=True)
+            def check(self, data, original, **kwargs):
+                originals.append(original)
+
+            @post_load(pass_original=True)
+            def post(self, data, original, **kwargs):
+                assert data is not None
+                return data
+
+        assert MySchema().load([{"a": 1}, {"a": 2}], many=True) == [{"a": 1}]
+        assert originals == [{"a": 1}]
+
+    def test_post_dump_pass_original_with_generator(self):
+        class MySchema(Schema):
+            a = fields.Int()
+
+            @post_dump(pass_original=True)
+            def add_original(self, data, original, **kwargs):
+                data["orig"] = original
+                return data
+
+        objs = ({"a": i} for i in range(2))
+        assert MySchema().dump(objs, many=True) == [
+            {"a": 0, "orig": {"a": 0}},
+            {"a": 1, "orig": {"a": 1}},
+        ]
+
+
+class TestSchemaOptionValidation:
+    def test_only_with_unknown_nested_parent_raises_value_error(self):
+        class MySchema(Schema):
+            a = fields.Int()
+
+        with pytest.raises(ValueError, match="Invalid fields"):
+            MySchema(only=("zz.y",))
+
+    def test_exclude_with_unknown_nested_parent_raises_value_error(self):
+        class MySchema(Schema):
+            a = fields.Int()
+
+        with pytest.raises(ValueError, match="Invalid fields"):
+            MySchema(exclude=("zz.y",))
+
+    def test_meta_fields_with_undeclared_field_raises_value_error(self):
+        class MySchema(Schema):
+            a = fields.Int()
+
+            class Meta:
+                fields = ("a", "b")
+
+        with pytest.raises(ValueError, match="Invalid fields"):
+            MySchema()
+
+    def test_unknown_include_does_not_overwrite_loaded_field(self):
+        class MySchema(Schema):
+            a = fields.Int(data_key="b")
+
+        result = MySchema().load({"b": 1, "a": "not-an-int"}, unknown=INCLUDE)
+        assert result == {"a": 1}
+
+    def test_unknown_include_still_includes_unknown(self):
+        class MySchema(Schema):
+            a = fields.Int()
+
+        assert MySchema().load({"a": 1, "z": 2}, unknown=INCLUDE) == {
+            "a": 1,
+            "z": 2,
+        }
+
+
+class TestNestedSchemaCache:
+    def test_cached_schema_not_shared_between_schema_instances(self):
+        class Child(Schema):
+            id = fields.Int()
+            name = fields.Str()
+
+        class Parent(Schema):
+            child = fields.Nested(Child)
+
+        # Accessing the nested schema on the class-level field caches it
+        assert Parent._declared_fields["child"].schema is not None
+
+        obj = {"child": {"id": 1, "name": "a"}}
+        assert Parent(only=("child.id",)).dump(obj) == {"child": {"id": 1}}
+        assert Parent(exclude=("child.name",)).dump(obj) == {"child": {"id": 1}}
+        assert Parent().dump(obj) == obj
+
+
+class TestFieldFixes:
+    @pytest.mark.parametrize("value", ["nan", float("nan"), "-nan"])
+    def test_timedelta_nan_is_invalid(self, value):
+        with pytest.raises(ValidationError, match="Not a valid period of time."):
+            fields.TimeDelta().deserialize(value)
+
+    def test_date_rejects_datetime(self):
+        with pytest.raises(ValidationError, match="Not a valid date."):
+            fields.Date().deserialize(dt.datetime(2020, 1, 1, 5))
+        assert fields.Date().deserialize(dt.date(2020, 1, 1)) == dt.date(2020, 1, 1)
+
+    def test_function_without_serialize_is_skipped_on_dump(self):
+        class MySchema(Schema):
+            f = fields.Function()
+
+        assert MySchema().dump({"f": 1}) == {}
+        assert MySchema().load({"f": 1}) == {"f": 1}
+
+
+class TestValidatorFixes:
+    def test_one_of_with_generator(self):
+        validator = validate.OneOf(x for x in ("a", "b"))
+        assert validator("a") == "a"
+        assert validator("b") == "b"
+        with pytest.raises(ValidationError):
+            validator("c")
+        assert list(validator.options()) == [("a", ""), ("b", "")]
+
+    def test_one_of_with_generator_labels(self):
+        validator = validate.OneOf(["a", "b"], labels=(x for x in ("A", "B")))
+        assert validator.labels_text == "A, B"
+        assert list(validator.options()) == [("a", "A"), ("b", "B")]
+
+    def test_one_of_with_enum_generator(self):
+        class Color(enum.Enum):
+            RED = "red"
+
+        validator = validate.OneOf(c.value for c in Color)
+        assert validator("red") == "red"
+
+    def test_none_of_with_generator(self):
+        validator = validate.NoneOf(x for x in ("a", "b"))
+        with pytest.raises(ValidationError):
+            validator("a")
+        assert validator("c") == "c"
+
+    def test_contains_only_unhashable_element(self):
+        validator = validate.ContainsOnly({"a", "b"})
+        with pytest.raises(ValidationError):
+            validator(["a", ["x"]])
+
+    def test_contains_none_of_unhashable_element(self):
+        validator = validate.ContainsNoneOf({"a", "b"})
+        assert validator([["x"]]) == [["x"]]
+        with pytest.raises(ValidationError):
+            validator([["x"], "a"])
