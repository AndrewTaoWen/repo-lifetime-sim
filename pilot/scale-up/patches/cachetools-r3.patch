+    def test_ttu_expired_update(self):
+        # setting an already expired value must not leave a previous
+        # value for the same key in the cache
+        cache = TLRUCache(maxsize=2, ttu=lambda _k, v, t: t + v, timer=Timer())
+        cache[1] = 10
+        cache[2] = 10
+        self.assertEqual(10, cache[1])
+        cache[1] = 0
+        self.assertNotIn(1, cache)
+        self.assertIsNone(cache.get(1))
+        self.assertEqual(1, len(cache))
+        self.assertEqual(1, cache.currsize)
