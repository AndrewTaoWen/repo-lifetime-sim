+@pytest.mark.parametrize('value, expected', [
+    ('False', False), ('false', False), ('0', False), ('True', True)])
+def test_cli_bool_options(value, expected):
+    parser = sqlparse.cli.create_parser()
+    args = parser.parse_args(['x.sql', '--comma_first', value,
+                              '--compact', value])
+    assert args.comma_first is expected
+    assert args.compact is expected
+
