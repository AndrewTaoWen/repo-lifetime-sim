+def test_limited_stream_short_read_into_memoryview():
+    class OneByte(io.RawIOBase):
+        def __init__(self):
+            self.data = io.BytesIO(b"abcdefghij")
+
+        def readable(self):
+            return True
+
+        def readinto(self, b):
+            return self.data.readinto(memoryview(b)[:1])
+
+    stream = wsgi.LimitedStream(OneByte(), 5)
+    buf = bytearray(10)
+    assert stream.readinto(memoryview(buf)) == 1
+    assert buf[:1] == b"a"
+    assert io.BufferedReader(wsgi.LimitedStream(OneByte(), 5)).read() == b"abcde"
