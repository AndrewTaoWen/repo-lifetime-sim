+def test_missing_args_warning_points_to_caller(pm: PluginManager) -> None:
+    class Api:
+        @hookspec
+        def hello(self, arg: object) -> None:
+            "api hook 1"
+
+    pm.add_hookspecs(Api)
+    with pytest.warns(UserWarning, match="cannot be found") as record:
+        pm.hook.hello()
+    with pytest.warns(UserWarning, match="cannot be found") as record2:
+        pm.hook.hello.call_extra([], {})
+    for rec in (*record, *record2):
+        assert rec.filename == __file__
diff --git a/testing/test_pluginmanager.py b/testing/test_pluginmanager.py
