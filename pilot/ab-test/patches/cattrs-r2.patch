+++ b/tests/test_regressions_hardening.py
@@ -0,0 +1,378 @@
+"""Regression tests for assorted latent bugs."""
+
+from __future__ import annotations
+
+from collections import Counter
+from dataclasses import dataclass, field
+from enum import Enum
+from typing import (
+    Annotated,
+    Generic,
+    Literal,
+    NamedTuple,
+    TypedDict,
+    TypeVar,
+    Union,
+)
+
+import attrs
+import pytest
+from attrs import define
+from typing_extensions import NotRequired
+
+from cattrs import BaseConverter, Converter
+from cattrs.dispatch import FunctionDispatch
+from cattrs.errors import CattrsError, ForbiddenExtraKeysError
+from cattrs.gen import make_dict_structure_fn, make_dict_unstructure_fn, override
+from cattrs.gen.typeddicts import make_dict_structure_fn as td_structure_fn
+from cattrs.strategies import include_subclasses
+from cattrs.subclasses import subclasses
+from cattrs.v import format_exception
+
+T = TypeVar("T")
+
+
+@define
+class Simple:
+    a: int
+
+
+@pytest.mark.parametrize("converter_cls", [BaseConverter, Converter])
+def test_factory_decorators_return_factory(converter_cls):
+    """Hook factory decorators return the decorated factory."""
+    c = converter_cls()
+
+    def unstruct_factory(_):
+        return lambda _: "u"
+
+    def struct_factory(_):
+        return lambda _, __: "s"
+
+    assert (
+        c.register_unstructure_hook_factory(lambda t: t is Simple)(unstruct_factory)
+        is unstruct_factory
+    )
+    assert (
+        c.register_structure_hook_factory(lambda t: t is Simple)(struct_factory)
+        is struct_factory
+    )
+    assert c.unstructure(Simple(1)) == "u"
+    assert c.structure({}, Simple) == "s"
+
+
+@pytest.mark.parametrize("converter_cls", [BaseConverter, Converter])
+def test_copy_keeps_fallbacks_and_union_hooks(converter_cls):
+    """Copies keep fallback factories and union structure hooks."""
+
+    class Unknown:
+        pass
+
+    c = converter_cls(
+        structure_fallback_factory=lambda _: lambda v, _: "fallback",
+        unstructure_fallback_factory=lambda _: lambda v: "ufallback",
+    )
+    c.register_structure_hook(Union[int, str], lambda v, _: "union")
+
+    copy = c.copy()
+    assert copy.structure(1, Unknown) == "fallback"
+    assert copy.unstructure(Unknown()) == "ufallback"
+    assert copy.structure(1, Union[int, str]) == "union"
+
+
+def test_function_dispatch_copy_to_no_skip():
+    """`FunctionDispatch.copy_to` with the default `skip` copies everything."""
+    src = FunctionDispatch(Converter())
+    src.register(lambda _: True, lambda: None)
+    dst = FunctionDispatch(Converter())
+    src.copy_to(dst)
+    assert dst.get_num_fns() == 1
+
+
+class NT(NamedTuple):  # stringified annotations, due to the __future__ import
+    a: int
+    b: Simple
+
+
+class NTSub(NT):
+    pass
+
+
+@pytest.mark.parametrize("cl", [NT, NTSub])
+def test_namedtuple_stringified_and_subclass(cl):
+    """Namedtuples with stringified annotations and subclasses work."""
+    c = Converter()
+    assert c.structure(["1", {"a": "2"}], cl) == cl(1, Simple(2))
+    assert c.unstructure(cl(1, Simple(2))) == (1, {"a": 2})
+
+
+class Color(Enum):
+    RED = "red"
+
+
+def test_counter_key_unstructuring():
+    """Counter keys are unstructured using the key type."""
+    c = Converter()
+    assert c.unstructure(Counter({Color.RED: 2}), Counter[Color]) == {"red": 2}
+
+
+@pytest.mark.parametrize("detailed_validation", [True, False])
+@pytest.mark.parametrize("name", ["it's", 'a"b', "back\\slash"])
+def test_rename_with_special_chars(name, detailed_validation):
+    """Renames with quotes and backslashes generate valid code."""
+    c = Converter(detailed_validation=detailed_validation)
+
+    @define
+    class A:
+        a: int
+        b: int = 0
+
+    unstruct = make_dict_unstructure_fn(A, c, a=override(rename=name))
+    struct = make_dict_structure_fn(
+        A, c, a=override(rename=name), b=override(rename=name + "b")
+    )
+    assert unstruct(A(1)) == {name: 1, "b": 0}
+    assert struct({name: "1", name + "b": "2"}, A) == A(1, 2)
+
+    TD = TypedDict("TD", {name: int})
+    td_struct = td_structure_fn(TD, c)
+    assert td_struct({name: "1"}, TD) == {name: 1}
+
+
+class TDAnnotatedOutside(TypedDict):
+    a: Annotated[NotRequired[int], override(rename="b")]
+
+
+class TDAnnotatedInside(TypedDict):
+    a: NotRequired[Annotated[int, override(rename="b")]]
+
+
+@pytest.mark.parametrize("detailed_validation", [True, False])
+@pytest.mark.parametrize("cl", [TDAnnotatedOutside, TDAnnotatedInside])
+def test_typeddict_annotated_notrequired_override(cl, detailed_validation):
+    """Overrides in `Annotated` around `NotRequired` are honored."""
+    c = Converter(detailed_validation=detailed_validation)
+    assert c.unstructure({"a": 1}, cl) == {"b": 1}
+    assert c.structure({"b": "1"}, cl) == {"a": 1}
+
+
+@pytest.mark.parametrize("detailed_validation", [True, False])
+def test_typeddict_rename_to_same_name(detailed_validation):
+    """Renaming a TypedDict field to its own name doesn't drop it."""
+
+    class TD(TypedDict):
+        a: int
+
+    c = Converter(detailed_validation=detailed_validation)
+    fn = td_structure_fn(TD, c, a=override(rename="a"))
+    assert fn({"a": "1"}, TD) == {"a": 1}
+
+
+class TypedValueEnum(Enum):
+    _value_: int  # stringified, due to the __future__ import
+    A = 1
+
+
+def test_enum_value_stringified_annotation():
+    """Stringified `_value_` annotations are resolved."""
+    c = Converter()
+    assert c.structure("1", TypedValueEnum) is TypedValueEnum.A
+    assert c.unstructure(TypedValueEnum.A) == 1
+
+
+def test_format_exception_without_args():
+    """`format_exception` handles exceptions without arguments."""
