+def _get_override(
+    type: Any, name: str, kwargs: dict[str, AttributeOverride]
+) -> AttributeOverride:
+    """Find the override for a TypedDict field.
+
+    Explicit overrides take precedence. Otherwise, look for an override in
+    `Annotated` metadata, both outside and inside `(Not)Required`.
+    Overrides found in annotations are stored into `kwargs`.
+    """
+    if name in kwargs:
+        return kwargs[name]
+    override = _annotated_override_or_default(type, neutral)
+    if override == neutral:
+        nrb = get_notrequired_base(type)
+        if nrb is not NOTHING:
+            override = _annotated_override_or_default(nrb, neutral)
+    if override != neutral:
+        kwargs[name] = override
+    return override
+
