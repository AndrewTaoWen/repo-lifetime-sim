+def test_rule_factories_keep_options():
+    def check(rule: r.Rule) -> None:
+        assert rule.websocket
+        assert rule.merge_slashes is False
+
+    base = r.Rule("/ws", endpoint="ws", websocket=True, merge_slashes=False)
+    check(base.empty())
+
+    m = r.Map([r.Submount("/x", [base.empty()])])
+    check(next(m.iter_rules()))
+
+    template = r.RuleTemplate(
+        [r.Rule("/$n", endpoint="$n", websocket=True, merge_slashes=False)]
+    )
+    m = r.Map([template(n="y")])
+    check(next(m.iter_rules()))
+
+
+def test_rule_template_keeps_redirect_alias_host():
+    template = r.RuleTemplate(
+        [r.Rule("/$n", endpoint="$n", redirect_to="/b", alias=True, host="$n.test")]
+    )
+    rule = next(r.Map([template(n="y")], host_matching=True).iter_rules())
+    assert rule.redirect_to == "/b"
+    assert rule.alias
+    assert rule.host == "y.test"
+
