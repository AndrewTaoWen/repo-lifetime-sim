+def test_proxy_fix_ignores_quotes():
+    """A client can't send an unclosed quote to discard values appended by
+    the trusted proxies.
+    """
+    seen = {}
+
+    @Request.application
+    def app(request):
+        seen["remote_addr"] = request.remote_addr
+        seen["host"] = request.host
+        return Response("")
+
+    app = ProxyFix(app, x_for=1, x_host=1)
+    environ = create_environ(
+        environ_overrides={
+            "REMOTE_ADDR": "127.0.0.1",
+            "HTTP_X_FORWARDED_FOR": '1.2.3.4", 9.9.9.9',
+            "HTTP_X_FORWARDED_HOST": '"evil, example.com',
+        }
+    )
+    Client(app).open(environ)
+    assert seen["remote_addr"] == "9.9.9.9"
+    assert seen["host"] == "example.com"
