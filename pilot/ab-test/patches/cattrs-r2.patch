+def test_unhashable_annotated_metadata():
+    """`Annotated` types with unhashable metadata work."""
+    c = Converter(type_overrides={int: override()})
+    inst = WithUnhashableMetadata(1, [2])
+    assert c.structure({"x": "1", "y": ["2"]}, WithUnhashableMetadata) == inst
+    assert c.unstructure(inst) == {"x": 1, "y": [2]}
+    assert c.structure("1", Annotated[int, {"doc": "x"}]) == 1
