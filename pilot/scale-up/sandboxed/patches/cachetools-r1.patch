@@ -87,3 +87,18 @@ class LRUCacheTest(unittest.TestCase, CacheTestMixin):
         self.assertIn(3, cache)
         self.assertIn(5, cache)
         self.assertNotIn(4, cache)
+
+    def test_lru_update_no_unneeded_eviction(self):
+        cache = LRUCache[str, int](maxsize=10, getsizeof=lambda v: v)
+
+        cache["a"] = 2
+        cache["b"] = 2
+        # growing "b" from 2 to 7 still fits: 2 + 7 <= 10
+        cache["b"] = 7
+        self.assertEqual({"a": 2, "b": 7}, dict(cache))
+        self.assertEqual(9, cache.currsize)
+
+        # growing "b" to 9 requires evicting "a"
+        cache["b"] = 9
+        self.assertEqual({"b": 9}, dict(cache))
+        self.assertEqual(9, cache.currsize)
