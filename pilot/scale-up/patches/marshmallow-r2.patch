diff --git a/tests/test_hardening.py b/tests/test_hardening.py
new file mode 100644
index 0000000..11ef9c1
--- /dev/null
+++ b/tests/test_hardening.py
@@ -0,0 +1,277 @@
+"""Regression tests for latent bugs fixed during a hardening pass."""
+
+import datetime as dt
+
+import pytest
+
+from marshmallow import (
+    Schema,
+    ValidationError,
+    class_registry,
+    fields,
+    post_dump,
+    post_load,
+    pre_dump,
+    pre_load,
+    validate,
+    validates,
+    validates_schema,
+)
+from marshmallow.experimental.context import Context
+from marshmallow.orderedset import OrderedSet
+
+# Fields
+
+
+@pytest.mark.parametrize("value", ["nan", float("nan"), "-nan"])
+def test_timedelta_nan_raises_validation_error(value):
+    with pytest.raises(ValidationError, match="Not a valid period of time."):
+        fields.TimeDelta().deserialize(value)
+
+
+def test_date_field_rejects_datetime():
+    field = fields.Date()
+    with pytest.raises(ValidationError, match="Not a valid date."):
+        field.deserialize(dt.datetime(2020, 1, 1, 5, 30))
+    # date objects are still accepted
+    assert field.deserialize(dt.date(2020, 1, 1)) == dt.date(2020, 1, 1)
+
+
+def test_dict_field_error_messages_are_plain_dict():
+    field = fields.Dict(keys=fields.Int(), values=fields.Int())
+    with pytest.raises(ValidationError) as excinfo:
+        field.deserialize({"a": 1})
+    assert type(excinfo.value.messages) is dict
+    assert excinfo.value.messages == {"a": {"key": ["Not a valid integer."]}}
+
+
+# Validators
+
+
+def test_oneof_accepts_generator_choices():
+    validator = validate.OneOf(c for c in ("a", "b"))
+    assert validator("a") == "a"
+    assert validator("b") == "b"
+    with pytest.raises(ValidationError, match="Must be one of: a, b."):
+        validator("c")
+
+
+def test_oneof_options_with_generator_labels():
+    validator = validate.OneOf([1, 2], labels=(label for label in ("one", "two")))
+    assert list(validator.options()) == [("1", "one"), ("2", "two")]
+
+
+def test_noneof_accepts_generator_iterable():
+    validator = validate.NoneOf(c for c in ("a", "b"))
+    with pytest.raises(ValidationError):
+        validator("a")
+    assert validator("c") == "c"
+
+
+def test_contains_only_accepts_generator_choices():
+    validator = validate.ContainsOnly(c for c in ("a", "b"))
+    assert validator(["a", "b"]) == ["a", "b"]
+    with pytest.raises(ValidationError):
+        validator(["c"])
+
+
+def test_contains_only_unhashable_value_with_set_choices():
+    validator = validate.ContainsOnly({"a", "b"})
+    with pytest.raises(ValidationError):
+        validator([["a"]])
+
+
+def test_contains_none_of_unhashable_value_with_set_iterable():
+    validator = validate.ContainsNoneOf({"a", "b"})
+    assert validator([["a"]]) == [["a"]]
+    with pytest.raises(ValidationError):
+        validator(["a"])
+
+
+# Schema: validates
+
+
+def test_validates_with_attribute_removes_invalid_value_from_valid_data():
+    class MySchema(Schema):
+        x = fields.Int(attribute="y")
+        z = fields.Int()
+
+        @validates("x")
+        def validate_x(self, value, data_key):
+            raise ValidationError("bad")
+
+    with pytest.raises(ValidationError) as excinfo:
+        MySchema().load({"x": 1, "z": 2})
+    assert excinfo.value.messages == {"x": ["bad"]}
+    assert excinfo.value.valid_data == {"z": 2}
+
+    with pytest.raises(ValidationError) as excinfo:
+        MySchema(many=True).load([{"x": 1, "z": 2}])
+    assert excinfo.value.valid_data == [{"z": 2}]
+
+
+def test_validates_with_dotted_attribute_is_called():
+    class MySchema(Schema):
+        x = fields.Int(attribute="a.b")
+
+        @validates("x")
+        def validate_x(self, value, data_key):
+            if value < 0:
+                raise ValidationError("negative")
+
+    assert MySchema().load({"x": 1}) == {"a": {"b": 1}}
+    with pytest.raises(ValidationError) as excinfo:
+        MySchema().load({"x": -1})
+    assert excinfo.value.messages == {"x": ["negative"]}
+    assert excinfo.value.valid_data == {"a": {}}
+
+    with pytest.raises(ValidationError) as excinfo:
+        MySchema(many=True).load([{"x": 1}, {"x": -1}])
+    assert excinfo.value.messages == {1: {"x": ["negative"]}}
+
+
+# Schema: validates_schema / processors with many=True
+
+
+def test_validates_schema_many_with_non_list_input_does_not_crash():
+    class MySchema(Schema):
+        x = fields.Int()
+
+        @validates_schema(skip_on_field_errors=False, pass_original=True)
+        def check(self, data, original, **kwargs):
+            pass
+
+    with pytest.raises(ValidationError) as excinfo:
+        MySchema().load({"x": 1, "y": 2}, many=True)
+    assert excinfo.value.messages == {"_schema": ["Invalid input type."]}
+
+
+def test_validates_schema_many_with_filtering_pre_load():
+    calls = []
+
+    class MySchema(Schema):
+        x = fields.Int()
+
+        @pre_load(pass_collection=True)
+        def drop_empty(self, data, **kwargs):
+            return [item for item in data if item]
+
+        @validates_schema(pass_original=True)
+        def check(self, data, original, **kwargs):
+            calls.append((data, original))
+
+    assert MySchema().load([{"x": 1}, {}], many=True) == [{"x": 1}]
+    assert calls == [({"x": 1}, {"x": 1})]
+
+
+def test_post_load_pass_original_many_with_filtering_pre_load():
+    class MySchema(Schema):
+        x = fields.Int()
+
+        @pre_load(pass_collection=True)
+        def drop_empty(self, data, **kwargs):
+            return [item for item in data if item]
+
+        @post_load(pass_original=True)
+        def wrap(self, data, original, **kwargs):
+            return {"data": data, "original": original}
+
+    result = MySchema().load([{"x": 1}, {}], many=True)
+    assert result == [{"data": {"x": 1}, "original": {"x": 1}}]
+
+
+def test_post_dump_pass_original_many_with_filtering_pre_dump():
+    class MySchema(Schema):
+        x = fields.Int()
+
+        @pre_dump(pass_collection=True)
+        def drop_empty(self, data, **kwargs):
+            return [item for item in data if item]
+
+        @post_dump(pass_original=True)
+        def wrap(self, data, original, **kwargs):
+            return {"data": data, "original": original}
+
+    result = MySchema().dump([{"x": 1}, {}], many=True)
+    assert result == [{"data": {"x": 1}, "original": {"x": 1}}]
+
+
+def test_post_dump_pass_original_many_with_generator():
+    class MySchema(Schema):
+        x = fields.Int()
+
+        @post_dump(pass_original=True)
+        def wrap(self, data, original, **kwargs):
+            return data
+
+    result = MySchema().dump(({"x": i} for i in range(2)), many=True)
+    assert result == [{"x": 0}, {"x": 1}]
+
+
+# Schema: option validation
+
+
+def test_meta_fields_with_undeclared_field_raises_value_error():
+    class MySchema(Schema):
+        a = fields.Int()
+
+        class Meta:
+            fields = ("a", "b")
+
+    with pytest.raises(ValueError, match="'b'"):
+        MySchema()
+    # Excluding the undeclared name makes the schema valid
+    assert MySchema(only=("a",)).dump({"a": 1}) == {"a": 1}
+
+
+@pytest.mark.parametrize("param", ("only", "exclude"))
+def test_nested_option_with_unknown_parent_raises_value_error(param):
+    class MySchema(Schema):
+        a = fields.Int()
+
+    with pytest.raises(ValueError, match="'nope'"):
+        MySchema(**{param: ("nope.x",)})
+
+
+# OrderedSet
+
+
+def test_ordered_set_compare_to_non_iterable():
+    oset = OrderedSet(["a"])
+    assert (oset == None) is False  # noqa: E711
+    assert oset != 1
+    assert oset == OrderedSet(["a"])
+    assert oset == {"a"}
+
+
+# Context
+
+
+def test_context_instance_is_reentrant():
+    ctx = Context({"a": 1})
+    with ctx:
+        with ctx:
+            assert Context.get() == {"a": 1}
+        assert Context.get() == {"a": 1}
+    assert Context.get(None) is None
+
+
+# Class registry
+
+
+def test_registry_replaces_redefined_class_in_same_module():
+    first = type("MyRedefinedSchema", (Schema,), {"__module__": "redef_module"})
+    assert class_registry.get_class("MyRedefinedSchema") is first
+    second = type("MyRedefinedSchema", (Schema,), {"__module__": "redef_module"})
+    assert class_registry.get_class("MyRedefinedSchema") is second
+    assert class_registry.get_class("redef_module.MyRedefinedSchema") is second
+
+
+def test_include_unknown_does_not_overwrite_deserialized_field():
+    from marshmallow import INCLUDE
+
+    class MySchema(Schema):
+        foo = fields.Int(data_key="bar")
+
+    result = MySchema(unknown=INCLUDE).load({"bar": 1, "foo": "not validated"})
+    assert result == {"foo": 1}
