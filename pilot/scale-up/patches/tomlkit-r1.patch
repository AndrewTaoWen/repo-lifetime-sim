+def _copy_items(value: Any) -> Any:
+    """Copy the TOMLKit items found in a plain data structure.
+
+    Building a new table out of existing items modifies their formatting
+    (e.g. their indentation), so copies are used to leave the caller's
+    document untouched.
+    """
+    if isinstance(value, _Item):
+        return copy.deepcopy(value)
+    if isinstance(value, dict):
+        return {k: _copy_items(v) for k, v in value.items()}
+    if isinstance(value, list):
+        return [_copy_items(v) for v in value]
+    if isinstance(value, tuple):
+        return tuple(_copy_items(v) for v in value)
+    return value
+
+
