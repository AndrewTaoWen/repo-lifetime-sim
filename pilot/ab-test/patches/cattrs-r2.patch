+def test_msgspec_dataclass_respects_field_hooks():
+    """The msgspec converter uses registered hooks for dataclass fields."""
+    pytest.importorskip("msgspec")
+    from cattrs.preconf.msgspec import make_converter
+
+    c = make_converter()
+    c.register_unstructure_hook(Money, lambda m: f"${m.v}")
+    assert c.unstructure(D(Money(1))) == {"m": "$1"}
+    assert c.dumps(D(Money(1))) == b'{"m":"$1"}'
+
