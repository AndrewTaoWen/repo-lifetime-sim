@@ -0,0 +1,198 @@
+"""Regression tests for latent bugs fixed during hardening."""
+
+from __future__ import annotations
+
+import json
+import sys
+from dataclasses import field
+from typing import Annotated, Optional
+
+import pytest
+from pydantic import BaseModel, Field
+from pydantic.dataclasses import dataclass as pydantic_dataclass
+
+from pydantic_settings import BaseSettings, CliApp, NoDecode, SettingsConfigDict
+from pydantic_settings.sources.providers.nested_secrets import NestedSecretsSettingsSource
+from pydantic_settings.sources.utils import _get_field_metadata
+
+
+@pytest.mark.skipif(sys.version_info < (3, 12), reason='requires PEP 695 type aliases')
+def test_get_field_metadata_does_not_mutate_field_metadata():
+    ns: dict = {}
+    exec(
+        'from typing import Annotated\n'
+        'from pydantic_settings import NoDecode\n'
+        'type L = Annotated[list[int], NoDecode]\n',
+        ns,
+    )
+
+    class Settings(BaseSettings):
+        x: ns['L'] = []
+
+    field_info = Settings.model_fields['x']
+    before = list(field_info.metadata)
+    assert NoDecode in _get_field_metadata(field_info)
+    _get_field_metadata(field_info)
+    assert field_info.metadata == before
+
+
+def test_get_field_metadata_returns_copy():
+    class Settings(BaseSettings):
+        x: Annotated[list[int], NoDecode] = []
+
+    field_info = Settings.model_fields['x']
+    result = _get_field_metadata(field_info)
+    result.append('sentinel')
+    assert 'sentinel' not in field_info.metadata
+
+
+def test_case_insensitive_optional_model_with_none_first(env):
+    class Sub(BaseModel):
+        VAL1: str
+
+    class Settings(BaseSettings):
+        model_config = SettingsConfigDict(env_nested_delimiter='__')
+        nested: None | Sub = None
+
+    env.set('NESTED__val1', 'v')
+    assert Settings().nested == Sub(VAL1='v')
+
+
+def test_case_insensitive_nested_optional_submodel(env):
+    class InnerModel(BaseModel):
+        X: int = 0
+
+    class Sub(BaseModel):
+        A: int = 1
+        Inner: Optional[InnerModel] = None
+
+    class Settings(BaseSettings):
+        model_config = SettingsConfigDict(env_nested_delimiter='__')
+        nested: Optional[Sub] = None
+
+    env.set('NESTED__a', '3')
+    env.set('NESTED__inner__x', '4')
+    s = Settings()
+    assert s.nested.A == 3
+    assert s.nested.Inner == InnerModel(X=4)
+
+
+def test_dotenv_extra_with_uppercase_prefix_case_insensitive(tmp_path):
+    p = tmp_path / '.env'
+    p.write_text('APP_FOO=1\nAPP_EXTRA=x\n')
+
+    class Settings(BaseSettings):
+        model_config = SettingsConfigDict(env_file=p, env_prefix='APP_', extra='allow')
+        foo: int
+
+    assert Settings().model_dump() == {'foo': 1, 'extra': 'x'}
+
+
+class _AliasedSub(BaseModel):
+    a: int = Field(alias='AA')
+    b: int = 2
+
+
+def test_partial_update_default_with_aliased_nested_field(env):
+    class Settings(BaseSettings):
+        model_config = SettingsConfigDict(env_nested_delimiter='__', nested_model_default_partial_update=True)
+        nested: _AliasedSub = _AliasedSub(AA=1)
+
+    env.set('NESTED__b', '5')
+    assert Settings().nested.model_dump() == {'a': 1, 'b': 5}
+    assert Settings(nested={'b': 7}).nested.model_dump() == {'a': 1, 'b': 7}
+
+
+def test_partial_update_init_kwarg_with_aliased_nested_field():
+    class Settings(BaseSettings):
+        model_config = SettingsConfigDict(nested_model_default_partial_update=True)
+        nested: _AliasedSub = _AliasedSub(AA=1)
+        items: list[_AliasedSub] = []
+
+    s = Settings(nested=_AliasedSub(AA=3), items=[_AliasedSub(AA=4, b=5)])
+    assert s.nested.model_dump() == {'a': 3, 'b': 2}
+    assert s.items[0].model_dump() == {'a': 4, 'b': 5}
+
+
+def test_partial_update_serialization_alias_only_still_works(env):
+    class Sub(BaseModel):
+        a: int = Field(1, serialization_alias='S')
+        b: int = 2
+
+    class Settings(BaseSettings):
+        model_config = SettingsConfigDict(env_nested_delimiter='__', nested_model_default_partial_update=True)
+        nested: Sub = Sub()
+
+    env.set('NESTED__b', '5')
+    assert Settings().nested.model_dump() == {'a': 1, 'b': 5}
+
+
+def test_partial_update_dataclass_default(env):
+    @pydantic_dataclass
+    class Sub:
+        a: int = 1
+        tags: list[str] = field(default_factory=list)
+
+    class Settings(BaseSettings):
+        model_config = SettingsConfigDict(env_nested_delimiter='__', nested_model_default_partial_update=True)
+        nested: Sub = Sub(a=3, tags=['x'])
+
+    env.set('NESTED__tags', '["y"]')
+    assert Settings().nested == Sub(a=3, tags=['y'])
+
+
+def test_cli_app_run_plain_model_with_alias():
+    class Cmd(BaseModel):
+        some_value: int = Field(alias='some-value')
+        other: str = 'o'
+
+        def cli_cmd(self) -> None:
+            pass
+
+    result = CliApp.run(Cmd, cli_args=['--some-value', '3'])
+    assert result.some_value == 3
+    assert result.other == 'o'
+
+
+def test_nested_secrets_dir_with_glob_metacharacters(tmp_path):
+    secrets_dir = tmp_path / 'secrets[1]'
+    secrets_dir.mkdir()
+    (secrets_dir / 'password').write_text('hunter2')
+
+    class Settings(BaseSettings):
+        model_config = SettingsConfigDict(secrets_dir=secrets_dir)
+        password: str
+
+        @classmethod
+        def settings_customise_sources(
+            cls, settings_cls, init_settings, env_settings, dotenv_settings, file_secret_settings
+        ):
+            return (init_settings, NestedSecretsSettingsSource(file_secret_settings))
+
+    assert Settings().password == 'hunter2'
+
+
+def test_aws_secrets_manager_nested_json_values(monkeypatch):
+    pytest.importorskip('boto3')
+    moto = pytest.importorskip('moto')
+    import boto3
+
+    from pydantic_settings import AWSSecretsManagerSettingsSource
+
+    monkeypatch.setenv('AWS_DEFAULT_REGION', 'us-east-1')
+
+    class Db(BaseModel):
+        host: str
+        port: int
+
+    class Settings(BaseSettings):
+        db: Db
+        tags: list[str]
+        port: int
+
+    with moto.mock_aws():
+        boto3.client('secretsmanager').create_secret(
+            Name='s', SecretString=json.dumps({'db': {'host': 'h', 'port': 1}, 'tags': ['a'], 'port': 5})
+        )
+        source = AWSSecretsManagerSettingsSource(Settings, 's')
+        assert source() == {'db': {'host': 'h', 'port': 1}, 'tags': ['a'], 'port': 5}
