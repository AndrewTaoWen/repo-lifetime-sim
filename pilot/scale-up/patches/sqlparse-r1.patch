+def test_cli_inplace_keeps_file_on_error(tmpdir, capsys, monkeypatch):
+    path = tmpdir.join('a.sql')
+    path.write('select 1')
+
+    def boom(*args, **kwargs):
+        raise SQLParseError('boom')
+    monkeypatch.setattr(sqlparse, 'format', boom)
+    assert sqlparse.cli.main([str(path), '--in-place']) == 1
+    assert path.read() == 'select 1'
+    assert 'boom' in capsys.readouterr().err
+
+
+def test_cli_decode_error(tmpdir, capsys):
+    path = tmpdir.join('a.sql')
+    path.write_binary(b'select \xff')
+    assert sqlparse.cli.main([str(path)]) == 1
+    assert 'decode' in capsys.readouterr().err
+
