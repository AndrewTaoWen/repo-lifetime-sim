+            add_linebreak(sql.Token(T.Whitespace, m.group()))
+        elif _is_linebreak(token):
+            add_linebreak(token)
+        else:
+            tokens.append(token)
+
+    while tokens and tokens[0].is_whitespace:
+        tokens.pop(0)
+
+    idx = len(tokens)
+    while idx and tokens[idx - 1].is_whitespace:
+        idx -= 1
+    if any(_is_linebreak(tk) for tk in tokens[idx:]):
+        del tokens[idx:]
+    return tokens
+
 
