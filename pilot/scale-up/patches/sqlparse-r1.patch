@@ -0,0 +1,186 @@
+"""Regression tests for assorted robustness fixes."""
+import io
+import time
+
+import pytest
+
+import sqlparse
+from sqlparse import sql
+from sqlparse import tokens as T
+from sqlparse.exceptions import SQLParseError
+from sqlparse.lexer import Lexer
+from sqlparse.utils import remove_quotes
+
+
+def test_function_get_window_without_over():
+    func = sqlparse.parse('select count(*) from t')[0].tokens[2]
+    assert isinstance(func, sql.Function)
+    assert func.get_window() is None
+
+
+def test_function_get_window_with_over():
+    func = sqlparse.parse('select row_number() over (order by a)')[0].tokens[2]
+    assert isinstance(func.get_window(), sql.Parenthesis)
+
+
+def test_functions_grouped_in_lowercase_ctas():
+    stmt = sqlparse.parse('create table t as select max(a) from b')[0]
+    assert any(isinstance(tk, sql.Function) for tk in stmt.tokens)
+
+
+def test_hex_number_in_comparison():
+    where = sqlparse.parse('select * from t where a = 0x1F')[0].tokens[-1]
+    assert isinstance(where.tokens[2], sql.Comparison)
+    assert where.tokens[2].right.value == '0x1F'
+
+
+def test_remove_quotes_empty_string():
+    assert remove_quotes('') == ''
+
+
+def test_reindent_aligned_error_message():
+    with pytest.raises(SQLParseError, match="'foo'"):
+        sqlparse.format('select 1', reindent_aligned='foo')
+
+
+def test_split_lowercase_go():
+    assert sqlparse.split('select 1\ngo\nselect 2') == ['select 1\ngo',
+                                                         'select 2']
+
+
+def test_output_python_escapes_backslash_and_newline():
+    sql_ = "select 'it\\'s', 'a\nb' -- c\nfrom x"
+    out = sqlparse.format(sql_, output_format='python')
+    ns = {}
+    exec(out, ns)
+    assert ns['sql'] == sql_
+
+
+def test_output_python_reindent_uses_current_values():
+    out = sqlparse.format('select a, b from x where y = 1 and z = 2',
+                          reindent=True, output_format='python')
+    assert out == '\n'.join([
+        "sql = ('select a, '",
+        "       '       b '",
+        "       'from x '",
+        "       'where y = 1 '",
+        "       '  and z = 2')"])
+
+
+def test_output_python_strip_comments_in_groups():
+    out = sqlparse.format('select a from x where y = 1 /* d */ and z=2',
+                          strip_comments=True, output_format='python')
+    assert '/*' not in out
+
+
+def test_output_php_escapes():
+    out = sqlparse.format("select '$x', 'a\\b' from y", output_format='php')
+    assert out == '$sql = "select \'\\$x\', \'a\\\\b\' from y";'
+
+
+def test_output_php_multiple_reindented_statements():
+    out = sqlparse.format('select a from x;select 2', reindent=True,
+                          output_format='php')
+    assert out.splitlines()[-1] == '$sql2 = "select 2";'
+
+
+def test_output_filter_tokens_is_list():
+    stack = sqlparse.engine.FilterStack()
+    stack.postprocess.append(sqlparse.filters.OutputPythonFilter())
+    stmt = list(stack.run('select 1'))[0]
+    assert str(stmt) == str(stmt) == "sql = 'select 1'"
+
+
+@pytest.mark.parametrize('sql_, expected', [
+    ("select 'a''bcdef'", "select 'a[...]'"),
+    ("select 'a\\'bcdef'", "select 'a[...]'"),
+    ("select 'abcdef'", "select 'ab[...]'"),
+])
+def test_truncate_strings_keeps_escapes_intact(sql_, expected):
+    assert sqlparse.format(sql_, truncate_strings=2) == expected
+
+
+@pytest.mark.parametrize('sql_, expected', [
+    ('select 1; -- c\nselect 2;', ['select 1 -- c', 'select 2']),
+    ('select 1 -- c\n;', ['select 1 -- c']),
+])
+def test_strip_semicolon_with_trailing_comment(sql_, expected):
+    assert sqlparse.split(sql_, strip_semicolon=True) == expected
+
+
+@pytest.mark.parametrize('opt', ['reindent', 'reindent_aligned'])
+def test_reindent_no_partial_keyword_matches(opt):
+    out = sqlparse.format('select a from b limit 1 offset 2 for update',
+                          **{opt: True})
+    assert 'offset 2 for update' in out
+
+
+def test_reindent_aligned_case_without_end_on_level():
+    s = 'CASE WHEN 1 THEN select 2 where foo = 1 end'
+    assert sqlparse.format(s, reindent_aligned=True) == s
+
+
+def test_unterminated_block_comments_linear():
+    sql_ = '/* ' * 20000
+    start = time.time()
+    tokens = list(sqlparse.lexer.tokenize(sql_))
+    assert time.time() - start < 3
+    assert ''.join(v for _, v in tokens) == sql_
+
+
+def test_block_comment_still_recognized_before_unterminated():
+    tokens = list(sqlparse.lexer.tokenize('/* a */ /* b'))
+    assert tokens[0] == (T.Comment.Multiline, '/* a */')
+    assert (T.Comment.Multiline, '/* b') not in tokens
+
+
+def test_parsestream_binary_file():
+    stmts = list(sqlparse.parsestream(io.BytesIO(b'select 1; select 2')))
+    assert len(stmts) == 2
+
+
+def test_bytes_non_utf8_no_escape_interpretation():
+    raw = b"select 'C:\\xyz\\n' \xe9"
+    assert sqlparse.format(raw) == "select 'C:\\xyz\\n' \xe9"
+
+
+def test_lexer_default_instance_unaffected():
+    assert Lexer.get_default_instance()._SQL_REGEX
+
