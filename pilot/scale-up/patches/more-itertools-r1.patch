+class LastErrorPropagationTests(TestCase):
+    def test_error_while_iterating_propagates(self):
+        # A TypeError raised while iterating must not be mistaken for an
+        # empty iterable.
+        with self.assertRaises(TypeError):
+            mi.last(map(lambda x: x + 1, ['a']), 'default')
+        with self.assertRaises(TypeError):
+            mi.nth_or_last(map(lambda x: x + 1, [1, 'a']), 5, 'default')
+
+    def test_empty_still_uses_default(self):
+        self.assertEqual(mi.last(iter([]), 'd'), 'd')
+        self.assertEqual(mi.last([], 'd'), 'd')
+        self.assertEqual(mi.last({}, 'd'), 'd')
+        with self.assertRaises(ValueError):
+            mi.last(iter([]))
+
+    def test_sequence_without_negative_indexing(self):
+        class OnlyPositive(Sequence):
+            def __len__(self):
+                return 3
+
+            def __getitem__(self, i):
+                if i < 0:
+                    raise TypeError('no negative indexes')
+                if i >= 3:
+                    raise IndexError(i)
+                return i
+
+        self.assertEqual(mi.last(OnlyPositive()), 2)
+
