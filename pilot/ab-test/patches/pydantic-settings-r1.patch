+def _validation_key(field_name: str, field_info: FieldInfo, config: Mapping[str, Any]) -> str:
+    """Return the input key under which pydantic will look up `field_name` during validation."""
+    from pydantic import AliasChoices
+
+    if config.get('validate_by_alias', True):
+        v_alias = field_info.validation_alias
+        if isinstance(v_alias, str):
+            return v_alias
+        if isinstance(v_alias, AliasChoices):
+            first = next((choice for choice in v_alias.choices if isinstance(choice, str)), None)
+            if first is not None:
+                return first
+        elif v_alias is None and isinstance(field_info.alias, str):
+            return field_info.alias
+    return field_name
+
+
+def _dump_for_validation(value: Any) -> Any:
+    """
+    Recursively convert pydantic models (and dataclasses) to dicts keyed so that they validate back into
+    the same model, i.e. keyed by alias where pydantic expects one rather than by field name.
+    """
+    if isinstance(value, BaseModel):
+        config = type(value).model_config
+        result: dict[str, Any] = {}
+        for name, field_info in type(value).model_fields.items():
+            if name in value.__dict__:
+                result[_validation_key(name, field_info, config)] = _dump_for_validation(value.__dict__[name])
+        for key, extra_value in (value.__pydantic_extra__ or {}).items():
+            result[key] = _dump_for_validation(extra_value)
+        return result
+    if is_dataclass(value) and not isinstance(value, type):
+        import dataclasses
+
+        fields_info = getattr(type(value), '__pydantic_fields__', {})
+        config = getattr(type(value), '__pydantic_config__', {}) or {}
+        result = {}
+        for f in dataclasses.fields(value):
+            key = _validation_key(f.name, fields_info[f.name], config) if f.name in fields_info else f.name
+            result[key] = _dump_for_validation(getattr(value, f.name))
+        return result
+    if type(value) is dict:
+        return {k: _dump_for_validation(v) for k, v in value.items()}
+    if type(value) in (list, tuple, set, frozenset):
+        return type(value)(_dump_for_validation(v) for v in value)
+    return value
+
+
