+class RunningMeanNonFiniteTests(TestCase):
+    def test_infinity_leaves_window(self):
+        inf = float('inf')
+        self.assertEqual(
+            list(mi.running_mean([inf, 1, 2, 3], maxlen=1)),
+            [inf, 1.0, 2.0, 3.0],
+        )
+        self.assertEqual(
+            list(mi.running_mean([1, -inf, 3, 5], maxlen=2)),
+            [1.0, -inf, -inf, 4.0],
+        )
+
+    def test_nan_leaves_window(self):
+        actual = list(mi.running_mean([float('nan'), 1, 2, 3], maxlen=2))
+        self.assertNotEqual(actual[0], actual[0])
+        self.assertNotEqual(actual[1], actual[1])
+        self.assertEqual(actual[2:], [1.5, 2.5])
+
+    def test_running_statistics_recovers(self):
+        stats = list(
+            mi.running_statistics([float('inf'), 1, 2, 3], maxlen=1)
+        )
+        self.assertEqual([s.mean for s in stats][1:], [1.0, 2.0, 3.0])
