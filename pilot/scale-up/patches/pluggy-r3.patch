diff --git a/testing/test_hardening.py b/testing/test_hardening.py
new file mode 100644
index 0000000..df3f6bb
--- /dev/null
+++ b/testing/test_hardening.py
@@ -0,0 +1,259 @@
+"""Regression tests for robustness fixes."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import pytest
+
+from pluggy import HookimplMarker
+from pluggy import HookspecMarker
+from pluggy import PluginManager
+from pluggy import PluginValidationError
+
+
+hookspec = HookspecMarker("example")
+hookimpl = HookimplMarker("example")
+
+
+class Spec:
+    @hookspec
+    def he_method1(self, arg):
+        pass
+
+    @hookspec(historic=True)
+    def he_hist(self, arg):
+        pass
+
+
+@pytest.fixture
+def pm() -> PluginManager:
+    pm = PluginManager("example")
+    pm.add_hookspecs(Spec)
+    return pm
+
+
+def test_second_yield_does_not_skip_outer_wrapper_teardown(pm: PluginManager) -> None:
+    out = []
+
+    class Outer:
+        @hookimpl(wrapper=True, tryfirst=True)
+        def he_method1(self, arg):
+            try:
+                return (yield)
+            except RuntimeError as e:
+                out.append(("outer saw", "second yield" in str(e)))
+                raise
+            finally:
+                out.append("outer teardown")
+
+    class Bad:
+        @hookimpl(wrapper=True)
+        def he_method1(self, arg):
+            yield
+            yield
+
+    pm.register(Outer())
+    pm.register(Bad())
+    with pytest.raises(RuntimeError, match="has second yield"):
+        pm.hook.he_method1(arg=1)
+    assert out == [("outer saw", True), "outer teardown"]
+
+
+def test_failed_register_is_rolled_back(pm: PluginManager) -> None:
+    class Bad:
+        @hookimpl
+        def he_method1(self, arg):
+            return 1
+
+        @hookimpl
+        def he_method1_x(self, arg, notinspec):  # no spec -> pending, ok
+            pass
+
+        @hookimpl(specname="he_method1")
+        def zzz(self, arg, unknown_arg):
+            pass
+
+    bad = Bad()
+    with pytest.raises(PluginValidationError):
+        pm.register(bad, name="bad")
+    assert not pm.is_registered(bad)
+    assert pm.get_plugin("bad") is None
+    assert pm.hook.he_method1.get_hookimpls() == []
+    assert pm.hook.he_method1(arg=1) == []
+
+    class Good:
+        @hookimpl
+        def he_method1(self, arg):
+            return 2
+
+    pm.register(Good(), name="bad")
+    assert pm.hook.he_method1(arg=1) == [2]
+
+
+def test_failed_historic_replay_is_rolled_back(pm: PluginManager) -> None:
+    pm.hook.he_hist.call_historic(kwargs=dict(arg=1))
+
+    class Bad:
+        @hookimpl
+        def he_hist(self, arg):
+            raise ValueError("boom")
+
+    bad = Bad()
+    with pytest.raises(ValueError):
+        pm.register(bad)
+    assert not pm.is_registered(bad)
+    assert pm.hook.he_hist.get_hookimpls() == []
+
+
+def test_add_hookspecs_validation_failure_does_not_leave_spec(
+    pm: PluginManager,
+) -> None:
+    class Plugin:
+        @hookimpl(wrapper=True)
+        def later(self):
+            yield
+
+    pm.register(Plugin())
+
+    class Spec2:
+        @hookspec(historic=True)
+        def later(self):
+            pass
+
+    with pytest.raises(PluginValidationError):
+        pm.add_hookspecs(Spec2)
+    assert not pm.hook.later.has_spec()
+    assert not pm.hook.later.is_historic()
+
+
+def test_falsy_plugin_unregister(pm: PluginManager) -> None:
+    class Falsy:
+        def __bool__(self):
+            return False
+
+        @hookimpl
+        def he_method1(self, arg):
+            return arg
+
+    p = Falsy()
+    pm.register(p, name="falsy")
+    assert pm.unregister(p) is p
+    assert not pm.is_registered(p)
+    assert pm.get_plugin("falsy") is None
+    assert "falsy" not in dict(pm.list_name_plugin())
+    pm.register(p, name="falsy")
+    assert pm.hook.he_method1(arg=3) == [3]
+
+
+def test_unregister_equal_but_distinct_plugin(pm: PluginManager) -> None:
+    @dataclass
+    class P:
+        x: int
+
+        @hookimpl
+        def he_method1(self, arg):
+            return self.x
+
+    p = P(1)
+    pm.register(p, name="p")
+    assert pm.unregister(P(1)) is p
+    assert pm.hook.he_method1(arg=0) == []
+    assert not pm.get_plugins()
+
+
+def test_unregister_name_and_plugin_must_agree(pm: PluginManager) -> None:
+    class A:
+        @hookimpl
+        def he_method1(self, arg):
+            return "a"
+
+    class B:
+        @hookimpl
+        def he_method1(self, arg):
+            return "b"
+
+    a, b = A(), B()
+    pm.register(a, "a")
+    pm.register(b, "b")
+    with pytest.raises(ValueError):
+        pm.unregister(a, "b")
+    assert sorted(pm.hook.he_method1(arg=0)) == ["a", "b"]
+    assert pm.get_plugin("a") is a and pm.get_plugin("b") is b
+
+
+def test_register_plugin_with_raising_property(pm: PluginManager) -> None:
+    class Plugin:
+        @property
+        def broken(self):
+            raise RuntimeError("no")
+
+        @hookimpl
+        def he_method1(self, arg):
+            return arg
+
+    pm.register(Plugin())
+    assert pm.hook.he_method1(arg=5) == [5]
+
+
+def test_subset_hook_caller_specname(pm: PluginManager) -> None:
+    class A:
+        @hookimpl(specname="he_method1")
+        def renamed(self, arg):
+            return "a"
+
+    class B:
+        @hookimpl
+        def he_method1(self, arg):
+            return "b"
+
+    a, b = A(), B()
+    pm.register(a)
+    pm.register(b)
+    hc = pm.subset_hook_caller("he_method1", [a])
+    assert hc(arg=0) == ["b"]
+
+
+def test_subset_hook_caller_unhashable_plugin(pm: PluginManager) -> None:
+    @dataclass
+    class P:
+        x: int
+
+        @hookimpl
+        def he_method1(self, arg):
+            return self.x
+
+    p1, p2 = P(1), P(2)
+    pm.register(p1, "p1")
+    pm.register(p2, "p2")
+    hc = pm.subset_hook_caller("he_method1", [p1])
+    assert hc(arg=0) == [2]
+
+
+def test_hookcall_monitoring_undo_out_of_order(pm: PluginManager) -> None:
+    calls: list[str] = []
+
+    class Plugin:
+        @hookimpl
+        def he_method1(self, arg):
+            return arg
+
+    pm.register(Plugin())
+
+    def mk(tag):
+        return (
+            lambda *a: calls.append(tag + ":before"),
+            lambda *a: calls.append(tag + ":after"),
+        )
+
+    undo_a = pm.add_hookcall_monitoring(*mk("a"))
+    undo_b = pm.add_hookcall_monitoring(*mk("b"))
+    undo_a()
+    pm.hook.he_method1(arg=1)
+    assert calls == ["b:before", "b:after"]
+    calls.clear()
+    undo_b()
+    pm.hook.he_method1(arg=1)
+    assert calls == []
+
+
