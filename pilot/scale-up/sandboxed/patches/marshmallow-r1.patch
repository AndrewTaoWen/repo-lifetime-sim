+class TestContextReentrancy:
+    def test_same_context_instance_nested(self):
+        ctx = Context({"a": 1})
+        with ctx:
+            with ctx:
+                assert Context.get() == {"a": 1}
+            assert Context.get() == {"a": 1}
+        assert Context.get(None) is None
+
+    def test_same_context_instance_interleaved_with_other(self):
+        outer = Context("outer")
+        inner = Context("inner")
+        with outer:
+            with inner:
+                with outer:
+                    assert Context.get() == "outer"
+                assert Context.get() == "inner"
+            assert Context.get() == "outer"
+        assert Context.get(None) is None
+
