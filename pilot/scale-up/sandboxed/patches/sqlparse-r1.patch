+    ident = p.tokens[2]
+    assert isinstance(ident, sql.Identifier)
+    assert ident.get_alias() == 'x'
+    assert isinstance(ident.tokens[0], sql.Operation)
+    formatted = sqlparse.format(s, reindent=True)
+    assert formatted.endswith('a299 as x\nfrom t')
