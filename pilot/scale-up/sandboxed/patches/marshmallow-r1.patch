+def _get_loaded_value(data: typing.Any, key: str) -> typing.Any:
+    """Return the value stored under ``key`` in deserialized ``data``.
+    ``key`` may be a dot-delimited path (see `marshmallow.utils.set_value`).
+    Return `missing` if the value is absent.
+    """
+    if not isinstance(data, Mapping):
+        return missing
+    if key in data:
+        return data[key]
+    if "." in key:
+        head, rest = key.split(".", 1)
+        return _get_loaded_value(data.get(head, missing), rest)
+    return missing
+
+
+def _pop_loaded_value(data: typing.Any, key: str) -> None:
+    """Remove the value stored under ``key`` (which may be a dot-delimited path)
+    from deserialized ``data``, if present.
+    """
+    if not isinstance(data, typing.MutableMapping):
+        return
+    if key in data:
+        del data[key]
+    elif "." in key:
+        head, rest = key.split(".", 1)
+        _pop_loaded_value(data.get(head), rest)
+
+
+def _originals_for(original_data: typing.Any, length: int) -> list[typing.Any]:
+    """Return a list of exactly ``length`` original items to pair with
+    (de)serialized items. Missing originals are filled with `None`.
+    """
+    if original_data is None or isinstance(original_data, (str, bytes, Mapping)):
+        originals: list[typing.Any] = []
+    else:
+        try:
+            originals = list(original_data)
+        except TypeError:
+            originals = []
+    if len(originals) < length:
+        originals.extend([None] * (length - len(originals)))
+    return originals[:length]
+
