+def test_context_instance_is_reentrant():
+    ctx = Context({"a": 1})
+    other = Context({"b": 2})
+    with ctx:
+        with other:
+            with ctx:
+                assert Context.get() == {"a": 1}
+            assert Context.get() == {"b": 2}
+        assert Context.get() == {"a": 1}
+    assert Context.get(None) is None
+
+
+def test_context_instance_shared_between_threads():
+    ctx = Context({"a": 1})
+    entered = threading.Event()
+    release = threading.Event()
+    errors = []
+
+    def worker():
+        try:
+            with ctx:
+                entered.set()
+                release.wait(5)
+        except Exception as exc:  # pragma: no cover
+            errors.append(exc)
+
+    thread = threading.Thread(target=worker)
+    thread.start()
+    entered.wait(5)
+    with ctx:
+        release.set()
+        thread.join(5)
+        assert Context.get() == {"a": 1}
+    assert Context.get(None) is None
+    assert errors == []
