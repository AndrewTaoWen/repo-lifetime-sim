@@ -0,0 +1,255 @@
+"""Regression tests for latent bugs fixed during hardening."""
+
+from __future__ import annotations
+
+import os
+import sys
+from enum import Enum, IntEnum
+from pathlib import Path
+from typing import Annotated, Optional, Union
+
+import pytest
+from pydantic import BaseModel, field_validator
+
+from pydantic_settings import (
+    BaseSettings,
+    CliApp,
+    CliSettingsSource,
+    JsonConfigSettingsSource,
+    NoDecode,
+    PyprojectTomlConfigSettingsSource,
+    SecretsSettingsSource,
+    SettingsConfigDict,
+    SettingsError,
+    YamlConfigSettingsSource,
+)
+from pydantic_settings.sources.providers.nested_secrets import NestedSecretsSettingsSource
+
+try:
+    import yaml
+except ImportError:  # pragma: no cover
+    yaml = None
+
+
+@pytest.mark.skipif(sys.version_info < (3, 12), reason='requires `type` statement support')
+def test_decode_does_not_grow_field_metadata(env):
+    from typing import TypeAliasType
+
+    IntList = TypeAliasType('IntList', Annotated[list[int], NoDecode])
+
+    class Settings(BaseSettings):
+        x: IntList = []
+
+        @field_validator('x', mode='before')
+        @classmethod
+        def split(cls, v):
+            return [int(i) for i in v.split(',')] if isinstance(v, str) else v
+
+    env.set('X', '1,2')
+    before = list(Settings.model_fields['x'].metadata)
+    for _ in range(3):
+        assert Settings().x == [1, 2]
+    assert Settings.model_fields['x'].metadata == before
+
+
+def test_case_insensitive_nested_union_none_first(env):
+    class Sub(BaseModel):
+        Val: int
+
+    class Settings(BaseSettings):
+        model_config = SettingsConfigDict(env_nested_delimiter='__')
+        a: Union[None, Sub] = None
+        b: Optional[Sub] = None
+
+    env.set('A__VAL', '1')
+    env.set('B__VAL', '2')
+    s = Settings()
+    assert s.a == Sub(Val=1)
+    assert s.b == Sub(Val=2)
+
+
+def test_case_insensitive_optional_deeply_nested_model(env):
+    class Deep(BaseModel):
+        Vv: int
+
+    class Mid(BaseModel):
+        Inner: Optional[Deep] = None
+
+    class Settings(BaseSettings):
+        model_config = SettingsConfigDict(env_nested_delimiter='__')
+        top: Mid = Mid()
+
+    env.set('TOP__INNER__VV', '3')
+    assert Settings().top.Inner == Deep(Vv=3)
+
+
+def test_dotenv_extra_strips_uppercase_prefix_case_insensitive(tmp_path):
+    p = tmp_path / '.env'
+    p.write_text('APP_foo=1\nAPP_extra_var=x\n')
+
+    class Settings(BaseSettings):
+        model_config = SettingsConfigDict(extra='allow', env_file=p, env_prefix='APP_')
+        foo: str = ''
+
+    assert Settings().model_dump() == {'foo': '1', 'extra_var': 'x'}
+
+
+def test_secrets_prefers_exact_case_match(tmp_path, monkeypatch):
+    (tmp_path / 'FOO').write_text('upper')
+    (tmp_path / 'foo').write_text('lower')
+
+    class Settings(BaseSettings):
+        model_config = SettingsConfigDict(secrets_dir=tmp_path)
+        foo: str = ''
+
+    # Make directory listing return the non-exact match first.
+    real_iterdir = Path.iterdir
+    monkeypatch.setattr(Path, 'iterdir', lambda self: iter(sorted(real_iterdir(self))))
+    assert SecretsSettingsSource.find_case_path(tmp_path, 'foo', case_sensitive=False).name == 'foo'
+    assert SecretsSettingsSource.find_case_path(tmp_path, 'Foo', case_sensitive=False) is not None
+    assert SecretsSettingsSource.find_case_path(tmp_path, 'Foo', case_sensitive=True) is None
+    assert Settings().foo == 'lower'
+
+
+@pytest.mark.skipif(not hasattr(os, 'symlink'), reason='requires symlinks')
+def test_secrets_dangling_symlink_is_missing(tmp_path):
+    os.symlink(tmp_path / 'does-not-exist', tmp_path / 'foo')
+
+    class Settings(BaseSettings):
+        model_config = SettingsConfigDict(secrets_dir=tmp_path)
+        foo: str = 'default'
+
+    assert Settings().foo == 'default'
+
+
+def test_nested_secrets_dir_with_glob_metacharacters(tmp_path):
+    secrets_dir = tmp_path / 'secrets[1]'
+    secrets_dir.mkdir()
+    (secrets_dir / 'foo').write_text('bar')
+
+    class Settings(BaseSettings):
+        model_config = SettingsConfigDict(secrets_dir=secrets_dir)
+        foo: str = ''
+
+        @classmethod
+        def settings_customise_sources(
+            cls, settings_cls, init_settings, env_settings, dotenv_settings, file_secret_settings
+        ):
+            return (NestedSecretsSettingsSource(file_secret_settings),)
+
+    assert Settings().foo == 'bar'
+
+
+def test_cli_prefix_from_model_config_without_argument():
+    class Settings(BaseSettings):
+        model_config = SettingsConfigDict(cli_prefix='app')
+        a: int = 1
+
+    source = CliSettingsSource(Settings, cli_parse_args=['--app.a', '3'])
+    assert Settings(_cli_settings_source=source).a == 3
+
+    class BadSettings(BaseSettings):
+        model_config = SettingsConfigDict(cli_prefix='.app')
+        a: int = 1
+
+    with pytest.raises(SettingsError, match='CLI settings source prefix is invalid'):
+        CliSettingsSource(BadSettings)
+
+
+class _Color(Enum):
+    red_x = 'r'
+    blue = 'b'
+
+
+class _Num(IntEnum):
+    one = 1
+    two = 2
+
+
+@pytest.mark.parametrize(
+    'kwargs',
+    [
+        {'tup': (1, 2)},
+        {'fs': frozenset({3})},
+        {'st': {4, 5}},
+        {'opt': None},
+        {'color': _Color.blue},
+        {'num': _Num.two},
+    ],
+)
+def test_cli_serialize_round_trip(kwargs):
+    class Settings(BaseSettings):
+        tup: tuple[int, ...] = ()
+        fs: frozenset[int] = frozenset()
+        st: set[int] = set()
+        opt: Optional[int] = 5
+        color: _Color = _Color.red_x
+        num: _Num = _Num.one
+
+    inst = Settings(**kwargs)
+    args = CliApp.serialize(inst)
+    assert CliApp.run(Settings, cli_args=args) == inst
+
+
+def test_cli_serialize_enum_kebab_case_all():
+    class Settings(BaseSettings):
+        model_config = SettingsConfigDict(cli_kebab_case='all')
+        color: _Color = _Color.blue
+
+    inst = Settings(color=_Color.red_x)
+    args = CliApp.serialize(inst)
+    assert args == ['--color', 'red-x']
+    assert CliApp.run(Settings, cli_args=args) == inst
+
+
+def _json_only(settings_cls):
+    return (JsonConfigSettingsSource(settings_cls),)
+
+
+@pytest.mark.parametrize('content', ['null', '[1, 2]', '"str"'])
+def test_json_file_non_mapping_top_level(tmp_path, content):
+    p = tmp_path / 'c.json'
+    p.write_text(content)
+
+    class Settings(BaseSettings):
+        model_config = SettingsConfigDict(json_file=p)
+        a: int = 1
+
+        @classmethod
+        def settings_customise_sources(cls, settings_cls, **kwargs):
+            return _json_only(settings_cls)
+
+    if content == 'null':
+        assert Settings().a == 1
+    else:
+        with pytest.raises(SettingsError, match='must contain a mapping'):
+            Settings()
+
+
+@pytest.mark.skipif(yaml is None, reason='pyYAML not installed')
+def test_yaml_config_section_empty_or_scalar(tmp_path):
+    p = tmp_path / 'c.yaml'
+
+    class Settings(BaseSettings):
+        model_config = SettingsConfigDict(yaml_file=p, yaml_config_section='app')
+        a: int = 1
+
+        @classmethod
+        def settings_customise_sources(cls, settings_cls, **kwargs):
+            return (YamlConfigSettingsSource(settings_cls),)
+
+    p.write_text('app:\n')
+    assert Settings().a == 1
+    p.write_text('app: 3\n')
+    with pytest.raises(TypeError, match='must be a mapping'):
+        Settings()
+
+
+def test_pyproject_toml_accepts_str_path(tmp_path):
+    p = tmp_path / 'pyproject.toml'
+    p.write_text('[tool.pydantic-settings]\na = 3\n')
+
+    class Settings(BaseSettings):
+        a: int = 0
+
+    assert PyprojectTomlConfigSettingsSource(Settings, str(p))() == {'a': 3}
