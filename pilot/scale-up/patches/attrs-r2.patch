+class TestDefineDecoratorReuse:
+    def test_reused_decorator_does_not_leak_on_setattr(self):
+        """
+        A decorator returned by define() can be applied to several classes;
+        subclassing a frozen class with it must not affect later classes and
+        vice versa.
+        """
+
+        @attrs.frozen
+        class FrozenBase:
+            y: int = 0
+
+        d = attrs.define()
+
+        @d
+        class A:
+            x: int = attrs.field(validator=attrs.validators.instance_of(int))
+
+        @d
+        class B(FrozenBase):
+            z: int = 1
+
+        assert 1 == B().z
+
+        d2 = attrs.define()
+
+        @d2
+        class B2(FrozenBase):
+            z: int = 1
+
+        @d2
+        class C:
+            x: int = attrs.field(validator=attrs.validators.instance_of(int))
+
+        c = C(1)
+        with pytest.raises(TypeError):
+            c.x = "nope"
