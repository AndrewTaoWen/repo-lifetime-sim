+def _detect_newline(lines: Iterable[str]) -> str:
+    """Return the line terminator used in the given lines, `\\n` by default."""
+    for line in lines:
+        for terminator in ("\r\n", "\n", "\r"):
+            if line.endswith(terminator):
+                return terminator
+    return "\n"
