diff --git a/tests/test_regressions.py b/tests/test_regressions.py
new file mode 100644
index 0000000..5f783ef
--- /dev/null
+++ b/tests/test_regressions.py
@@ -0,0 +1,208 @@
+"""
+Regression tests for bugs found while hardening TinyDB.
+"""
+import copy
+import os
+import re
+
+import pytest
+
+from tinydb import TinyDB, Query, where
+from tinydb.middlewares import CachingMiddleware
+from tinydb.operations import increment
+from tinydb.storages import MemoryStorage, JSONStorage
+from tinydb.table import Document, Table
+from tinydb.utils import FrozenDict
+
+
+def test_search_results_do_not_alias_query_cache(db):
+    query = where('char') == 'a'
+
+    first = db.search(query)
+    first[0]['char'] = 'changed'
+    assert db.search(query)[0]['char'] == 'a'
+
+    cached = db.search(query)
+    cached[0]['char'] = 'changed'
+    assert db.search(query)[0]['char'] == 'a'
+
+
+def test_remove_duplicate_doc_ids(db):
+    assert db.remove(doc_ids=[1, 1]) == [1]
+    assert len(db) == 2
+
+
+def test_update_duplicate_doc_ids(db):
+    assert db.update(increment('int'), doc_ids=[1, 1]) == [1]
+    assert db.get(doc_id=1)['int'] == 2
+
+
+@pytest.mark.parametrize('storage', [
+    MemoryStorage, CachingMiddleware(MemoryStorage)
+])
+def test_failed_update_is_atomic(storage):
+    db = TinyDB(storage=storage)
+    db.insert_multiple([{'a': 1}, {'b': 2}])
+    query = where('a') == 1
+    assert len(db.search(query)) == 1
+
+    with pytest.raises(KeyError):
+        db.update(increment('a'))
+
+    assert db.all() == [{'a': 1}, {'b': 2}]
+    assert db.search(query) == [{'a': 1}]
+
+
+def test_update_multiple_with_generator(db):
+    updates = (({'int': n * 10}, where('char') == c)
+               for n, c in ((1, 'a'), (2, 'b')))
+    assert sorted(db.update_multiple(updates)) == [1, 2]
+    assert db.get(doc_id=1)['int'] == 10
+    assert db.get(doc_id=2)['int'] == 20
+
+
+def test_insert_multiple_document_then_insert(db):
+    # The documents with IDs 1-3 exist already
+    assert db.insert_multiple([Document({'x': 1}, doc_id=4)]) == [4]
+    assert db.insert({'x': 2}) == 5
+
+
+def test_insert_multiple_document_and_generated_id_dont_collide(db):
+    ids = db.insert_multiple([Document({'x': 1}, doc_id=4), {'x': 2}])
+    assert ids == [4, 5]
+    assert len(db) == 5
+    assert db.get(doc_id=4) == {'x': 1}
+    assert db.get(doc_id=5) == {'x': 2}
+
+
+def test_insert_with_stale_id_counter():
+    storage = MemoryStorage()
+    db1 = TinyDB(storage=lambda: storage)
+    db2 = TinyDB(storage=lambda: storage)
+    assert db1.insert({'a': 1}) == 1
+    assert db2.insert({'a': 2}) == 2
+    # db1's ID counter still says 2
+    assert db1.insert({'a': 3}) == 3
+    assert len(db1) == 3
+
+
+def test_get_doc_id_uses_document_id_class(db):
+    assert db.get(doc_id='1').doc_id == 1
+
+
+def test_matches_and_search_flags_are_part_of_cache_key(db):
+    db.insert({'s': 'ABC'})
+    assert db.search(where('s').matches('abc')) == []
+    assert db.search(where('s').matches('abc', flags=re.I)) == [{'s': 'ABC'}]
+    assert db.search(where('s').search('b')) == []
+    assert db.search(where('s').search('b', flags=re.I)) == [{'s': 'ABC'}]
+    assert where('s').matches('a') != where('s').matches('a', flags=re.I)
+
+
+def test_fragment_path_is_part_of_cache_key(db):
+    db.insert({'a': {'x': 1}, 'b': {'x': 2}})
+    assert db.count(Query().a.fragment({'x': 1})) == 1
+    assert db.count(Query().b.fragment({'x': 1})) == 0
+    assert Query().a.fragment({'x': 1}) != Query().b.fragment({'x': 1})
+
+
+def test_fragment_on_non_mapping():
+    query = Query().a.fragment({'x': 1})
+    assert not query({'a': 'xyz'})
+    assert not query({'a': [1]})
+    assert query({'a': {'x': 1}})
+
+
+def test_one_of_generator():
+    query = Query().a.one_of(x for x in [1, 2])
+    assert query({'a': 2})
+    assert query({'a': 2})
+    assert query({'a': 1})
+
+
+def test_query_with_unhashable_rhs_is_cacheable(db):
+    db.insert({'a': [1, 2]})
+    assert db.search(where('a') < [2]) == [{'a': [1, 2]}]
+    assert db.search(where('a').test(lambda v, l: v == l, [1, 2])) \
+        == [{'a': [1, 2]}]
+
+
+def test_frozendict_hash_mixed_keys():
+    assert hash(FrozenDict({1: 'a', 'b': 2})) == \
+        hash(FrozenDict({'b': 2, 1: 'a'}))
+    hash(where('a') == {1: 'a', 'b': 2})
+
+
+def test_path_index_out_of_range():
+    query = Query()['a'].map(lambda v: v[0]) == 1
+    assert not query({'a': []})
+
+
+def test_persist_empty_does_not_wipe_existing_table(db):
+    db.table('t').insert({'a': 1})
+    db._tables.clear()
+    assert db.table('t', persist_empty=True).all() == [{'a': 1}]
+
+
+def test_default_query_cache_capacity_override():
+    class MyTable(Table):
+        default_query_cache_capacity = 2
+
+    assert MyTable(MemoryStorage(), 't')._query_cache.capacity == 2
+    assert MyTable(MemoryStorage(), 't', cache_size=None) \
+        ._query_cache.capacity is None
+
+
+def test_dropped_table_instance_has_no_stale_cache():
+    db = TinyDB(storage=MemoryStorage)
+    table = db.table('t')
+    table.insert({'a': 1})
+    assert len(table.search(where('a') == 1)) == 1
+
+    db.drop_table('t')
+    assert table.search(where('a') == 1) == []
+
+    table = db.table('t2')
+    table.insert({'a': 1})
+    assert len(table.search(where('a') == 1)) == 1
+    db.drop_tables()
+    assert table.search(where('a') == 1) == []
+    assert table.insert({'a': 1}) == 1
+
+
+def test_copy_tinydb_and_query():
+    db = TinyDB(storage=MemoryStorage)
+    db.insert({'a': 1})
+    assert copy.copy(db).all() == [{'a': 1}]
+
+    query = Query().a
+    assert copy.deepcopy(query) == query
+    assert (copy.deepcopy(query == 1))({'a': 1})
+    assert not hasattr(Query(), '__foo__')
+    assert (Query()['__foo__'] == 1)({'__foo__': 1})
+
+
+def test_middleware_missing_storage_raises_attribute_error():
+    middleware = CachingMiddleware(MemoryStorage)
+    del middleware.__dict__['storage']
+    with pytest.raises(AttributeError):
+        middleware.foo
+
+
+def test_create_dirs_without_directory(tmp_path, monkeypatch):
+    monkeypatch.chdir(tmp_path)
+    db = TinyDB('db.json', create_dirs=True)
+    db.insert({'a': 1})
+    db.close()
+    assert os.path.exists(tmp_path / 'db.json')
+
+
+def test_binary_access_mode(tmp_path):
+    path = tmp_path / 'db.json'
+    db = TinyDB(path, access_mode='rb+')
+    db.insert({'a': 'ä'})
+    db.close()
+
+    db = TinyDB(path, storage=JSONStorage)
+    assert db.all() == [{'a': 'ä'}]
+    db.close()
