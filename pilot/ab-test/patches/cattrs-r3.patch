+# Subclasses
+
+
+def test_subclasses_of_slotted_dataclass():
+    """Non-slotted subclasses of slotted dataclasses are found."""
+
+    @dataclasses.dataclass(slots=True)
+    class Parent:
+        a: int
+
+    @dataclasses.dataclass
+    class Child(Parent):
+        b: int
+
+    class Plain(Parent):
+        pass
+
+    @dataclasses.dataclass(slots=True)
+    class Slotted(Parent):
+        c: int
+
+    res = subclasses(Parent)
+    assert Child in res
+    assert Plain in res
+    assert Slotted in res
+    assert len(res) == 3
+
+
+def test_subclasses_of_attrs_no_duplicates():
+    @attrs.define
+    class Parent:
+        a: int
+
+    @attrs.define
+    class Child(Parent):
+        b: int
+
+    res = subclasses(Parent)
+    assert res == [Child]
+    gc.collect()
+
