@@ -4,6 +4,7 @@
 Tests for `attr.converters`.
 """
 
+import functools
 import pickle
 
 import pytest
@@ -364,3 +365,39 @@ class TestToBool:
         assert not to_bool("f")
         assert not to_bool("no")
         assert not to_bool("off")
+
+
+class TestConverterNonFunctionCallables:
+    def test_partial_with_self_and_field(self):
+        """
+        Converters taking self and field that are partials with a return
+        annotation don't crash and don't get their annotations mutated.
+        """
+
+        def f(x, inst, field, scale) -> int:
+            return int(x) * scale
+
+        c = Converter(
+            functools.partial(f, scale=2), takes_self=True, takes_field=True
+        )
+
+        assert 4 == c("2", None, None)
+        assert int is c.__call__.__annotations__["return"]
+
+    def test_callable_instance_with_self_and_field(self):
+        """
+        Callable instances with a return annotation work as converters taking
+        self and field.
+        """
+
+        class Conv:
+            def __call__(self, x, inst, field) -> int:
+                return int(x)
+
+        @attr.define
+        class C:
+            x: int = attr.field(
+                converter=Converter(Conv(), takes_self=True, takes_field=True)
+            )
+
+        assert 3 == C("3").x
