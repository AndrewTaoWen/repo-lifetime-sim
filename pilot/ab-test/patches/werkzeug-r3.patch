+def test_limited_stream_readinto_short_read():
+    class Short(io.RawIOBase):
+        def __init__(self, data):
+            self.data = data
+
+        def readable(self):
+            return True
+
+        def readinto(self, b):
+            n = min(len(b), 3, len(self.data))
+            b[:n] = self.data[:n]
+            self.data = self.data[n:]
+            return n
+
+    stream = LimitedStream(Short(b"abcdefghij"), 5)
+    buf = bytearray(10)
+    assert stream.readinto(buf) == 3
+    assert len(buf) == 10
+    assert bytes(buf[:3]) == b"abc"
+    assert stream.read() == b"de"
+
