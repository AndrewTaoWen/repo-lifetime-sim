+    def test_update_larger_no_overeviction(self):
+        # updating an item with a larger value must only evict other
+        # items if the new value does not fit otherwise
+        cache = self.Cache(maxsize=10, getsizeof=lambda x: x)
+        cache[1] = 3
+        cache[2] = 5
+        cache[2] = 6
+        self.assertEqual(2, len(cache))
