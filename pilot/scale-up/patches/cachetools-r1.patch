+class _Base:
+    def __init__(self):
+        self.cache = {}
+        self.count = 0
+
+    @cachedmethod(lambda self: self.cache)
+    def get(self, value):
+        self.count += 1
+        return ("base", value)
+
+    @cachedmethod(lambda self: self.cache, key=keys.hashkey, info=True)
+    def get_info(self, value):
+        self.count += 1
+        return ("base", value)
+
+
+class _Override(_Base):
+    def get(self, value):
+        return ("override",) + super().get(value)
+
+    def get_info(self, value):
+        return ("override",) + super().get_info(value)
+
+
+class _CachedOverride(_Base):
+    def __init__(self):
+        super().__init__()
+        self.subcache = {}
+
+    @cachedmethod(lambda self: self.subcache)
+    def get(self, value):
+        return ("override",) + super().get(value)
+
+
+class _Picklable:
+    def __init__(self):
+        self.cache = {}
+        self.count = 0
+
+    @cachedmethod(lambda self: self.cache)
+    def get(self, value):
+        self.count += 1
+        return value
+
+    @cachedmethod(lambda self: self.cache, key=keys.hashkey, info=True)
+    def get_info(self, value):
+        self.count += 1
+        return value
+
+
+class InheritanceTest(unittest.TestCase):
+    def test_super_does_not_shadow_override(self):
+        obj = _Override()
+        self.assertEqual(("override", "base", 1), obj.get(1))
+        self.assertEqual(("override", "base", 2), obj.get(2))
+        self.assertEqual(("override", "base", 1), obj.get(1))
+        self.assertEqual(2, obj.count)
+        self.assertEqual(("override", "base", 1), obj.get_info(1))
+        self.assertEqual(("override", "base", 1), obj.get_info(1))
+        self.assertNotIn("get", obj.__dict__)
+        self.assertNotIn("get_info", obj.__dict__)
+
+    def test_super_cached_override(self):
+        obj = _CachedOverride()
+        self.assertEqual(("override", "base", 1), obj.get(1))
+        self.assertEqual(("override", "base", 1), obj.get(1))
+        self.assertEqual(1, obj.count)
+        self.assertEqual(1, len(obj.cache))
+        self.assertEqual(1, len(obj.subcache))
+
+    def test_base_still_stores_wrapper(self):
+        obj = _Base()
+        obj.get(1)
+        self.assertIs(obj.get, obj.__dict__["get"])
