+    c = Converter()
+    configure_union_passthrough(Union[int, str], c)
+    copy = c.copy()
+    copy.register_structure_hook(Simple, lambda _, __: "custom")
+    assert copy.structure({"a": 1}, Union[int, Simple]) == "custom"
+    assert copy.structure(1, Union[int, Simple]) == 1
