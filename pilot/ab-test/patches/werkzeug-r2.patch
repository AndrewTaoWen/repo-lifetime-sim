+def _cookie_app(environ, start_response):  # type: ignore[no-untyped-def]
+    request = Request(environ)
+    response = Response(request.headers.get("Cookie", ""))
+
+    if request.path == "/set-dot":
+        response.headers.add("Set-Cookie", "a=1; Domain=.Example.COM; Path=/")
+    elif request.path == "/expire-past":
+        response.headers.add(
+            "Set-Cookie",
+            f"a=; Domain=example.com; Path=/; Expires={http_date(1000)}",
+        )
+    elif request.path == "/expire-negative":
+        response.headers.add("Set-Cookie", "a=; Domain=example.com; Max-Age=-1")
+
+    return response(environ, start_response)
+
+
+def test_client_cookie_leading_dot_domain() -> None:
+    client = Client(_cookie_app)
+    client.get("/set-dot", "http://example.com/")
+    assert client.get("/", "http://sub.example.com/").text == "a=1"
+    assert client.get("/", "http://example.com/").text == "a=1"
+
+
+@pytest.mark.parametrize("path", ["/expire-past", "/expire-negative"])
+def test_client_cookie_expired_removed(path: str) -> None:
+    client = Client(_cookie_app)
+    client.get("/set-dot", "http://example.com/")
+    client.get(path, "http://example.com/")
+    assert client.get_cookie("a", domain="example.com") is None
+
+
+def test_client_cookie_future_expires_kept() -> None:
+    client = Client(_cookie_app)
+    future = datetime.now(timezone.utc) + timedelta(days=1)
+
+    with warnings.catch_warnings():
+        warnings.simplefilter("ignore")
+        client.set_cookie("b", "2", expires=future)
+
+    assert client.get_cookie("b") is not None
