diff --git a/tests/test_regressions.py b/tests/test_regressions.py
new file mode 100644
index 0000000..a8ae5c6
--- /dev/null
+++ b/tests/test_regressions.py
@@ -0,0 +1,227 @@
+"""Regression tests for latent bugs (edge cases in fields, schemas and validators)."""
+
+import datetime as dt
+
+import pytest
+
+from marshmallow import (
+    INCLUDE,
+    RAISE,
+    Schema,
+    class_registry,
+    fields,
+    pre_load,
+    validate,
+    validates,
+    validates_schema,
+)
+from marshmallow.exceptions import ValidationError
+from marshmallow.experimental.context import Context
+
+
+class TestSchemaValidatorsWithMismatchedOriginalData:
+    def test_pre_load_pass_collection_changes_length(self):
+        seen = []
+
+        class MySchema(Schema):
+            a = fields.Int()
+
+            @pre_load(pass_collection=True)
+            def drop_zeros(self, data, many, **kwargs):
+                return [d for d in data if d.get("a") != 0] if many else data
+
+            @validates_schema(pass_original=True)
+            def check(self, data, original_data, **kwargs):
+                seen.append(data)
+
+        result = MySchema(many=True).load([{"a": 0}, {"a": 1}])
+        assert result == [{"a": 1}]
+        assert seen == [{"a": 1}]
+
+    def test_many_with_non_collection_input_and_no_skip(self):
+        class MySchema(Schema):
+            a = fields.Int()
+
+            @validates_schema(skip_on_field_errors=False)
+            def check(self, data, **kwargs):
+                pass
+
+        with pytest.raises(ValidationError) as excinfo:
+            MySchema(many=True).load({"a": 1, "b": 2})
+        assert excinfo.value.messages == {"_schema": ["Invalid input type."]}
+
+
+class TestFieldValidatorWithAttribute:
+    def test_invalid_value_removed_from_valid_data(self):
+        class MySchema(Schema):
+            x = fields.Int(attribute="y")
+
+            @validates("x")
+            def validate_x(self, value, **kwargs):
+                if value < 0:
+                    raise ValidationError("negative")
+
+        with pytest.raises(ValidationError) as excinfo:
+            MySchema(many=True).load([{"x": -1}, {"x": 1}])
+        assert excinfo.value.messages == {0: {"x": ["negative"]}}
+        assert excinfo.value.valid_data == [{}, {"y": 1}]
+
+        with pytest.raises(ValidationError) as excinfo:
+            MySchema().load({"x": -1})
+        assert excinfo.value.valid_data == {}
+
+    def test_dotted_attribute_is_validated(self):
+        class MySchema(Schema):
+            x = fields.Int(attribute="y.z")
+
+            @validates("x")
+            def validate_x(self, value, **kwargs):
+                if value < 0:
+                    raise ValidationError("negative")
+
+        assert MySchema().load({"x": 1}) == {"y": {"z": 1}}
+        with pytest.raises(ValidationError) as excinfo:
+            MySchema().load({"x": -1})
+        assert excinfo.value.messages == {"x": ["negative"]}
+        assert excinfo.value.valid_data == {"y": {}}
+
+
+class TestNestedOptionsOnUnknownField:
+    class MySchema(Schema):
+        a = fields.Int()
+
+    def test_only(self):
+        with pytest.raises(ValueError, match="Invalid fields"):
+            self.MySchema(only=("zz.a",))
+
+    def test_exclude(self):
+        with pytest.raises(ValueError, match="Invalid fields"):
+            self.MySchema(exclude=("zz.a",))
+
+
+def test_unknown_include_preserves_input_order():
+    class MySchema(Schema):
+        a = fields.Int()
+
+    data = {"z": 1, "y": 2, "a": 3, "x": 4, "w": 5}
+    result = MySchema(unknown=INCLUDE).load(data)
+    assert list(result) == ["a", "z", "y", "x", "w"]
+
+    with pytest.raises(ValidationError) as excinfo:
+        MySchema(unknown=RAISE).load(data)
+    assert list(excinfo.value.messages) == ["z", "y", "x", "w"]
+
+
+def test_timedelta_nan_is_invalid():
+    with pytest.raises(ValidationError, match="Not a valid period of time."):
+        fields.TimeDelta().deserialize("nan")
+    with pytest.raises(ValidationError, match="Not a valid period of time."):
+        fields.TimeDelta().deserialize(float("nan"))
+
+
+def test_date_field_rejects_datetime():
+    with pytest.raises(ValidationError, match="Not a valid date."):
+        fields.Date().deserialize(dt.datetime(2020, 1, 1, 5))
+    assert fields.Date().deserialize(dt.date(2020, 1, 1)) == dt.date(2020, 1, 1)
+
+
+def test_function_without_serialize_is_skipped_on_dump():
+    schema = Schema.from_dict({"f": fields.Function(), "a": fields.Int()})()
+    assert schema.dump({"a": 1}) == {"a": 1}
+
+
+def test_constant_callable_not_called_on_load():
+    schema = Schema.from_dict({"c": fields.Constant(len)})()
+    assert schema.load({}) == {"c": len}
+    assert schema.load({"c": 1}) == {"c": len}
+    assert schema.dump({}) == {"c": len}
+
+
+class TestPreLoadReturningNone:
+    def test_not_allowed(self):
+        field = fields.Int(pre_load=lambda v: None if v == "" else v)
+        with pytest.raises(ValidationError, match="Field may not be null."):
+            field.deserialize("")
+
+    def test_allowed(self):
+        field = fields.Int(pre_load=lambda v: None if v == "" else v, allow_none=True)
+        assert field.deserialize("") is None
+
+
+def test_dict_errors_are_plain_dict():
+    with pytest.raises(ValidationError) as excinfo:
+        fields.Dict(keys=fields.Str()).deserialize({1: 2})
+    assert type(excinfo.value.messages) is dict
+    assert excinfo.value.messages == {1: {"key": ["Not a valid string."]}}
+
+
+def test_registry_redefinition_in_same_module_updates_classname_lookup():
+    first = type("MyRedefinedSchema", (Schema,), {"__module__": "redefmod"})
+    second = type("MyRedefinedSchema", (Schema,), {"__module__": "redefmod"})
+    assert first is not second
+    assert class_registry.get_class("MyRedefinedSchema") is second
+    assert class_registry.get_class("redefmod.MyRedefinedSchema") is second
+
+
+class TestContextReentrancy:
+    def test_same_instance_nested(self):
+        ctx = Context({"a": 1})
+        with ctx:
+            with ctx:
+                assert Context.get() == {"a": 1}
+            assert Context.get() == {"a": 1}
+        assert Context.get(None) is None
+
+    def test_same_instance_reused_sequentially(self):
+        ctx = Context({"a": 1})
+        with ctx:
+            pass
+        with ctx:
+            assert Context.get() == {"a": 1}
+        assert Context.get(None) is None
+
+
+class TestURLRelativeWithSchemeInQuery:
+    def test_relative_url_with_url_in_query(self):
+        validator = validate.URL(relative=True)
+        value = "/login?next=https://example.com"
+        assert validator(value) == value
+
+    def test_absolute_url_still_rejects_bad_scheme(self):
+        with pytest.raises(ValidationError):
+            validate.URL()("javascript://example.com")
+        with pytest.raises(ValidationError):
+            validate.URL(relative=True)("javascript://example.com")
+
+
+class TestValidatorsWithGenerators:
+    def test_one_of(self):
+        validator = validate.OneOf(x for x in "abc")
+        assert validator("a") == "a"
+        assert validator("c") == "c"
+        with pytest.raises(ValidationError, match="Must be one of: a, b, c."):
+            validator("d")
+
+    def test_one_of_labels(self):
+        validator = validate.OneOf("ab", labels=(x for x in ("A", "B")))
+        assert validator.labels_text == "A, B"
+        assert list(validator.options()) == [("a", "A"), ("b", "B")]
+
+    def test_none_of(self):
+        validator = validate.NoneOf(x for x in "abc")
+        with pytest.raises(ValidationError):
+            validator("a")
+        assert validator("d") == "d"
+
+    def test_contains_only(self):
+        validator = validate.ContainsOnly(x for x in "abc")
+        assert validator(["a", "b"]) == ["a", "b"]
+
+
+class TestContainsValidatorsWithUnhashableValues:
+    def test_contains_only(self):
+        with pytest.raises(ValidationError):
+            validate.ContainsOnly({"a"})([{"x": 1}])
+
+    def test_contains_none_of(self):
+        assert validate.ContainsNoneOf({"a"})([{"x": 1}]) == [{"x": 1}]
