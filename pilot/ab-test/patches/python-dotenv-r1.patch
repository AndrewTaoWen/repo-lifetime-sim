+
+
+def test_rewrite_removes_temp_file_when_closing_it_fails(dotenv_path, monkeypatch):
+    dotenv_path.write_text("a=b\n")
+    real_tempfile = dotenv.main.tempfile.NamedTemporaryFile
+
+    class FailingClose:
+        def __init__(self, *args, **kwargs):
+            self.file = real_tempfile(*args, **kwargs)
+            self.name = self.file.name
+
+        def __enter__(self):
+            return self.file.__enter__()
+
+        def __exit__(self, *exc):
+            self.file.__exit__(*exc)
