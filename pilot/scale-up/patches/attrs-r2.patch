+def test_asdict_namedtuple_in_list_retain_collection_types():
+    """
+    Namedtuples nested in collections are rebuilt correctly when retaining
+    collection types instead of crashing.
+    """
+
+    class NT(NamedTuple):
+        a: int
+        b: int
+
+    @attr.s
+    class C:
+        x = attr.ib()
+
+    assert {"x": [NT(1, 2)]} == asdict(
+        C([NT(1, 2)]), retain_collection_types=True
+    )
