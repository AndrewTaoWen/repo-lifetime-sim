+def test_parsestream_binary_and_codecs_streams():
+    import codecs
+    import io
+    data = 'select 1; select "ä";'.encode('utf-8')
+    expected = ['select 1; ', 'select "ä";']
+    stmts = [str(s) for s in sqlparse.parsestream(io.BytesIO(data))]
+    assert stmts == expected
+    reader = codecs.getreader('utf-8')(io.BytesIO(data))
+    stmts = [str(s) for s in sqlparse.parsestream(reader)]
+    assert stmts == expected
+    latin = io.BytesIO('select "ä";'.encode('latin-1'))
+    stmts = [str(s) for s in sqlparse.parsestream(latin, 'latin-1')]
+    assert stmts == ['select "ä";']
+
