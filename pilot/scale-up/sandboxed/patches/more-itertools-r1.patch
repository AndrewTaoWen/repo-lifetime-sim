+class RunningWindowRegressionTests(TestCase):
+    def test_running_mean_window_recovers_from_inf_and_nan(self):
+        inf = float('inf')
+        actual = list(mi.running_mean([inf, 1, 2, 3], maxlen=1))
+        self.assertEqual(actual, [inf, 1.0, 2.0, 3.0])
+        actual = list(mi.running_mean([1, -inf, 3, 5, 7], maxlen=2))
+        self.assertEqual(actual, [1.0, -inf, -inf, 4.0, 6.0])
+        actual = list(mi.running_mean([float('nan'), 2, 4], maxlen=1))
+        self.assertNotEqual(actual[0], actual[0])
+        self.assertEqual(actual[1:], [2.0, 4.0])
+
+    def test_running_mean_window_exact_types_unchanged(self):
+        data = [Fraction(1, 3), Fraction(2, 5), 7, Fraction(-1, 2)]
+        actual = list(mi.running_mean(data, maxlen=2))
+        expected = [
+            Fraction(1, 3),
+            (Fraction(1, 3) + Fraction(2, 5)) / 2,
+            (Fraction(2, 5) + 7) / 2,
+            (7 + Fraction(-1, 2)) / 2,
+        ]
+        self.assertEqual(actual, expected)
+
+    def test_running_window_maxlen_must_be_integer(self):
+        for func in (mi.running_mean, mi.running_min, mi.running_max):
+            with self.subTest(func=func):
+                with self.assertRaises(TypeError):
+                    list(func([0, 1, 2, 3, 4], maxlen=2.5))
+                with self.assertRaises(ValueError):
+                    func([0, 1, 2], maxlen=0)
