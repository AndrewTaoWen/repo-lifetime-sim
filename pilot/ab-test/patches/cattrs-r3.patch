+@pytest.mark.parametrize("converter_cls", [BaseConverter, Converter])
+def test_tuple_strategy_kw_only(converter_cls):
+    @attrs.define
+    class C:
+        a: int
+        b: int = attrs.field(kw_only=True)
+        _c: int = 0
+
+    @dataclasses.dataclass
+    class D:
+        a: int
+        b: int = dataclasses.field(kw_only=True)
+
+    c = converter_cls(unstruct_strat=UnstructureStrategy.AS_TUPLE)
+    assert c.structure(c.unstructure(C(1, b=2, c=3)), C) == C(1, b=2, c=3)
+    assert c.structure(c.unstructure(D(1, b=2)), D) == D(1, b=2)
