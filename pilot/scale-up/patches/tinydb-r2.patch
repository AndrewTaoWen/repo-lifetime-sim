+
+# --- Regression tests -------------------------------------------------------
+
+def test_insert_multiple_explicit_id_not_overwritten(db: TinyDB):
+    db.truncate()
+    ids = db.insert_multiple([
+        Document({'n': 'x'}, doc_id=2), {'n': 'y'}, {'n': 'z'}
+    ])
+
+    assert len(set(ids)) == 3
+    assert len(db) == 3
+    assert db.get(doc_id=2) == {'n': 'x'}
+    assert sorted(d['n'] for d in db.all()) == ['x', 'y', 'z']
+
+    # The following automatic IDs must not collide either
+    new_id = db.insert({'n': 'w'})
+    assert new_id not in ids
+    assert len(db) == 4
+
+
+def test_remove_duplicate_doc_ids(db: TinyDB):
+    assert db.remove(doc_ids=[1, 1]) == [1]
+    assert len(db) == 2
+
+
+def test_update_duplicate_doc_ids(db: TinyDB):
+    from tinydb.operations import increment
+    assert db.update(increment('int'), doc_ids=[1, 1]) == [1]
+    assert db.get(doc_id=1)['int'] == 2
+
+
+def test_update_multiple_with_generator(db: TinyDB):
+    from tinydb.operations import increment
+    updates = ((increment('int'), where('char') == c) for c in 'ac')
+    assert sorted(db.update_multiple(updates)) == [1, 3]
+    assert [d['int'] for d in db.all()] == [2, 1, 2]
+
+
+def test_search_result_modification_does_not_affect_cache(db: TinyDB):
+    results = db.search(where('char') == 'a')
+    results[0]['char'] = 'modified'
+    results.append('junk')
+
+    assert db.search(where('char') == 'a') == [{'int': 1, 'char': 'a'}]
+
+    results = db.search(where('char') == 'a')
+    results[0]['char'] = 'modified'
+    assert db.search(where('char') == 'a') == [{'int': 1, 'char': 'a'}]
+
+
+def test_failed_update_is_atomic(db: TinyDB):
+    db.insert({'other': 1})
+    # Prime the query cache
+    assert len(db.search(where('int') == 1)) == 3
+
+    def fail_on_missing(doc):
+        doc['int'] += 1  # raises KeyError for the last document
+
+    with pytest.raises(KeyError):
+        db.update(fail_on_missing)
+
+    assert [d.get('int') for d in db.all()] == [1, 1, 1, None]
+    assert len(db.search(where('int') == 1)) == 3
+    assert db.search(where('int') == 2) == []
+
+
+def test_search_unhashable_query(db: TinyDB):
+    db.insert({'lst': [1, 2]})
+    assert db.search(where('lst') < [3]) == [{'lst': [1, 2]}]
+    assert db.search(
+        where('lst').test(lambda v, x: v == x, [1, 2])
+    ) == [{'lst': [1, 2]}]
+    # Cached results are returned on the second call
+    assert db.search(where('lst') < [3]) == [{'lst': [1, 2]}]
+
+
+def test_get_by_string_doc_id_returns_int_id(db: TinyDB):
+    assert db.get(doc_id='1').doc_id == 1
+
+
+def test_drop_table_resets_held_table_instance():
+    db = TinyDB(storage=MemoryStorage)
+    table = db.table('t')
+    table.insert({'a': 1})
+    assert len(table.search(where('a') == 1)) == 1
+
+    db.drop_table('t')
+    assert table.search(where('a') == 1) == []
+    assert table.insert({'a': 2}) == 1
+
+    db.drop_tables()
+    assert table.search(where('a') == 2) == []
+
+
+def test_copy_database_does_not_recurse():
+    import copy
+    db = TinyDB(storage=MemoryStorage)
+    db.insert({'a': 1})
+    db2 = copy.copy(db)
+    assert db2.all() == [{'a': 1}]
+
+
+def test_copy_middleware_does_not_recurse():
+    import copy
+    storage = CachingMiddleware(MemoryStorage)()
+    storage.write({'a': {}})
+    assert copy.copy(storage).read() == {'a': {}}
