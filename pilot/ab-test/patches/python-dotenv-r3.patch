diff --git a/tests/test_main.py b/tests/test_main.py
index 1c33c80..71e1d7f 100644
--- a/tests/test_main.py
+++ b/tests/test_main.py
@@ -708,3 +708,85 @@ def test_dotenv_values_file_stream(dotenv_path):
         result = dotenv.dotenv_values(stream=f)
 
     assert result == {"a": "b"}
+
+
+@pytest.mark.parametrize(
+    "value",
+    ["x\\\\y", "a\\", "C:\\dir\\", "it's", "a\\'b", 'a"b', "line1\nline2"],
+)
+@pytest.mark.parametrize("quote_mode", ["always", "auto"])
+def test_set_key_round_trips_backslashes_and_quotes(dotenv_path, value, quote_mode):
+    dotenv.set_key(dotenv_path, "a", value, quote_mode=quote_mode)
+    dotenv.set_key(dotenv_path, "b", "c", quote_mode=quote_mode)
+
+    assert dotenv.dotenv_values(dotenv_path, interpolate=False) == {
+        "a": value,
+        "b": "c",
+    }
+
+
+def test_rewrite_closes_source_when_tempfile_fails(dotenv_path):
+    dotenv_path.write_text("a=x\n")
+    real_open = open
+    opened_handles = []
+
+    def tracking_open(*args, **kwargs):
+        handle = real_open(*args, **kwargs)
+        opened_handles.append(handle)
+        return handle
+
+    with mock.patch(
+        "dotenv.main.tempfile.NamedTemporaryFile", side_effect=PermissionError
+    ):
+        with mock.patch("dotenv.main.open", side_effect=tracking_open):
+            with pytest.raises(PermissionError):
+                dotenv.set_key(dotenv_path, "a", "y")
+
+    assert opened_handles
+    assert all(handle.closed for handle in opened_handles)
+    assert dotenv_path.read_text() == "a=x\n"
+
+
+def test_dotenv_values_many_keys_does_not_copy_environ_per_key():
+    stream = io.StringIO("".join(f"K{i}=${{K{i - 1}}}\n" for i in range(2000)))
+
+    with mock.patch.dict(os.environ, {f"E{i}": "x" for i in range(5000)}):
+        result = dotenv.dotenv_values(stream=stream)
+
+    assert len(result) == 2000
+    assert result["K1999"] == ""
+
+
+@pytest.mark.parametrize("override", [True, False])
+def test_load_dotenv_interpolation_precedence(override):
+    stream = io.StringIO("a=file\nb=${a}\n")
+
+    with mock.patch.dict(os.environ, {"a": "env"}, clear=True):
+        dotenv.load_dotenv(stream=stream, override=override)
+        b = os.environ["b"]
+
+    assert b == ("file" if override else "env")
+
+
+def test_find_dotenv_from_zipapp_falls_back_to_cwd(tmp_path):
+    from zipfile import ZipFile
+
+    app = tmp_path / "app.zip"
+    with ZipFile(app, "w") as zf:
+        zf.writestr(
+            "__main__.py",
+            "from dotenv import find_dotenv\nprint(find_dotenv())\n",
+        )
+    workdir = tmp_path / "work"
+    workdir.mkdir()
+    (workdir / ".env").write_text("a=b\n")
+
+    out = subprocess.run(
+        [sys.executable, str(app)],
+        cwd=workdir,
+        capture_output=True,
+        text=True,
+        check=True,
+    ).stdout
+
+    assert out.strip() == str(workdir / ".env")
diff --git a/tests/test_parser.py b/tests/test_parser.py
index 4ec5a5a..9afaaa4 100644
--- a/tests/test_parser.py
+++ b/tests/test_parser.py
@@ -580,3 +580,29 @@ def test_parse_stream(test_input, expected):
     result = parse_stream(io.StringIO(test_input))
 
     assert list(result) == expected
+
+
+@pytest.mark.parametrize(
+    "test_input,expected",
+    [
+        ('a="foo\\\\"\nb="bar"\n', [("a", "foo\\"), ("b", "bar")]),
+        ("a='foo\\\\'\nb='bar'\n", [("a", "foo\\"), ("b", "bar")]),
+        ("a='C:\\'\nb=c\n", [("a", "C:\\"), ("b", "c")]),
+        ('a="x\\"y"\n', [("a", 'x"y')]),
+        ("a= # comment\nb=c\n", [("a", ""), ("b", "c")]),
+        ("a=\t#comment", [("a", "")]),
+        ("a=#not-a-comment", [("a", "#not-a-comment")]),
+    ],
+)
+def test_parse_stream_escaped_backslash_and_empty_comment(test_input, expected):
+    result = parse_stream(io.StringIO(test_input))
+
+    assert [(b.key, b.value) for b in result if b.key is not None] == expected
+
+
+def test_parse_stream_unquoted_value_with_many_spaces_is_fast():
+    value = "a" + " " * 200_000 + "b"
+
+    (binding,) = parse_stream(io.StringIO(f"x={value}"))
+
+    assert binding.value == value
