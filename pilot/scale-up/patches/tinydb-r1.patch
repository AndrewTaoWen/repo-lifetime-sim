+++ b/tests/test_regressions.py
@@ -0,0 +1,279 @@
+"""
+Regression tests for latent bugs fixed during hardening.
+"""
+import copy
+import os
+import re
+
+import pytest
+
+from tinydb import TinyDB, Query, where
+from tinydb.middlewares import CachingMiddleware
+from tinydb.storages import MemoryStorage, JSONStorage
+from tinydb.table import Document, Table
+from tinydb.utils import freeze
+
+
+@pytest.fixture
+def mdb():
+    return TinyDB(storage=MemoryStorage)
+
+
+# --- Table -------------------------------------------------------------------
+
+def test_persist_empty_does_not_wipe_existing_table(mdb):
+    mdb.table('t').insert({'a': 1})
+
+    # A fresh table instance on the same storage with persist_empty=True
+    Table(mdb.storage, 't', persist_empty=True)
+
+    assert Table(mdb.storage, 't').all() == [{'a': 1}]
+
+
+def test_default_query_cache_capacity_override():
+    class MyTable(Table):
+        default_query_cache_capacity = 42
+
+    assert MyTable(MemoryStorage(), 't')._query_cache.capacity == 42
+    assert Table(MemoryStorage(), 't')._query_cache.capacity == 10
+    assert Table(MemoryStorage(), 't', cache_size=None) \
+        ._query_cache.capacity is None
+
+
+def test_insert_multiple_explicit_id_not_overwritten(mdb):
+    mdb.insert({'first': 1})  # caches next id = 2
+
+    ids = mdb.insert_multiple([Document({'x': 1}, doc_id=2), {'y': 1}])
+
+    assert len(set(ids)) == 2
+    assert ids[0] == 2
+    assert mdb.get(doc_id=2) == {'x': 1}
+    assert len(mdb) == 3
+
+    # Subsequent inserts must not collide either
+    new_id = mdb.insert({'z': 1})
+    assert new_id not in (1, 2, ids[1])
+
+
+def test_insert_multiple_explicit_id_on_empty_table(mdb):
+    ids = mdb.insert_multiple([Document({'x': 1}, doc_id=1), {'y': 1}])
+    assert ids == [1, 2]
+    assert mdb.get(doc_id=1) == {'x': 1}
+    assert mdb.get(doc_id=2) == {'y': 1}
+
+
+def test_insert_document_with_str_id_does_not_duplicate(mdb):
+    mdb.insert(Document({'a': 1}, doc_id=1))
+    with pytest.raises(ValueError):
+        mdb.insert(Document({'a': 2}, doc_id='1'))  # type: ignore
+    assert mdb.get(doc_id=1) == {'a': 1}
+
+
+def test_search_cache_not_corrupted_by_mutating_results(mdb):
+    mdb.insert({'v': 1})
+
+    result = mdb.search(where('v') == 1)
+    result[0]['v'] = 99
+
+    assert mdb.search(where('v') == 1) == [{'v': 1}]
+
+    # Mutating a result coming from the cache must not affect it either
+    result = mdb.search(where('v') == 1)
+    result[0]['v'] = 99
+    assert mdb.search(where('v') == 1) == [{'v': 1}]
+    assert mdb.search(where('v') == 1)[0].doc_id == 1
+
+
+def test_search_with_unhashable_query(mdb):
+    mdb.insert({'v': 1})
+
+    class Unhashable:
+        __hash__ = None  # type: ignore
+
+        def __call__(self, doc):
+            return True
+
+    assert mdb.search(Unhashable()) == [{'v': 1}]  # type: ignore
+
+
+def test_get_by_doc_id_uses_document_id_class(mdb):
+    mdb.insert({'v': 1})
+    assert mdb.get(doc_id='1').doc_id == 1  # type: ignore
+
+
+def test_remove_duplicate_doc_ids(mdb):
+    mdb.insert_multiple([{'v': 1}, {'v': 2}])
+    assert mdb.remove(doc_ids=[1, 1]) == [1]
+    assert mdb.all() == [{'v': 2}]
+
+
+def test_update_duplicate_doc_ids(mdb):
+    mdb.insert({'v': 1})
+
+    def inc(doc):
+        doc['v'] += 1
+
+    assert mdb.update(inc, doc_ids=[1, 1]) == [1]
+    assert mdb.get(doc_id=1) == {'v': 2}
+
+
+def test_update_multiple_with_generator(mdb):
+    mdb.insert_multiple([{'v': 1}, {'v': 1}])
+
+    updates = (({'w': 1}, where('v') == 1) for _ in range(1))
+    assert mdb.update_multiple(updates) == [1, 2]
+    assert mdb.count(where('w') == 1) == 2
+
+
+def test_update_multiple_returns_unique_ids(mdb):
+    mdb.insert({'v': 1})
+    ids = mdb.update_multiple([
+        ({'a': 1}, where('v') == 1),
+        ({'b': 1}, where('v') == 1),
+    ])
+    assert ids == [1]
+    assert mdb.get(doc_id=1) == {'v': 1, 'a': 1, 'b': 1}
+
+
+@pytest.mark.parametrize('wrap', [False, True])
+def test_failed_update_is_atomic_in_memory(wrap):
+    if wrap:
+        db = TinyDB(storage=CachingMiddleware(MemoryStorage))
+    else:
+        db = TinyDB(storage=MemoryStorage)
+    db.insert_multiple([{'v': 1}, {'x': 1}])
+
+    def inc(doc):
+        doc['v'] += 1  # fails for the second document
+
+    with pytest.raises(KeyError):
+        db.update(inc)
+
+    assert db.all() == [{'v': 1}, {'x': 1}]
+
+
+# --- TinyDB ------------------------------------------------------------------
+
+def test_drop_tables_invalidates_held_table_cache(mdb):
+    table = mdb.table('t')
+    table.insert({'v': 1})
+    assert table.search(where('v') == 1) == [{'v': 1}]
+
+    mdb.drop_tables()
+
+    assert table.search(where('v') == 1) == []
+    assert table.insert({'v': 2}) == 1
+
+
+def test_drop_table_invalidates_held_table_cache(mdb):
+    table = mdb.table('t')
+    table.insert({'v': 1})
+    assert table.count(where('v') == 1) == 1
+
+    mdb.drop_table('t')
+
+    assert table.count(where('v') == 1) == 0
+
+
+def test_copy_tinydb_does_not_recurse(mdb):
+    # Must not raise RecursionError
+    copy.copy(mdb)
+
+
+# --- Storages / middlewares --------------------------------------------------
+
+def test_create_dirs_without_directory(tmp_path, monkeypatch):
+    monkeypatch.chdir(tmp_path)
+    JSONStorage('db.json', create_dirs=True).close()
+    assert os.path.exists(tmp_path / 'db.json')
+
+
+def test_caching_middleware_closes_storage_if_flush_fails(tmp_path):
+    path = str(tmp_path / 'db.json')
+    storage = CachingMiddleware(JSONStorage)(path)
+    storage.write({'_default': {'1': {'v': object()}}})
+
+    with pytest.raises(TypeError):
+        storage.close()
+
+    assert storage.storage._handle.closed
+
+
+# --- Queries -----------------------------------------------------------------
+
+def test_regex_flags_part_of_query_hash(mdb):
+    mdb.insert({'n': 'Abc'})
+
+    assert mdb.search(where('n').matches('a')) == []
+    assert mdb.search(where('n').matches('a', flags=re.I)) == [{'n': 'Abc'}]
+    assert mdb.search(where('n').search('b')) == [{'n': 'Abc'}]
+    assert mdb.search(where('n').search('B', flags=re.I)) == [{'n': 'Abc'}]
+    assert mdb.search(where('n').search('B')) == []
+
+
+def test_fragment_hash_includes_path(mdb):
+    mdb.insert({'a': {'x': 1}, 'b': {'x': 2}})
+
+    assert len(mdb.search(Query().a.fragment({'x': 1}))) == 1
+    assert mdb.search(Query().b.fragment({'x': 1})) == []
+    assert Query().a.fragment({'x': 1}) != Query().b.fragment({'x': 1})
+
+
+def test_fragment_on_non_mapping_value():
+    query = Query().a.fragment({'x': 1})
+    assert not query({'a': 'xyz'})
+    assert not query({'a': ['x']})
+    assert query({'a': {'x': 1}})
+
+
+@pytest.mark.parametrize('query', [
+    Query().a > 1,
+    Query().a >= 1,
+    Query().a < 1,
+    Query().a <= 1,
+])
+def test_ordering_with_incomparable_values(mdb, query):
+    mdb.insert_multiple([{'a': None}, {'a': 'x'}, {'a': 1}])
+    # Must not raise TypeError
+    result = mdb.search(query)
+    assert all(doc['a'] == 1 for doc in result)
+
+
+def test_ordering_query_with_unhashable_rhs(mdb):
+    mdb.insert({'a': [1, 2]})
+    assert mdb.search(Query().a < [1, 3]) == [{'a': [1, 2]}]
+    assert mdb.search(Query().a >= [1, 3]) == []
+
+
+def test_test_query_with_unhashable_args(mdb):
+    mdb.insert({'a': 1})
+    query = Query().a.test(lambda v, items: v in items, [1, 2])
+    assert mdb.search(query) == [{'a': 1}]
+    assert mdb.search(query) == [{'a': 1}]
+
+
+def test_any_all_with_non_cacheable_subquery(mdb):
+    mdb.insert({'f': [{'x': 1}]})
+
+    q1 = Query().f.any(Query().map(lambda d: d['x']) == 1)
+    q2 = Query().f.any(Query().map(lambda d: d['x'] + 1) == 1)
+
+    assert not q1.is_cacheable()
+    assert q1 != q2
+    assert len(mdb.search(q1)) == 1
+    assert mdb.search(q2) == []
+
+    q3 = Query().f.all(Query().map(lambda d: d['x']) == 1)
+    assert not q3.is_cacheable()
+
+
+def test_one_of_with_generator(mdb):
+    mdb.insert_multiple([{'a': 1}, {'a': 2}, {'a': 3}])
+    query = Query().a.one_of(x for x in [2, 3])
+    assert mdb.count(query) == 2
+
+
+def test_freeze_mixed_key_types_hashable():
+    hash(freeze({'a': 1, 1: 'b'}))
+    hash(Query().f == {'a': 1, 1: 'b'})
+    assert hash(freeze({'a': 1, 'b': 2})) == hash(freeze({'b': 2, 'a': 1}))
