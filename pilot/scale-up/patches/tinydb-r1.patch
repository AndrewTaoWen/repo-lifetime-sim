+def _safe_compare(compare: Callable[[Any], bool]) -> Callable[[Any], bool]:
+    """
+    Wrap an ordering comparison so that values that can't be compared with
+    the right hand side (e.g. ``None`` vs. an ``int``) don't match instead of
+    making the whole search crash with a ``TypeError``.
+    """
+    def test(value):
+        try:
+            return compare(value)
+        except TypeError:
+            return False
+
+    return test
+
+
+def _sub_query_hash(hashval: tuple, cond: Any) -> Optional[tuple]:
+    """
+    Return ``None`` (= not cacheable) if ``cond`` is a non-cacheable query,
+    otherwise return ``hashval``.
+
+    Non-cacheable queries all share the same (``None``) hash value, so using
+    them as part of another query's hash would make different queries
+    indistinguishable in the query cache.
+    """
+    is_cacheable = getattr(cond, 'is_cacheable', None)
+    if callable(cond) and is_cacheable is not None and not is_cacheable():
+        return None
+
+    return hashval
