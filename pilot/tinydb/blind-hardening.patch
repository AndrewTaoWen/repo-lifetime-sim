+def _materialize(obj):
+    """
+    Convert one-shot iterables (e.g. generators) to a list, as queries are
+    evaluated against many documents and would otherwise exhaust them.
+    """
+    if callable(obj) or isinstance(obj, Container):
+        return obj
+
+    try:
+        return list(obj)
+    except TypeError:
+        return obj
+
+
+def _regex_hashval(name, path, regex, flags):
+    # Only include non-default flags to keep existing hashes unchanged
+    if flags:
+        return (name, path, regex, flags)
+
+    return (name, path, regex)
+
+
+def _nested_hashval(name, path, cond):
+    # A nested query that can't be cached makes the outer query uncacheable,
+    # too. Otherwise two different uncacheable nested queries (both having a
+    # ``None`` hash) would be considered equal by the query cache.
+    is_cacheable = getattr(cond, 'is_cacheable', None)
+    if callable(is_cacheable) and not is_cacheable():
+        return None
+
+    return (name, path, freeze(cond))
+
+
