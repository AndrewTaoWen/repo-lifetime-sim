diff --git a/tests/test_regressions_hardening.py b/tests/test_regressions_hardening.py
new file mode 100644
index 0000000..e605abf
--- /dev/null
+++ b/tests/test_regressions_hardening.py
@@ -0,0 +1,187 @@
+from __future__ import annotations
+
+import copy
+import time
+
+import pytest
+
+import tomlkit
+
+from tomlkit import item
+from tomlkit import parse
+from tomlkit.exceptions import InvalidStringError
+from tomlkit.exceptions import ParseError
+
+
+def test_aot_setitem_keeps_list_in_sync() -> None:
+    doc = parse("[[a]]\nx = 1\n[[a]]\nx = 2\n")
+    doc["a"][0] = {"x": 9}
+    assert doc["a"] == [{"x": 9}, {"x": 2}]
+    assert list.__getitem__(doc["a"], 0) is doc["a"][0]
+    assert parse(doc.as_string())["a"] == [{"x": 9}, {"x": 2}]
+
+
+def test_array_slice_assignment_does_not_corrupt() -> None:
+    a = item([1, 2, 3])
+    with pytest.raises(ValueError):
+        a[0:1] = [5]
+    assert list(a) == [1, 2, 3]
+    assert a.as_string() == "[1, 2, 3]"
+
+
+@pytest.mark.parametrize(
+    "sl",
+    [slice(-2, None), slice(0, 0), slice(None, None, -2), slice(1, 100), slice(-100, 2)],
+)
+def test_array_delete_slices(sl: slice) -> None:
+    a = item([1, 2, 3, 4, 5])
+    expected = [1, 2, 3, 4, 5]
+    del a[sl]
+    del expected[sl]
+    assert list(a) == expected
+    assert parse("x = " + a.as_string())["x"] == expected
+
+
+def test_array_sort_and_imul_update_rendering() -> None:
+    a = item([3, 1, 2])
+    a.sort()
+    assert a.as_string() == "[1, 2, 3]"
+    a.sort(reverse=True)
+    assert a.as_string() == "[3, 2, 1]"
+    b = item([1, 2])
+    b *= 2
+    assert b.as_string() == "[1, 2, 1, 2]"
+    b *= 0
+    assert b.as_string() == "[]"
+
+
+def test_array_append_is_not_quadratic() -> None:
+    a = tomlkit.array()
+    start = time.perf_counter()
+    for i in range(5000):
+        a.append(i)
+    assert time.perf_counter() - start < 1.5
+    assert parse("x = " + a.as_string())["x"] == list(range(5000))
+
+
+def test_document_many_keys_is_not_quadratic() -> None:
+    start = time.perf_counter()
+    out = tomlkit.dumps({f"k{i}": i for i in range(5000)})
+    assert time.perf_counter() - start < 1.5
+    assert len(parse(out)) == 5000
+
+
+def test_round_float_without_ndigits_returns_int() -> None:
+    r = round(item(2.6))
+    assert r == 3
+    assert type(r) is int
+    assert round(item(2.567), 2) == 2.57
+
+
+def test_bool_items_compare_equal() -> None:
+    assert item(True) == item(True)
+    assert item(True) != item(False)
+    assert item([True, False]) == item([True, False])
+
+
+def test_string_concat_escapes_plain_str() -> None:
+    doc = tomlkit.document()
+    doc["k"] = "x"
+    doc["k"] += '"y\n'
+    assert parse(doc.as_string())["k"] == 'x"y\n'
+
+    ml = tomlkit.string('a""', multiline=True) + '"b'
+    assert parse("k = " + ml.as_string())["k"] == 'a"""b'
+
+    with pytest.raises(InvalidStringError):
+        tomlkit.string("a", literal=True) + "'"
+
+
+def test_esc_char_written_as_toml_10_escape() -> None:
+    assert item("\x1b").as_string() == '"\\u001b"'
+    assert parse('a = "\\e"')["a"] == "\x1b"
+
+
+def test_multiline_strings_with_lone_carriage_return() -> None:
+    s = tomlkit.string("a\rb\r\nc", multiline=True)
+    assert parse("k = " + s.as_string())["k"] == "a\rb\r\nc"
+    with pytest.raises(InvalidStringError):
+        tomlkit.string("a\rb", multiline=True, literal=True)
+
+
+def test_copy_keeps_table_keys() -> None:
+    doc = parse("[a.b]\nx = 1\n")
+    c = copy.copy(doc)
+    c.append("a", tomlkit.table(True))
+    assert "a" in c
+
+
+def test_dumps_sort_keys_table_and_no_mutation() -> None:
+    src = "b = 1\n[t]\nb = 1\na = 2\n"
+    doc = parse(src)
+    assert tomlkit.dumps(doc["t"], sort_keys=True) == "a = 2\nb = 1\n"
+    tomlkit.dumps(doc, sort_keys=True)
+    assert doc.as_string() == src
+
+
+@pytest.mark.parametrize(
+    "src",
+    [
+        'a = "\\U0000D800"',
+        'a = "\\uDFFF"',
+        'a = "\\u+123"',
+        'a = "\\u_123"',
+        "a = -infinity",
+        "a = +Inf",
+        "a = NaN",
+        "[a]\nx = 1\n[b]\n[a.c]\n[a]\n",
+    ],
+)
+def test_invalid_documents_are_rejected(src: str) -> None:
+    with pytest.raises(ParseError):
+        parse(src)
+
+
+def test_valid_floats_still_parse() -> None:
+    doc = parse("a = 1e5\nb = -1.5E-3\nc = +inf\nd = -nan\ne = 224_617.445_991\n")
+    assert doc["a"] == 1e5
+    assert doc["b"] == -1.5e-3
+    assert doc["e"] == 224617.445991
+
+
+def test_non_string_key_lookup_is_a_miss() -> None:
+    doc = parse("a = 1\n[t]\nx = 1\n")
+    assert 1 not in doc
+    assert None not in doc
+    assert doc.get(1) is None
+    assert 1 not in doc["t"]
+    with pytest.raises(KeyError):
+        doc[1]  # type: ignore[index]
+    with pytest.raises(TypeError):
+        doc[1] = 2  # type: ignore[index]
+
+
+def test_multiline_comments_cannot_inject_values() -> None:
+    doc = tomlkit.document()
+    doc["a"] = 1
+    doc["a"].comment("x\ny = 2")
+    doc.add(tomlkit.comment("p\r\nq = 1"))
+    assert parse(doc.as_string()).unwrap() == {"a": 1}
+
+
+def test_replace_table_with_value_goes_before_first_table() -> None:
+    doc = parse("[a]\nx = 1\n[b]\ny = 2\n[a.c]\nz = 3\n")
+    doc["b"] = 3
+    assert parse(doc.as_string()).unwrap() == {"a": {"x": 1, "c": {"z": 3}}, "b": 3}
+
+
+def test_replace_dotted_key_table_with_table() -> None:
+    doc = parse("a.b = 1\nx = 2\n[t]\ny = 1\n")
+    doc["a"] = {"c": 3}
+    doc["z"] = 1
+    assert parse(doc.as_string()).unwrap() == {
+        "a": {"c": 3},
+        "x": 2,
+        "t": {"y": 1},
+        "z": 1,
+    }
