             warnings.simplefilter("always")
             unittest.mock.create_autospec(Cached, instance=True)
         self.assertEqual(len(w), 0)
+
+
+class _Counter:
+    def __init__(self, base=0):
+        self.cache = LRUCache(10)
+        self.base = base
+
+    @cachedmethod(lambda self: self.cache)
+    def get(self, value):
+        return self.base + value
+
+    @cachedmethod(lambda self: self.cache, key=keys.hashkey, info=True)
+    def get_info(self, value):
+        return self.base + value
+
+
+class _Override(_Counter):
+    def get(self, value):
+        return super().get(value) + 1
+
+    def get_info(self, value):
+        return _Counter.get_info(self, value) + 1
+
+
+class InstanceDictTest(unittest.TestCase):
+    def test_super_does_not_shadow_override(self):
+        obj = _Override()
+        self.assertEqual(obj.get(1), 2)
+        self.assertEqual(obj.get(1), 2)
+        self.assertEqual(obj.get_info(1), 2)
+        self.assertEqual(obj.get_info(1), 2)
+
+    def test_call_through_class(self):
+        obj = _Counter(10)
+        self.assertEqual(_Counter.get(obj, 1), 11)
+        self.assertEqual(_Counter.get_info(obj, 1), 11)
+        self.assertEqual(obj.get_info.cache_info().hits, 0)
+        self.assertEqual(_Counter.get_info(obj, 1), 11)
+        self.assertEqual(obj.get_info.cache_info().hits, 1)
+        _Counter.get.cache_clear(obj)
+        self.assertEqual(len(obj.cache), 0)
+
+    def test_pickle(self):
+        import pickle
+
+        obj = _Counter(1)
+        self.assertEqual(obj.get(1), 2)
+        self.assertEqual(obj.get_info(1), 2)
+        copy = pickle.loads(pickle.dumps(obj))
+        copy.base = 100
+        copy.cache.clear()
+        self.assertIs(copy.get._obj, copy)
+        self.assertEqual(copy.get(1), 101)
+        self.assertEqual(copy.get_info(1), 101)
+        self.assertEqual(obj.get(1), 2)
+
+    def test_copy(self):
+        import copy
+
+        obj = _Counter(1)
+        self.assertEqual(obj.get(1), 2)
+        self.assertEqual(obj.get_info(1), 2)
+        for clone in (copy.copy(obj), copy.deepcopy(obj)):
+            clone.base = 100
+            clone.cache = LRUCache(10)
+            self.assertEqual(clone.get(1), 101)
+            self.assertEqual(clone.get_info(1), 101)
+            self.assertEqual(clone.get_info.cache_info().misses, 1)
+            self.assertEqual(obj.get(1), 2)
+            self.assertEqual(len(obj.cache), 2)
+
+    def test_assign_and_delete(self):
+        obj = _Counter()
+        self.assertEqual(obj.get(1), 1)
+        obj.get = lambda value: -1  # type: ignore
+        self.assertEqual(obj.get(1), -1)
+        del obj.get
+        self.assertEqual(obj.get(1), 1)
+        with unittest.mock.patch.object(obj, "get", return_value=42):
+            self.assertEqual(obj.get(1), 42)
+        self.assertEqual(obj.get(1), 1)
diff --git a/tests/test_lru.py b/tests/test_lru.py
