+class LFUCachePickleTest(unittest.TestCase):
+    def _make_cache(self):
+        import sys
+
+        # create a long chain of distinct use counts
+        n = sys.getrecursionlimit()
+        cache = LFUCache[int, int](maxsize=n + 1)
+        for i in range(n):
+            cache[i] = i
+            for _ in range(i):
+                cache[i]
+        return n, cache
+
+    def _check(self, n, cache):
+        self.assertEqual(n, len(cache))
+        self.assertEqual((0, 0), cache.popitem())
+        cache[-1] = -1
+        self.assertEqual((-1, -1), cache.popitem())
+        cache[1]
+        cache[1]
+        cache[1]
+        self.assertEqual((2, 2), cache.popitem())
+
+    def test_pickle_many_counts(self):
+        import pickle
+
+        n, source = self._make_cache()
+        cache = pickle.loads(pickle.dumps(source))
+        self.assertEqual(source, cache)
+        self._check(n, cache)
+
+    def test_deepcopy_many_counts(self):
+        import copy
+
+        n, source = self._make_cache()
+        cache = copy.deepcopy(source)
+        self.assertEqual(source, cache)
+        self._check(n, cache)
+        self._check(n, copy.copy(source))
