+class TLRUExpiredUpdateTest(unittest.TestCase):
+    def test_set_expired_replaces_existing(self):
+        def ttu(_key, value, time):
+            return time + value
+
+        cache = TLRUTestCache(maxsize=10, ttu=ttu)
+        cache["a"] = 5
+        self.assertEqual(5, cache["a"])
+        # storing an already expired value must not leave the old one
+        cache["a"] = 0
+        self.assertNotIn("a", cache)
+        self.assertIsNone(cache.get("a"))
+        self.assertEqual(0, len(cache))
+        self.assertEqual(0, cache.currsize)
+        cache["a"] = 3
+        self.assertEqual(3, cache["a"])
