+def test_varnames_partial() -> None:
+    import functools
+
+    def f(a, b, c=1) -> None:
+        pass  # pragma: no cover
+
+    class A:
+        def m(self, x, y) -> None:
+            pass  # pragma: no cover
+
+    assert varnames(functools.partial(f)) == (("a", "b"), ("c",))
+    assert varnames(functools.partial(f, 1)) == (("b",), ("c",))
+    assert varnames(functools.partial(f, 1, 2, 3)) == ((), ())
+    assert varnames(functools.partial(f, b=2)) == (("a",), ())
+    assert varnames(functools.partial(A().m, 1)) == (("y",), ())
diff --git a/testing/test_multicall.py b/testing/test_multicall.py
index 93f394c..e16ba2b 100644
--- a/testing/test_multicall.py
+++ b/testing/test_multicall.py
@@ -479,3 +479,35 @@ def test_suppress_inner_wrapper_teardown_exc() -> None:
         "m2 suppress",
         "m1 finish",
     ]
+
+
+@pytest.mark.parametrize("raise_inner", [False, True])
+def test_wrapper_two_yields_still_tears_down_outer(raise_inner: bool) -> None:
+    out = []
+
+    @hookimpl(wrapper=True)
+    def outer():
+        try:
+            return (yield)
+        except BaseException as e:
+            out.append(type(e).__name__)
+            raise
+
+    @hookimpl(wrapper=True)
+    def inner():
+        try:
+            yield
+        except ValueError:
+            pass
+        yield
+
+    @hookimpl
+    def m():
+        if raise_inner:
+            raise ValueError()
+        return 1
+
+    with pytest.raises(RuntimeError, match="has second yield"):
+        MC([m, inner, outer], {})
+    # The outer wrapper is torn down with the error (not just closed by GC).
+    assert out == ["RuntimeError"]
