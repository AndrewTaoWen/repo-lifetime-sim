+class PeekableSliceReadAheadTests(TestCase):
+    def _tracked(self, n):
+        consumed = []
+
+        def gen():
+            for i in range(n):
+                consumed.append(i)
+                yield i
+
+        return consumed, mi.peekable(gen())
+
+    def test_positive_step_reads_only_needed_items(self):
+        consumed, p = self._tracked(10)
+        self.assertEqual(p[:2], [0, 1])
+        self.assertEqual(consumed, [0, 1])
+        self.assertEqual(p[1:3], [1, 2])
+        self.assertEqual(consumed, [0, 1, 2])
+        self.assertEqual(list(p), list(range(10)))
+
+    def test_negative_step_without_stop(self):
+        consumed, p = self._tracked(10)
+        self.assertEqual(p[2::-1], [2, 1, 0])
+        self.assertEqual(consumed, [0, 1, 2])
+        self.assertEqual(list(p), list(range(10)))
+
