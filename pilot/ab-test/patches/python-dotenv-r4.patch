+
+def test_get_reads_file_as_utf8(cli, dotenv_path):
+    from unittest import mock
+
+    dotenv_path.write_bytes("a=\u00e9\n".encode("utf-8"))
+
+    with mock.patch("builtins.open", wraps=open) as mock_open:
+        result = cli.invoke(dotenv_cli, ["--file", dotenv_path, "get", "a"])
+
+    assert (result.exit_code, result.output) == (0, "\u00e9\n")
+    assert mock_open.call_args.kwargs.get("encoding") == "utf-8"
+
+
