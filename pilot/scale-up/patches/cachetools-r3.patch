+
+class InheritanceTest(unittest.TestCase):
+    def test_override_plain(self):
+        class Base:
+            def __init__(self):
+                self.cache = {}
+
+            @cachedmethod(lambda self: self.cache)
+            def get(self, value):
+                return ("base", value)
+
+        class Derived(Base):
+            def get(self, value):
+                return ("derived", super().get(value))
+
+        obj = Derived()
+        self.assertEqual(("derived", ("base", 1)), obj.get(1))
+        # the base class wrapper must not shadow the override
+        self.assertEqual(("derived", ("base", 1)), obj.get(1))
+        self.assertEqual(1, len(obj.cache))
+
+    def test_override_cached(self):
+        for kwargs in ({}, {"info": True}):
+
+            class Base:
+                def __init__(self):
+                    self.base_cache = {}
+                    self.derived_cache = {}
+
+                @cachedmethod(lambda self: self.base_cache, **kwargs)
+                def get(self, value):
+                    return ("base", value)
+
+            class Derived(Base):
+                @cachedmethod(lambda self: self.derived_cache, **kwargs)
+                def get(self, value):
+                    return ("derived", super().get(value))
+
+            obj = Derived()
+            self.assertEqual(("derived", ("base", 1)), obj.get(1))
+            self.assertEqual(("derived", ("base", 1)), obj.get(1))
+            self.assertEqual(1, len(obj.base_cache))
+            self.assertEqual(1, len(obj.derived_cache))
+
+    def test_unbound_call(self):
+        for kwargs in (
+            {},
+            {"info": True},
+            {"lock": lambda self: self.lock},
+            {"condition": lambda self: self.cond},
+            {"lock": lambda self: self.lock, "info": True},
+            {"condition": lambda self: self.cond, "info": True},
+        ):
+
+            class Cached:
+                def __init__(self):
+                    self.cache = {}
+                    self.lock = CountedLock()
+                    self.cond = CountedCondition()
+                    self.count = 0
+
+                @cachedmethod(lambda self: self.cache, **kwargs)
+                def get(self, value):
+                    self.count += 1
+                    return value
+
+            obj = Cached()
+            self.assertEqual(1, Cached.get(obj, 1))
+            self.assertEqual(1, Cached.get(obj, 1))
+            self.assertEqual(1, obj.get(1))
+            self.assertEqual(1, obj.count)
+            self.assertEqual(["get"], list(map(Cached.get, [obj], ["get"])))
+            with self.assertRaises(TypeError):
+                Cached.get()
