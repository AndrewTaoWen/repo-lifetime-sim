diff --git a/tests/test_more.py b/tests/test_more.py
index a019677..463ed26 100644
--- a/tests/test_more.py
+++ b/tests/test_more.py
@@ -6993,3 +6993,83 @@ class TestRunningStats(TestCase):
             list(mi.running_statistics(map(complex, data)))
         with self.assertRaises(TypeError):
             list(mi.running_statistics(map(complex, data), maxlen=3))
+
+
+class HardeningRegressionTests(TestCase):
+    def test_last_propagates_iteration_errors(self):
+        def gen(exc):
+            yield 1
+            raise exc('boom')
+
+        for exc in (IndexError, TypeError):
+            with self.subTest(exc=exc):
+                with self.assertRaises(exc):
+                    mi.last(gen(exc), 'default')
+        # Errors raised while iterating a reversible are not swallowed either
+        class BadReversed:
+            def __iter__(self):
+                return iter([1])
+
+            def __reversed__(self):
+                raise_index_error = mi.raise_(IndexError, 'boom')
+                yield raise_index_error
+
+        with self.assertRaises(IndexError):
+            mi.last(BadReversed(), 'default')
+
+    def test_bucket_no_phantom_keys(self):
+        b = mi.bucket(['a1', 'b1', 'a2'], key=lambda x: x[0])
+        self.assertNotIn('z', b)
+        self.assertEqual(list(b['y']), [])
+        self.assertEqual(sorted(b), ['a', 'b'])
+        # Keys seen in the data are still listed after being consumed
+        list(b['a'])
+        self.assertEqual(sorted(b), ['a', 'b'])
+
+    def test_divide_mapping(self):
+        d = {1: 'a', 2: 'b', 3: 'c'}
+        self.assertEqual([list(x) for x in mi.divide(2, d)], [[1, 2], [3]])
+
+    def test_iequals_propagates_value_error(self):
+        with self.assertRaises(ValueError):
+            mi.iequals([1, 2], map(int, ['1', 'x']))
+        self.assertFalse(mi.iequals([1, 2], [1]))
+        self.assertFalse(mi.iequals([1], [1, 2], [1]))
+        self.assertTrue(mi.iequals([1, None], (1, None)))
+
+    def test_value_chain_propagates_type_error(self):
+        with self.assertRaises(TypeError):
+            list(mi.value_chain([1], map(int, ['1', None])))
+        self.assertEqual(list(mi.value_chain(1, [2], 'ab')), [1, 2, 'ab'])
+
+    def test_combination_with_replacement_index_none(self):
+        for pool in (['a', (), None, 1], [0, None], [None, 1, 2]):
+            for r in range(4):
+                combos = list(combinations_with_replacement(pool, r))
+                for i, c in enumerate(combos):
+                    with self.subTest(pool=pool, c=c):
+                        self.assertEqual(
+                            mi.combination_with_replacement_index(c, pool), i
+                        )
+
+    def test_outer_product_empty_ys(self):
+        self.assertEqual(
+            list(mi.outer_product(lambda x, y: x * y, [1, 2], [])), [(), ()]
+        )
+
+    def test_numeric_range_float_len_matches_iteration(self):
+        for args in [
+            (1.0, 1.6, 0.3),
+            (-4.7, -0.8, 0.1),
+            (1.6, 4.4, 0.1),
+            (1.6, 1.0, -0.3),
+        ]:
+            with self.subTest(args=args):
+                r = mi.numeric_range(*args)
+                items = list(r)
+                self.assertEqual(len(r), len(items))
+                self.assertEqual(r[-1], items[-1])
+                self.assertEqual(list(reversed(r)), items[::-1])
+
+    def test_interleave_evenly_no_iterables(self):
+        self.assertEqual(list(mi.interleave_evenly([])), [])
