+    def test_getsizeof_update(self):
+        cache = self.Cache(maxsize=10, getsizeof=lambda x: x)
+        cache.update({"a": 3, "b": 3, "c": 3})
+        # growing an item only requires room for the size difference
+        cache["c"] = 4
