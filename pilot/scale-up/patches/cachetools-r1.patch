+
+class PickleTest(unittest.TestCase):
+    def test_pickle_instance(self):
+        import pickle
+
+        obj = _Picklable()
+        self.assertEqual(1, obj.get(1))
+        self.assertEqual(2, obj.get_info(2))
+        copy = pickle.loads(pickle.dumps(obj))
+        self.assertEqual(2, copy.count)
+        self.assertEqual(1, copy.get(1))
+        self.assertEqual(2, copy.get_info(2))
+        self.assertEqual(2, copy.count)
+        self.assertEqual(3, copy.get(3))
+        self.assertEqual(3, copy.count)
+        self.assertEqual(2, obj.count)
+        self.assertIs(copy, copy.get._obj)
+        self.assertIs(copy, copy.get_info._obj)
