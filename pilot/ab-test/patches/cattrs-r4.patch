--- /dev/null
+++ b/tests/test_regressions.py
@@ -0,0 +1,372 @@
+"""Regression tests for assorted hardening fixes."""
+
+from __future__ import annotations
+
+import sys
+from collections import Counter
+from dataclasses import dataclass
+from datetime import date, datetime
+from enum import Enum
+from typing import (
+    Annotated,
+    Counter as TypingCounter,
+    Literal,
+    NamedTuple,
+    Tuple,
+    Union,
+)
+
+import pytest
+from attrs import define, field, resolve_types
+from typing_extensions import NotRequired, Required, TypedDict
+
+from cattrs import (
+    BaseConverter,
+    ClassValidationError,
+    Converter,
+    ForbiddenExtraKeysError,
+    UnstructureStrategy,
+)
+from cattrs.cols import is_mutable_sequence, is_sequence
+from cattrs.errors import CattrsError, StructureHandlerNotFoundError
+from cattrs.gen import make_dict_structure_fn, make_dict_unstructure_fn, override
+from cattrs.gen.typeddicts import make_dict_structure_fn as make_td_structure_fn
+from cattrs.strategies import configure_union_passthrough, include_subclasses
+from cattrs.subclasses import subclasses
+from cattrs.v import format_exception, transform_error
+
+
+@define
+class Simple:
+    a: int
+    b: int = 0
+
+
+@pytest.mark.parametrize("detailed_validation", [True, False])
+@pytest.mark.parametrize("key", ["it's", 'q"x', "back\\slash", "new\nline", "a\\nb"])
+def test_rename_special_characters(detailed_validation: bool, key: str):
+    """Renamed keys with quotes, backslashes and newlines round-trip."""
+    c = Converter(detailed_validation=detailed_validation)
+    c.register_structure_hook(
+        Simple,
+        make_dict_structure_fn(
+            Simple, c, a=override(rename=key), b=override(rename=key + "2")
+        ),
+    )
+    c.register_unstructure_hook(
+        Simple,
+        make_dict_unstructure_fn(
+            Simple,
+            c,
+            a=override(rename=key),
+            b=override(rename=key + "2", omit_if_default=True),
+        ),
+    )
+    unstructured = c.unstructure(Simple(1, 2))
+    assert unstructured == {key: 1, key + "2": 2}
+    assert c.structure(unstructured, Simple) == Simple(1, 2)
+
+
+TDSpecial = TypedDict(
+    "TDSpecial", {"it's": int, "a-b\\n": datetime, "x y": int}, total=True
+)
+TDSpecialPartial = TypedDict(
+    "TDSpecialPartial", {"it's": int, "a-b\\n": datetime}, total=False
+)
+
+
+@pytest.mark.parametrize("detailed_validation", [True, False])
+def test_typeddict_special_keys(detailed_validation: bool):
+    """TypedDicts with keys that are not identifiers work."""
+    c = Converter(detailed_validation=detailed_validation)
+    c.register_unstructure_hook(datetime, lambda d: d.isoformat())
+    c.register_structure_hook(datetime, lambda v, _: datetime.fromisoformat(v))
+
+    full = {"it's": 1, "a-b\\n": datetime(2020, 1, 1), "x y": 3}
+    unstructured = c.unstructure(full, TDSpecial)
+    assert unstructured == {"it's": 1, "a-b\\n": "2020-01-01T00:00:00", "x y": 3}
+    assert c.structure(unstructured, TDSpecial) == full
+
+    partial = {"a-b\\n": datetime(2020, 1, 1)}
+    unstructured = c.unstructure(partial, TDSpecialPartial)
+    assert c.structure(unstructured, TDSpecialPartial) == partial
+
+    hook = make_td_structure_fn(
+        TDSpecialPartial, c, **{"it's": override(rename="o'k")}
+    )
+    assert hook({"o'k": "5"}, TDSpecialPartial) == {"it's": 5}
+
+
+def test_typeddict_special_keys_error_note():
+    c = Converter(detailed_validation=True)
+    c.register_structure_hook(datetime, lambda v, _: v)
+    with pytest.raises(ClassValidationError) as exc_info:
+        c.structure({"it's": "x", "a-b\\n": datetime(2020, 1, 1), "x y": 1}, TDSpecial)
+    assert transform_error(exc_info.value) == [
+        "invalid value for type, expected int @ $.it's"
+    ]
+
+
+class TDRequiredOverrides(TypedDict, total=False):
+    a: Required[Annotated[int, override(rename="A")]]
+    b: Annotated[int, override(rename="B")]
+    c: Annotated[NotRequired[int], override(rename="C")]
+
+
+@pytest.mark.parametrize("detailed_validation", [True, False])
+def test_typeddict_overrides_in_required(detailed_validation: bool):
+    """Annotated overrides are found inside and outside `(Not)Required`."""
+    c = Converter(detailed_validation=detailed_validation)
+    value = {"a": 1, "b": 2, "c": 3}
+    unstructured = c.unstructure(value, TDRequiredOverrides)
+    assert unstructured == {"A": 1, "B": 2, "C": 3}
+    assert c.structure(unstructured, TDRequiredOverrides) == value
+
+
+def test_forbidden_extra_keys_non_str():
+    """Non-string extra keys don't break error formatting."""
+    c = Converter(forbid_extra_keys=True)
+    with pytest.raises(ClassValidationError) as exc_info:
+        c.structure({"a": 1, 5: 2, "z": 3}, Simple)
+    exc = exc_info.value.exceptions[0]
+    assert isinstance(exc, ForbiddenExtraKeysError)
+    assert str(exc) == "Extra fields in constructor for Simple: 5, z"
+    assert transform_error(exc_info.value) in (
+        ["extra fields found (5, z) @ $"],
+        ["extra fields found (z, 5) @ $"],
+    )
+
+
+def test_format_exception_odd_args():
+    """`format_exception` handles exceptions with no or non-string args."""
+    assert format_exception(TypeError(), None) == "invalid type ()"
+    assert format_exception(TypeError(5), None) == "invalid type (5)"
+    assert format_exception(AttributeError(), None) == "unknown error ()"
+
+
+@pytest.mark.parametrize("converter_cls", [BaseConverter, Converter])
+def test_copy_keeps_union_hooks(converter_cls):
+    """Copies keep structure hooks registered for unions."""
+    c = converter_cls()
+    c.register_structure_hook(Union[int, str], lambda v, _: "UNION")
+    assert c.structure(1, Union[int, str]) == "UNION"
+    assert c.copy().structure(1, Union[int, str]) == "UNION"
+
+
+@pytest.mark.parametrize("converter_cls", [BaseConverter, Converter])
+def test_copy_keeps_fallback_factories(converter_cls):
+    """Copies keep the fallback hook factories."""
+
+    class Unknown:
+        pass
+
+    c = converter_cls(
+        structure_fallback_factory=lambda _: lambda v, _: "SFALLBACK",
+        unstructure_fallback_factory=lambda _: lambda v: "UFALLBACK",
+    )
+    copy = c.copy()
+    assert copy.structure(1, Unknown) == "SFALLBACK"
+    assert copy.unstructure(Unknown()) == "UFALLBACK"
+
+
+@pytest.mark.parametrize("preconf", ["json", "orjson", "tomllib", "bson", "tomlkit"])
+def test_preconf_copy_mappings_use_copy(preconf):
+    """Mapping hooks of copied preconf converters use the copy's hooks."""
+    mod = pytest.importorskip(f"cattrs.preconf.{preconf}")
+    c = mod.make_converter()
+    copy = c.copy()
+    copy.register_unstructure_hook(Simple, lambda _: "custom")
+    copy.register_structure_hook(Simple, lambda _, __: "custom")
+
+    assert copy.unstructure({"k": Simple(1)}, dict[str, Simple]) == {"k": "custom"}
+    assert copy.structure({"k": {"a": 1}}, dict[str, Simple]) == {"k": "custom"}
+    # The original is unaffected.
+    assert c.unstructure({"k": Simple(1)}, dict[str, Simple]) == {
+        "k": {"a": 1, "b": 0}
+    }
