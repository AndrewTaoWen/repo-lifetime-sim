diff --git a/tests/test_regressions.py b/tests/test_regressions.py
new file mode 100644
index 0000000..a26afb2
--- /dev/null
+++ b/tests/test_regressions.py
@@ -0,0 +1,426 @@
+"""Regression tests for assorted bug fixes."""
+
+from __future__ import annotations
+
+import dataclasses
+import gc
+from collections import Counter, defaultdict
+from enum import Enum
+from typing import Literal, NamedTuple, TypedDict, Union
+
+import attrs
+import pytest
+
+from cattrs import BaseConverter, Converter, UnstructureStrategy
+from cattrs.dispatch import FunctionDispatch
+from cattrs.errors import (
+    CattrsError,
+    ForbiddenExtraKeysError,
+    IterableValidationError,
+)
+from cattrs.gen import (
+    make_dict_structure_fn,
+    make_dict_unstructure_fn,
+    mapping_unstructure_factory,
+    override,
+)
+from cattrs.strategies import configure_tagged_union
+from cattrs.subclasses import subclasses
+from cattrs.v import format_exception
+
+try:
+    from typing import NotRequired
+except ImportError:  # pragma: no cover
+    from typing_extensions import NotRequired
+
+from typing import Annotated
+
+
+@attrs.define
+class A:
+    a: int
+
+
+@attrs.define
+class B:
+    b: int
+
+
+class NT(NamedTuple):
+    # This module uses `from __future__ import annotations`, so these are strings.
+    a: int
+    b: str = "x"
+
+
+class NTSub(NT):
+    pass
+
+
+class LitEnum(Enum):
+    A = "a"
+    B = "b"
+
+
+# Converter copies
+
+
+def test_copy_keeps_fallback_factories():
+    """Copies keep the structure and unstructure fallback factories."""
+    c = Converter(
+        structure_fallback_factory=lambda _: lambda v, _: "fallback",
+        unstructure_fallback_factory=lambda _: lambda v: "ufallback",
+    )
+    copy = c.copy()
+    assert copy.structure(1, object) == "fallback"
+    assert copy.unstructure(object()) == "ufallback"
+
+    bc = BaseConverter(structure_fallback_factory=lambda _: lambda v, _: "fallback")
+    assert bc.copy().structure(1, object) == "fallback"
+
+
+@pytest.mark.parametrize("cls", [BaseConverter, Converter])
+def test_copy_keeps_union_hooks(cls):
+    """Union hooks registered with `register_structure_hook` survive copying."""
+    c = cls()
+    c.register_structure_hook(Union[A, B], lambda v, _: "union")
+    assert c.structure({}, Union[A, B]) == "union"
+    assert c.copy().structure({}, Union[A, B]) == "union"
+
+
+def test_copy_keeps_tagged_unions():
+    c = Converter()
+    configure_tagged_union(Union[A, B], c)
+    copy = c.copy()
+    assert copy.structure({"_type": "B", "b": 1}, Union[A, B]) == B(1)
+
+
+def test_function_dispatch_copy_to_without_skip():
+    """`copy_to` with `skip=0` copies every handler."""
+    src = FunctionDispatch(None)
+    src.register(lambda _: True, "handler")
+    dst = FunctionDispatch(None)
+    src.copy_to(dst)
+    assert dst.get_num_fns() == 1
+
+
+# Error formatting
+
+
+def test_format_exception_without_args():
+    """Exceptions without args don't crash the formatter."""
+    assert format_exception(TypeError(), None) == "invalid type ()"
+    assert format_exception(AttributeError(), None) == "unknown error ()"
+
+
+def test_extra_keys_non_string():
+    """Non-string extra keys don't crash formatting."""
+    exc = ForbiddenExtraKeysError(None, A, {1, "b"})
+    assert str(exc) == "Extra fields in constructor for A: 1, b"
+    assert format_exception(exc, None) == "extra fields found (1, b)"
+
+
+# Tuples
+
+
+@pytest.mark.parametrize("detailed_validation", [True, False])
+def test_hetero_tuple_from_iterator(detailed_validation):
+    c = Converter(detailed_validation=detailed_validation)
+    assert c.structure(iter(["1", 2]), tuple[int, int]) == (1, 2)
+    assert c.structure((str(i) for i in range(2)), tuple[int, int]) == (0, 1)
+
+
+def test_hetero_tuple_too_many_message():
+    """With an element failing, too long input is still reported as too long."""
+    c = Converter(detailed_validation=True)
+    with pytest.raises(IterableValidationError) as exc_info:
+        c.structure(["a", 1, 2], tuple[int, int])
+    assert "Too many values" in str(exc_info.value.exceptions[-1])
+
+
+# Namedtuples
+
+
+def test_namedtuple_stringified_annotations():
+    c = Converter()
+    assert c.structure(["1", 2], NT) == NT(1, "2")
+    assert c.unstructure(NT(1, "a")) == NT(1, "a")
+
+
+def test_namedtuple_subclass():
+    c = Converter()
+    assert c.structure(["1", 2], NTSub) == NTSub(1, "2")
+    assert c.unstructure(NTSub(1, "a")) == NTSub(1, "a")
+
+
+# Mappings
+
+
+def test_baseconverter_unstructure_defaultdict():
+    c = BaseConverter()
+    res = c.unstructure(defaultdict(int, {"a": 1}))
+    assert res == {"a": 1}
+    assert isinstance(res, defaultdict)
+    assert res.default_factory is int
+
+
+def test_mapping_unstructure_factory_defaultdict():
+    c = Converter()
+    hook = mapping_unstructure_factory(defaultdict[str, int], c)
+    assert hook(defaultdict(int, {"a": 1})) == {"a": 1}
+
+
+def test_counter_keys_unstructured():
+    """Counter keys use the key type's unstructure hook."""
+    c = Converter()
+    assert c.unstructure(Counter({LitEnum.A: 2}), Counter[LitEnum]) == {"a": 2}
+
+
+# Generated code
+
+
+@pytest.mark.parametrize("detailed_validation", [True, False])
+def test_renames_with_quotes(detailed_validation):
+    """Renamed keys containing quotes and backslashes work."""
+
+    @attrs.define
+    class C:
+        x: int
+        y: int = 0
+
+    c = Converter(detailed_validation=detailed_validation)
+    overrides = {"x": override(rename="it's"), "y": override(rename='b\\"')}
+    c.register_structure_hook(C, make_dict_structure_fn(C, c, **overrides))
+    c.register_unstructure_hook(C, make_dict_unstructure_fn(C, c, **overrides))
+
+    assert c.unstructure(C(1, 2)) == {"it's": 1, 'b\\"': 2}
+    assert c.structure({"it's": 1, 'b\\"': 2}, C) == C(1, 2)
+
+
+@pytest.mark.parametrize("detailed_validation", [True, False])
+def test_typeddict_keys_with_quotes(detailed_validation):
+    TD = TypedDict("TD", {"it's": int, 'q"': int, "b\\": NotRequired[int]})
+    c = Converter(detailed_validation=detailed_validation)
+    data = {"it's": 1, 'q"': 2, "b\\": 3}
+    assert c.structure({"it's": "1", 'q"': 2, "b\\": 3}, TD) == data
+    assert c.unstructure(data, TD) == data
+
+
+@pytest.mark.parametrize("detailed_validation", [True, False])
+def test_non_identifier_class_names(detailed_validation):
+    c = Converter(detailed_validation=detailed_validation)
+    Attrs = attrs.make_class("my-class", {"x": attrs.field(type=int)})
+    DC = dataclasses.make_dataclass("my dc", [("x", int)])
+    TD = TypedDict("my td", {"x": int})
+
+    assert c.structure({"x": "1"}, Attrs) == Attrs(1)
+    assert c.unstructure(Attrs(1)) == {"x": 1}
+    assert c.structure({"x": "1"}, DC) == DC(1)
+    assert c.structure({"x": "1"}, TD) == {"x": 1}
+
+
+@pytest.mark.parametrize("detailed_validation", [True, False])
+def test_typeddict_omit_inside_notrequired(detailed_validation):
+    class TD(TypedDict):
+        a: int
+        b: NotRequired[Annotated[int, override(omit=True)]]
+
+    c = Converter(detailed_validation=detailed_validation)
+    assert c.structure({"a": 1, "b": "x"}, TD) == {"a": 1, "b": "x"}
+
+
+@pytest.mark.parametrize("detailed_validation", [True, False])
+def test_typeddict_rename_to_same_name(detailed_validation):
+    class TD(TypedDict):
+        a: int
+        b: NotRequired[int]
+
+    c = Converter(detailed_validation=detailed_validation)
+    hook = make_typeddict_structure_fn(
+        TD, c, a=override(rename="a"), b=override(rename="b")
+    )
+    assert hook({"a": "1", "b": "2"}, TD) == {"a": 1, "b": 2}
+
+
+def make_typeddict_structure_fn(*args, **kwargs):
+    from cattrs.gen.typeddicts import make_dict_structure_fn
+
+    return make_dict_structure_fn(*args, **kwargs)
+
+
+# Unions
+
+
+def test_literal_enum_disambiguation_roundtrip():
+    @attrs.define
+    class LA:
+        kind: Literal[LitEnum.A]
+        x: int
+
+    @attrs.define
+    class LB:
+        kind: Literal[LitEnum.B]
+        x: int
+
+    c = Converter()
+    assert c.structure(c.unstructure(LA(LitEnum.A, 1)), Union[LA, LB]) == LA(
+        LitEnum.A, 1
+    )
+    assert c.structure({"kind": "b", "x": 1}, Union[LA, LB]) == LB(LitEnum.B, 1)
+
+
+@pytest.mark.parametrize("forbid_extra_keys", [True, False])
+def test_tagged_union_default_unknown_tags_not_stored(forbid_extra_keys):
+    """Unknown tags don't accumulate in the tag registry."""
+    c = Converter(forbid_extra_keys=forbid_extra_keys)
+    configure_tagged_union(Union[A, B], c, default=A)
+    hook = c.get_structure_hook(Union[A, B])
+    for i in range(10):
+        assert hook({"_type": f"junk{i}", "a": 1}, Union[A, B]) == A(1)
+    tag_to_hook = next(
+        d for d in hook.__defaults__ if isinstance(d, dict) and "A" in d
+    )
+    assert set(tag_to_hook) == {"A", "B"}
+
+
+# Literals
+
+
+@pytest.mark.parametrize(
+    ("value", "type"),
+    [
+        (True, Literal[1]),
+        (False, Literal[0]),
+        (1, Literal[True]),
+        (0, Literal[False]),
+        (True, Literal[1, LitEnum.A]),
+    ],
+)
+def test_literal_bools_and_ints_not_confused(value, type):
+    with pytest.raises(CattrsError):
+        Converter(detailed_validation=False).structure(value, type)
+
+
+def test_literal_bools_and_ints_valid():
+    c = Converter()
+    assert c.structure(True, Literal[True, 1]) is True
+    assert c.structure(1, Literal[True, 1]) == 1
+    assert c.structure(1, Literal[True, 1]) is not True
+    assert c.structure("a", Literal[1, LitEnum.A]) is LitEnum.A
+
+
+# BaseConverter attrs handling
+
+
+@pytest.mark.parametrize(
+    "strat", [UnstructureStrategy.AS_DICT, UnstructureStrategy.AS_TUPLE]
+)
+@pytest.mark.parametrize("converter_cls", [BaseConverter, Converter])
+def test_init_false_roundtrip(converter_cls, strat):
+    @attrs.define
+    class C:
+        x: int
+        z: int = attrs.field(init=False, default=5)
+
+    @dataclasses.dataclass
+    class D:
+        x: int
+        z: int = dataclasses.field(init=False, default=5)
+
+    c = converter_cls(unstruct_strat=strat)
+    assert c.structure(c.unstructure(C(1)), C) == C(1)
+    assert c.structure(c.unstructure(D(1)), D) == D(1)
